    <x:String x:Key="LegacyGlyphDownload">&#xEB0B;</x:String>
    <x:String x:Key="LegacyGlyphStop">&#xEB0C;</x:String>
    <x:String x:Key="LegacyGlyphFlash">&#xEB0D;</x:String>
    <x:String x:Key="LegacyGlyphFlashOff">&#xEB0E;</x:String>
    <x:String x:Key="LegacyGlyphFlashAuto">&#xEB0F;</x:String>
    <!-- Every LegacyIconFont glyph is centred in its em, so one size per surface keeps them uniform. -->
    <x:Double x:Key="LegacyAppBarGlyphSize">24</x:Double>
    <!-- Compact strip +6 for a 3px air gap above and below the 40px ring (was 48). -->
    <x:Double x:Key="LegacyCommandBarCompactHeight">54</x:Double>
