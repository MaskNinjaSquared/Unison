    <!--
      Merged AFTER Themes/WhatsApp/Theme.xaml so ThemeDictionaries win over WhatsApp greys.
      Icon glyphs live in LegacyIconFont (WhatsAppLegacyIcons.ttf): EB01–EB0F.
    -->
    <BitmapImage x:Key="AvatarContactFallbackImage"
                 UriSource="ms-appx:///Assets/WhatsAppLegacy/default-contact-icon.png"/>
    <BitmapImage x:Key="AvatarGroupFallbackImage"
                 UriSource="ms-appx:///Assets/WhatsAppLegacy/default-group-icon.png"/>
    <x:String x:Key="LegacyGlyphSearch">&#xEB01;</x:String>
    <x:String x:Key="LegacyGlyphAdd">&#xEB02;</x:String>
    <x:String x:Key="LegacyGlyphAttach">&#xEB03;</x:String>
    <x:String x:Key="LegacyGlyphSend">&#xEB04;</x:String>
    <x:String x:Key="LegacyGlyphMic">&#xEB05;</x:String>
    <x:String x:Key="LegacyGlyphNewChat">&#xEB06;</x:String>
