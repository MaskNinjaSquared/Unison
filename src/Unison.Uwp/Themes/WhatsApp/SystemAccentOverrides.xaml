<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      System / WinUI accent overrides (port of Imgur ThemeDictionary.xaml).
      Unison greens: #20C064 (primary / title bar / accent), #1DAA61 (solid Dark1).
      Merged after XamlControlsResources so ToggleSwitch, ProgressRing, etc. pick these up.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Dark + Default (RequestedTheme=Dark resolves here) -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#20C064</Color>
            <Color x:Key="SystemAccentColorLight1">#3DCA75</Color>
            <Color x:Key="SystemAccentColorLight2">#5ED268</Color>
            <Color x:Key="SystemAccentColorLight3">#60D56A</Color>
            <Color x:Key="SystemAccentColorDark1">#1DAA61</Color>
            <Color x:Key="SystemAccentColorDark2">#189653</Color>
            <Color x:Key="SystemAccentColorDark3">#147A44</Color>

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1DAA61"/>
            <SolidColorBrush x:Key="SystemControlDisabledAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#20C064"/>
            <SolidColorBrush x:Key="ContentDialogBorderThemeBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="JumpListDefaultEnabledBackground" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}"/>

            <!-- WinUI 2 accent fills (ToggleSwitch, CheckBox, Radio, ProgressBar, â€¦) -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>

            <LinearGradientBrush x:Key="UnisonGreenLinearBrush" StartPoint="0.1,0" EndPoint="1,1">
                <GradientStop Color="#60D56A" Offset="0"/>
                <GradientStop Color="#5ED268" Offset="0.3"/>
                <GradientStop Color="#20C064" Offset="0.7"/>
                <GradientStop Color="#1DAA61" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#20C064</Color>
            <Color x:Key="SystemAccentColorLight1">#3DCA75</Color>
            <Color x:Key="SystemAccentColorLight2">#5ED268</Color>
            <Color x:Key="SystemAccentColorLight3">#60D56A</Color>
            <Color x:Key="SystemAccentColorDark1">#1DAA61</Color>
            <Color x:Key="SystemAccentColorDark2">#189653</Color>
            <Color x:Key="SystemAccentColorDark3">#147A44</Color>

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1DAA61"/>
            <SolidColorBrush x:Key="SystemControlDisabledAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#20C064"/>
            <SolidColorBrush x:Key="ContentDialogBorderThemeBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="JumpListDefaultEnabledBackground" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}"/>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>

            <LinearGradientBrush x:Key="UnisonGreenLinearBrush" StartPoint="0.1,0" EndPoint="1,1">
                <GradientStop Color="#60D56A" Offset="0"/>
                <GradientStop Color="#5ED268" Offset="0.3"/>
                <GradientStop Color="#20C064" Offset="0.7"/>
                <GradientStop Color="#1DAA61" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#20C064</Color>
            <Color x:Key="SystemAccentColorLight1">#3DCA75</Color>
            <Color x:Key="SystemAccentColorLight2">#5ED268</Color>
            <Color x:Key="SystemAccentColorLight3">#60D56A</Color>
            <Color x:Key="SystemAccentColorDark1">#1DAA61</Color>
            <Color x:Key="SystemAccentColorDark2">#189653</Color>
            <Color x:Key="SystemAccentColorDark3">#147A44</Color>

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1DAA61"/>
            <SolidColorBrush x:Key="SystemControlDisabledAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#1DAA61"/>
            <SolidColorBrush x:Key="ContentDialogBorderThemeBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="JumpListDefaultEnabledBackground" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}"/>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>

            <LinearGradientBrush x:Key="UnisonGreenLinearBrush" StartPoint="0.1,0" EndPoint="1,1">
                <GradientStop Color="#60D56A" Offset="0"/>
                <GradientStop Color="#5ED268" Offset="0.3"/>
                <GradientStop Color="#20C064" Offset="0.7"/>
                <GradientStop Color="#1DAA61" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
