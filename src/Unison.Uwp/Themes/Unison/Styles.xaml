<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design Tokens (Unison brand; selection green is Unison-only) -->
    <SolidColorBrush x:Key="WhatsAppBackgroundBrush" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="ChatDetailBackgroundBrush" Color="#0F1210"/>
    <!-- Underfill behind tiled chat wallpaper (TiledBackground) -->
    <SolidColorBrush x:Key="ChatDetailWallpaperBackgroundBrush" Color="#424D4D"/>
    <ImageBrush x:Key="WhatsAppTextureBrush" ImageSource="ms-appx:///Assets/Backgrounds/WhatsAppBackground.png" Stretch="None" Opacity="0.1"/>
    <SolidColorBrush x:Key="WhatsAppHeaderBrush" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="WhatsAppSidebarBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="WhatsAppItemHoverBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="WhatsAppItemSelectedBrush" Color="#FF414141"/>
    <!-- Chat list selection: Unison dark green (not in WhatsApp reference) -->
    <SolidColorBrush x:Key="WhatsAppChatListSelectedBrush" Color="#FF134532"/>
    <SolidColorBrush x:Key="WhatsAppChatListPointerOverBrush" Color="#FF1F553F"/>
    <SolidColorBrush x:Key="WhatsAppMenuOutlineBrush" Color="#FF222222"/>
    <SolidColorBrush x:Key="WhatsAppFilterHeaderBrush" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="WhatsAppTextHighBrush" Color="#FFE9EDEF"/>
    <SolidColorBrush x:Key="WhatsAppTextMediumBrush" Color="#FFCFCFCF"/>
    <SolidColorBrush x:Key="WhatsAppTextLowBrush" Color="#FF667781"/>
    <SolidColorBrush x:Key="WhatsAppGreenFocusBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="WhatsAppUnderlineNormalBrush" Color="#FF9F9F9F"/>

    <!-- Chat list -->
    <!-- Same as SettingsPageBackgroundBrush — Unison shell list chrome -->
    <SolidColorBrush x:Key="ChatListBackgroundBrush" Color="#FF121212"/>
    <SolidColorBrush x:Key="ChatListSecondaryTextBrush" Color="#FF9F9F9F"/>
    <SolidColorBrush x:Key="ChatListUnreadBadgeBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="ChatListSyncStatusBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="ChatListUnreadBadgeForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatListSearchForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatListSearchBackgroundBrush" Color="#CC22272B"/>
    <SolidColorBrush x:Key="ChatListSearchBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ChatListSearchPointerOverBrush" Color="#E622272B"/>
    <SolidColorBrush x:Key="ChatListSearchFocusedBackgroundBrush" Color="#FF22272B"/>
    <SolidColorBrush x:Key="ChatListSearchPlaceholderBrush" Color="#FF999999"/>
    <SolidColorBrush x:Key="ChatListSearchFocusedPlaceholderBrush" Color="#FF666666"/>

    <!-- Chat detail -->
    <SolidColorBrush x:Key="ChatDetailHeaderBrush" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="ChatDetailHeaderTitleBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatDetailHeaderStatusBrush" Color="#FF9F9F9F"/>
    <SolidColorBrush x:Key="ChatDetailAvatarFallbackBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="ChatDetailAvatarInitialBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatDetailAccentBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="ChatDetailPaneSeparatorBrush" Color="#FF3B3B3B"/>
    <SolidColorBrush x:Key="ChatDetailPinnedBarBackgroundBrush" Color="#FF32373B"/>
    <SolidColorBrush x:Key="ChatDetailPinnedPreviewBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatDetailInputBarBackgroundBrush" Color="#CC22272B"/>
    <SolidColorBrush x:Key="ChatDetailSentTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatDetailSentMetaBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ChatDetailSendFailedBrush" Color="#FFFF8080"/>
    <SolidColorBrush x:Key="ChatDetailGroupSenderBrush" Color="#FF2695D9"/>
    <SolidColorBrush x:Key="ChatDetailReceivedTextBrush" Color="#FFE9EDEF"/>
    <SolidColorBrush x:Key="ChatDetailReceivedMetaBrush" Color="#FF9F9F9F"/>
    <SolidColorBrush x:Key="ChatDetailMutedTextBrush" Color="#FF888888"/>
    <!-- Reaction chip: match bubble fills (MessageBubbleChrome), border slightly darker -->
    <SolidColorBrush x:Key="ChatDetailReactionChipBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="ChatDetailReactionChipForegroundBrush" Color="#FFE9EDEF"/>
    <SolidColorBrush x:Key="ChatDetailReactionChipSentBrush" Color="#FF005C4B"/>
    <SolidColorBrush x:Key="ChatDetailReactionChipSentBorderBrush" Color="#FF004536"/>
    <SolidColorBrush x:Key="ChatDetailReactionChipReceivedBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="ChatDetailReactionChipReceivedBorderBrush" Color="#FF282828"/>
    <!-- Hover reuses chat-list pointer-over (Unison green) -->
    <SolidColorBrush x:Key="ChatDetailReactionChipPointerOverBrush" Color="#FF1F553F"/>

    <!-- Login (Unison brand) -->
    <SolidColorBrush x:Key="LoginPageBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LoginHeaderBackgroundBrush" Color="#FF3DCA75"/>
    <SolidColorBrush x:Key="LoginAccentBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="LoginActionBrush" Color="#FF20C064"/>
    <SolidColorBrush x:Key="LoginOnAccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LoginQrCardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LoginQrCardBorderBrush" Color="#FFEEEEEE"/>
    <SolidColorBrush x:Key="LoginMutedTextBrush" Color="#FF888888"/>
    <SolidColorBrush x:Key="LoginLogPanelBackgroundBrush" Color="#FFF7F7F7"/>
    <SolidColorBrush x:Key="LoginInstructionTextBrush" Color="#FF3B4A54"/>
    <SolidColorBrush x:Key="LoginInstructionTitleBrush" Color="#FF000000"/>

    <!-- Settings / Debug section pages (Unison: distinct page tones) -->
    <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#FF121212"/>
    <SolidColorBrush x:Key="DebugPageBackgroundBrush" Color="#FF1A1A1A"/>

</ResourceDictionary>
