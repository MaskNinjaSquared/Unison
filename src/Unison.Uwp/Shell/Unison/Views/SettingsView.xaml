<Page
    x:Class="Unison.Uwp.Shell.Unison.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:Core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SettingsPageBackgroundBrush}">

    <!--
        LayoutStates (app-wide): Minimal | Extended | ExtendedWide
        Minimal (default): stacked hero + BottomAbout in list.
        Extended (≥700): side-by-side hero only; About stays below the options.
        ExtendedWide (≥1000): Extended hero + options / RightAbout side by side.
        ProfileStates: CollapsedProfile | ExpandedProfileState.
        ViewProfileState (page DP) hides the settings back, the Settings title,
        the name, and Your Profile, and shows the photo button on the hero avatar.
        The same avatar translates to the center; profile rows sit along the bottom.
    -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource SettingsPageBackgroundBrush}"
          SizeChanged="RootGrid_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Minimal"/>

                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProfileHero.MinHeight" Value="240"/>
                        <Setter Target="HeroShadow.Margin" Value="0,0,0,20"/>
                        <Setter Target="HeroMinimalPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="HeroExtendedPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ExtendedWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProfileHero.MinHeight" Value="240"/>
                        <Setter Target="HeroShadow.Margin" Value="0,0,0,20"/>
                        <Setter Target="HeroMinimalPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="HeroExtendedPanel.Visibility" Value="Visible"/>
                        <Setter Target="BottomAbout.Visibility" Value="Collapsed"/>
                        <Setter Target="RightAbout.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ProfileStates">
                <VisualState x:Name="CollapsedProfile"/>
                <VisualState x:Name="ExpandedProfileState">
                    <VisualState.Setters>
                        <Setter Target="SettingsBody.Visibility" Value="Collapsed"/>
                        <Setter Target="StickyHeaderBar.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="LeftContent"
                      HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="LeftContent_ViewChanged">
            <StackPanel Background="{ThemeResource SettingsPageBackgroundBrush}">
                <!-- Full-bleed hero -->
                <toolkit:DropShadowPanel x:Name="HeroShadow"
                                         BlurRadius="10"
                                         OffsetX="0"
                                         OffsetY="4"
                                         ShadowOpacity="0.55"
                                         Color="Black"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Top"
                                         Margin="0,0,0,20">
                    <Grid x:Name="ProfileHero"
                          MinHeight="280"
                          HorizontalAlignment="Stretch"
                          SizeChanged="ProfileHero_SizeChanged">
                        <Border Background="{ThemeResource ChatDetailWallpaperBackgroundBrush}"/>
                        <controls:TiledBackground/>
                        <Border Background="{ThemeResource SettingsHeroOverlayBrush}"
                                IsHitTestVisible="False"/>

                        <Grid VerticalAlignment="Top"
                              Margin="10,10,10,0"
                              Opacity="0.95">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HeroLeaveButton"
                                    Command="{Binding LeaveCommand}"
                                    Style="{StaticResource WhatsAppIconButtonStyle}"
                                    Width="34" Height="34"
                                    Background="Transparent"
                                    Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                    Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <FontIcon FontSize="16" FontFamily="{StaticResource IconFont}"
                                          Glyph="&#xE72B;"/>
                            </Button>
                            <Button x:Name="ProfileBackButton"
                                    Click="ProfileSettings_BackRequested"
                                    Style="{StaticResource WhatsAppIconButtonStyle}"
                                    Width="34" Height="34"
                                    Background="Transparent"
                                    Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                    Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon FontSize="16" FontFamily="{StaticResource IconFont}"
                                          Glyph="&#xE72B;"/>
                            </Button>
                            <TextBlock x:Name="HeroSettingsTitle"
                                       Grid.Column="1"
                                       x:Uid="Settings_Title" Text="Settings"
                                       FontWeight="SemiBold" Margin="5,0,0,0" FontSize="20"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       x:Uid="Settings_Profile" Text="Profile"
                                       FontWeight="SemiBold" Margin="5,0,0,0" FontSize="20"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Minimal: avatar centered, name below -->
                        <StackPanel x:Name="HeroMinimalPanel"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="20,52,20,28">
                            <Grid x:Name="MinimalAvatarHost"
                                  Width="120"
                                  Height="120"
                                  HorizontalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="MinimalAvatarTranslate"/>
                                </Grid.RenderTransform>
                                <toolkit:DropShadowPanel BlurRadius="50"
                                                         OffsetX="0"
                                                         OffsetY="2"
                                                         ShadowOpacity="0.55"
                                                         Color="Black"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch">
                                    <controls:ChatAvatarControl Size="120"
                                                                HorizontalAlignment="Center"
                                                                AvatarUrl="{Binding CurrentUserAvatar}"/>
                                </toolkit:DropShadowPanel>
                                <controls:ProfilePhotoButton HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Canvas.ZIndex="1"
                                                             Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding ProfileDisplayName}"
                                       Margin="0,14,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                            <Button Click="YourProfileButton_Click"
                                    Style="{StaticResource WhatsAppIconButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    Padding="8,2"
                                    Background="Transparent"
                                    Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                    Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock x:Uid="Settings_YourProfile"
                                           Text="Your Profile"
                                           FontSize="14"
                                           Foreground="{ThemeResource SettingsHeroForegroundBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- Extended: avatar + name side by side -->
                        <StackPanel x:Name="HeroExtendedPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="40,60,20,20"
                                    Visibility="Collapsed">
                            <Grid x:Name="ExtendedAvatarHost"
                                  Width="125"
                                  Height="125"
                                  VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ExtendedAvatarTranslate"/>
                                </Grid.RenderTransform>
                                <toolkit:DropShadowPanel BlurRadius="50"
                                                         OffsetX="0"
                                                         OffsetY="2"
                                                         ShadowOpacity="0.55"
                                                         Color="Black"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch">
                                    <controls:ChatAvatarControl Size="125"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                AvatarUrl="{Binding CurrentUserAvatar}"/>
                                </toolkit:DropShadowPanel>
                                <controls:ProfilePhotoButton HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Canvas.ZIndex="1"
                                                             Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                            <StackPanel Margin="30,12,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ProfileDisplayName}"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Foreground="{ThemeResource SettingsHeroForegroundBrush}"
                                           FontFamily="{StaticResource MainFontSemibold}"/>
                                <Button Click="YourProfileButton_Click"
                                        Style="{StaticResource WhatsAppIconButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Padding="8,2"
                                        Background="Transparent"
                                        Foreground="{ThemeResource SettingsHeroForegroundBrush}">
                                    <TextBlock x:Uid="Settings_YourProfile"
                                               Text="Your Profile"
                                               FontSize="16"
                                               Foreground="{ThemeResource SettingsHeroForegroundBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </toolkit:DropShadowPanel>

                <!-- Below hero: options + About (BottomAbout until ExtendedWide; RightAbout ≥1000) -->
                <Grid x:Name="SettingsBody"
                      Background="{ThemeResource SettingsPageBackgroundBrush}"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SettingsBodyScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                MaxWidth="800"
                                HorizontalAlignment="Center"
                                Padding="15,12,15,30"
                                Background="{ThemeResource SettingsPageBackgroundBrush}">
                        <controls:SettingsSectionHeader x:Uid="Settings_General"
                                                        Text="General"
                                                        Glyph="&#xE713;"
                                                        Margin="15,12,0,5"/>

                        <controls:SettingBox LocalizationUid="Settings_LiveTiles"
                                             Margin="5"
                                             Header="Live Tiles"
                                             Text="Atualizar o tile principal com a última mensagem.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding LiveTilesEnabled, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_AutoUnlink"
                                             Margin="5"
                                             Header="Desvincular automaticamente"
                                             Text="Se a sessão for invalidada no telemóvel, limpar dados locais e pedir QR. Desligue para manter o app como backup e só tentar reconectar.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding AutoUnlinkOnLogoutEnabled, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_PublishWindowsContacts"
                                             Margin="5"
                                             Header="Show Unison contacts in Windows"
                                             Text="Adds your 1:1 chats to a separate Unison list in the People app. Off by default.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding PublishContactsToWindowsEnabled, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingsSectionHeader x:Uid="Settings_NotificationsSection"
                                                        Text="Notifications"
                                                        Glyph="&#xE91C;"
                                                        Margin="15,12,0,5"/>

                        <controls:SettingBox LocalizationUid="Settings_Notifications"
                                             Margin="5"
                                             Header="Notificações"
                                             Text="Exibir toasts e badge ao receber mensagens.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_MessageNotificationSound"
                                             Margin="5"
                                             Header="Message notifications"
                                             Text="Sound for 1:1 message toasts.">
                            <controls:SettingBox.Control>
                                <ComboBox x:Name="MessageSoundComboBox"
                                          MinWidth="160"
                                          Margin="0,0,4,0"
                                          SelectedIndex="{Binding SelectedMessageNotificationSoundIndex, Mode=OneWay}">
                                    <Interactivity:Interaction.Behaviors>
                                        <Core:EventTriggerBehavior EventName="SelectionChanged">
                                            <Core:InvokeCommandAction
                                                Command="{Binding ChangeMessageNotificationSoundCommand}"
                                                CommandParameter="{Binding SelectedIndex, ElementName=MessageSoundComboBox}"/>
                                        </Core:EventTriggerBehavior>
                                    </Interactivity:Interaction.Behaviors>
                                    <ComboBoxItem x:Uid="Settings_NotificationSound_SystemDefault" Content="System default"/>
                                </ComboBox>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_GroupNotificationSound"
                                             Margin="5"
                                             Header="Group notifications"
                                             Text="Sound for group message toasts.">
                            <controls:SettingBox.Control>
                                <ComboBox x:Name="GroupSoundComboBox"
                                          MinWidth="160"
                                          Margin="0,0,4,0"
                                          SelectedIndex="{Binding SelectedGroupNotificationSoundIndex, Mode=OneWay}">
                                    <Interactivity:Interaction.Behaviors>
                                        <Core:EventTriggerBehavior EventName="SelectionChanged">
                                            <Core:InvokeCommandAction
                                                Command="{Binding ChangeGroupNotificationSoundCommand}"
                                                CommandParameter="{Binding SelectedIndex, ElementName=GroupSoundComboBox}"/>
                                        </Core:EventTriggerBehavior>
                                    </Interactivity:Interaction.Behaviors>
                                    <ComboBoxItem x:Uid="Settings_NotificationSound_SystemDefaultGroup" Content="System default"/>
                                </ComboBox>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingsSectionHeader x:Uid="Settings_Customization"
                                                        Text="Customization"
                                                        Glyph="&#xE790;"/>

                        <controls:SettingBox LocalizationUid="Settings_Language"
                                             Margin="5"
                                             Header="Language"
                                             Text="Choose the app language. The app restarts to apply it.">
                            <controls:SettingBox.Control>
                                <ComboBox x:Name="LanguageComboBox"
                                          MinWidth="160"
                                          Margin="0,0,4,0"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                                          SelectionChanged="LanguageComboBox_SelectionChanged"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_TimeFormat"
                                             Margin="5"
                                             Header="Time format"
                                             Text="Choose 24-hour or 12-hour clock.">
                            <controls:SettingBox.Control>
                                <ComboBox x:Name="TimeFormatComboBox"
                                          MinWidth="140"
                                          Margin="0,0,4,0"
                                          SelectedIndex="{Binding SelectedTimeFormatIndex, Mode=OneWay}">
                                    <Interactivity:Interaction.Behaviors>
                                        <Core:EventTriggerBehavior EventName="SelectionChanged">
                                            <Core:InvokeCommandAction
                                                Command="{Binding ChangeTimeFormatCommand}"
                                                CommandParameter="{Binding SelectedIndex, ElementName=TimeFormatComboBox}"/>
                                        </Core:EventTriggerBehavior>
                                    </Interactivity:Interaction.Behaviors>
                                    <ComboBoxItem x:Uid="Settings_TimeFormat24Hours" Content="24 Hours"/>
                                    <ComboBoxItem x:Uid="Settings_TimeFormat12Hours" Content="12 Hours"/>
                                </ComboBox>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_Shell"
                                             Margin="5"
                                             Header="Shell"
                                             Text="Escolha o visual do aplicativo.">
                            <controls:SettingBox.Control>
                                <ComboBox x:Name="ShellComboBox"
                                          MinWidth="140"
                                          Margin="0,0,4,0"
                                          SelectedIndex="{Binding SelectedShellIndex, Mode=OneWay}">
                                    <Interactivity:Interaction.Behaviors>
                                        <Core:EventTriggerBehavior EventName="SelectionChanged">
                                            <Core:InvokeCommandAction
                                                Command="{Binding ChangeShellCommand}"
                                                CommandParameter="{Binding SelectedIndex, ElementName=ShellComboBox}"/>
                                        </Core:EventTriggerBehavior>
                                    </Interactivity:Interaction.Behaviors>
                                    <ComboBoxItem Content="Unison"/>
                                    <ComboBoxItem Content="WhatsApp"/>
                                    <ComboBoxItem Content="WhatsApp Legacy"/>
                                </ComboBox>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_StartTile"
                                             Margin="5"
                                             Header="Tile do Início"
                                             Text="Escolher o ícone e fixar um tile que recebe as mesmas notificações do app.">
                            <controls:SettingBox.Control>
                                <Button x:Uid="Settings_StartTileChoose"
                                        Content="Escolher"
                                        MinWidth="96"
                                        Command="{Binding ChooseStartTileCommand}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingsSectionHeader x:Uid="Settings_Advanced"
                                                        Text="Advanced Settings"
                                                        Glyph="&#xE7BA;"/>

                        <controls:SettingBox LocalizationUid="Settings_ShowSyncStatus"
                                             Margin="5"
                                             Header="Show sync status"
                                             Text="Show the synchronization status in the chat list.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding ShowSyncStatus, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingBox LocalizationUid="Settings_KeepAlive"
                                             Margin="5"
                                             Header="Modo em segundo plano"
                                             Text="Usa geolocalização só para o sistema não congelar o app (Unogram). A posição não é lida nem enviada. Consome mais bateria.">
                            <controls:SettingBox.Control>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                              IsOn="{Binding LocationKeepAliveEnabled, Mode=TwoWay}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <controls:SettingsSectionHeader x:Uid="Settings_DiskUsage"
                                                        Text="Disk Usage"
                                                        Glyph="&#xEDA2;"
                                                        Margin="15,12,0,5"/>

                        <controls:SettingBox LocalizationUid="Settings_MediaCache"
                                             Margin="5"
                                             Header="Mídia nos chats"
                                             Text="{Binding DiskUsageText, Mode=OneWay}">
                            <controls:SettingBox.Control>
                                <Button x:Uid="Settings_MediaCacheClean"
                                        Content="Limpar dados"
                                        MinWidth="120"
                                        IsEnabled="{Binding CanCleanMediaCache, Mode=OneWay}"
                                        Command="{Binding CleanMediaCacheCommand}"/>
                            </controls:SettingBox.Control>
                        </controls:SettingBox>

                        <Button Command="{Binding DisconnectCommand}"
                                HorizontalAlignment="Right"
                                Margin="5,20,5,8"
                                MinHeight="44"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="{StaticResource IconFont}"
                                          FontSize="16"
                                          Glyph="&#xF3B1;"
                                          Foreground="#E81123"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Uid="Settings_Disconnect"
                                           Text="Disconnect"
                                           FontSize="15"
                                           Foreground="#E81123"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MainFontSemibold}"/>
                            </StackPanel>
                        </Button>

                        <controls:AboutControl x:Name="BottomAbout"
                                               HorizontalAlignment="Left"
                                               Margin="5,8,10,24"/>
                    </StackPanel>

                    <controls:AboutControl x:Name="RightAbout"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           MaxWidth="350"
                                           Margin="20,12,20,24"
                                           Visibility="Collapsed"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <controls:ProfileSettingsControl x:Name="ProfileSettingsHost"
                                         Canvas.ZIndex="12"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Bottom"
                                         Visibility="Collapsed"/>

        <Border x:Name="StickyHeaderBar"
                Canvas.ZIndex="10"
                Height="48"
                VerticalAlignment="Top"
                Background="{ThemeResource SettingsPageBackgroundBrush}"
                Opacity="0"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewProfileState, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Grid VerticalAlignment="Center" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding LeaveCommand}"
                        Style="{StaticResource WhatsAppIconButtonStyle}"
                        Width="34" Height="34"
                        Background="Transparent"
                        Foreground="{ThemeResource WhatsAppTextHighBrush}">
                    <FontIcon FontSize="16" FontWeight="ExtraBold" FontFamily="{StaticResource IconFont}"
                              Glyph="&#xE72B;"/>
                </Button>
                <TextBlock Grid.Column="1"
                           x:Uid="Settings_Title" Text="Settings"
                           FontWeight="SemiBold" Margin="5,0,0,0" FontSize="18"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           FontFamily="{StaticResource MainFontSemibold}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
