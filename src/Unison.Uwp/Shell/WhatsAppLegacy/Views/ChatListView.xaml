<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.ChatListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ChatItemTemplates/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ChatListGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sync left; filter right as a text link (not a bordered button). -->
        <Grid Grid.Row="0"
              MinHeight="36"
              Padding="0,4"
              Background="Transparent">
            <Grid x:Name="SyncStatusPanel"
                  Margin="10,0,100,0"
                  Visibility="{x:Bind ViewModel.ShowSyncStatusInUi, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  VerticalAlignment="Center" HorizontalAlignment="Left"
                  MaxWidth="220"
                  SizeChanged="SyncStatusPanel_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <controls:ModernProgressRing IsActive="{x:Bind ViewModel.ShowSyncStatusInUi, Mode=OneWay}"
                                             Width="18" Height="18"
                                             VerticalAlignment="Center"
                                             Foreground="{ThemeResource ChatListSyncStatusBrush}"/>
                <TextBlock x:Name="SyncStatusText" Grid.Column="1"
                           Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                           Foreground="{ThemeResource ChatListSyncStatusBrush}" FontSize="14"
                           FontFamily="{StaticResource MainFont}" VerticalAlignment="Center" Margin="6,0,0,0"
                           HorizontalAlignment="Stretch"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </Grid>
            <HyperlinkButton x:Name="FilterButton"
                             Style="{StaticResource LegacyHyperlinkButtonStyle}"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Click="FilterButton_Click"
                             AutomationProperties.Name="Filter">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEA01;"
                              FontFamily="{StaticResource UnisonIconFont}"
                              FontSize="11"
                              Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="FilterLabel"
                               Text="Filter Messages"
                               Margin="5,0,0,0"
                               FontSize="12"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </HyperlinkButton>
            <Button x:Name="MenuButton" Visibility="Collapsed" Click="MenuButton_Click"/>
            <Button x:Name="NewChatButton" Visibility="Collapsed"/>
        </Grid>

        <!-- Search lives on ShellView (WP8 search state); keep named box for any code refs. -->
        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 x:Uid="ChatList_SearchBox"
                 Visibility="Collapsed"
                 Margin="16,0,16,16"
                 PlaceholderText="Search or start a new chat"
                 Style="{ThemeResource ChatListSearchTextBoxStyle}"
                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>


        
        <ListView Grid.Row="2" x:Name="ChatList" 
                  x:Load="{x:Bind ViewModel.IsChatListMaterialized, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.VisibleChats}"
                  ItemTemplate="{StaticResource ChatItemTemplate}"
                  ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                  SelectionMode="Single"
                  IsRightTapEnabled="True"
                  Loaded="ChatList_Loaded"
                  Unloaded="ChatList_Unloaded"
                  SelectionChanged="ChatList_SelectionChanged"
                  ContainerContentChanging="ChatList_ContainerContentChanging"
                  PointerPressed="ChatList_PointerPressed"
                  RightTapped="ChatList_RightTapped"
                  ContextRequested="ChatList_ContextRequested"
                  ShowsScrollingPlaceholders="False"
                  Margin="0,0,0,0">
        </ListView>
        
        <!-- Loading overlay. Text comes from the view model so the wipe/resync phases can say
             what they are doing; it seeds itself with the same string this used to hardcode. -->
        <Grid x:Name="ChatLoadingOverlay" Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.IsLoadingOverlayVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:ModernProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Name="ChatLoadingText"
                           Text="{x:Bind ViewModel.LoadingOverlayText, Mode=OneWay}"
                           FontSize="14" Foreground="{ThemeResource WhatsAppTextMediumBrush}" Margin="0,16,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource MainFont}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="CommunityHubPanel"
              Grid.RowSpan="4"
              Visibility="{x:Bind ViewModel.IsCommunityHubOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Border (not Grid.CornerRadius): Creators Update-safe rounded grey strip. -->
            <Border Background="{ThemeResource CommunityHubHeaderBrush}"
                    Margin="10,20,10,0"
                    CornerRadius="3"
                    Padding="4,10,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="CommunityHubBackButton_Click"
                            Style="{StaticResource ModernIconButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="4,0,4,0">
                        <FontIcon Glyph="&#xE72B;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="18"
                                  Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"/>
                    </Button>
                    <controls:ChatAvatarControl Grid.Column="1"
                                                Width="48" Height="48"
                                                Size="48"
                                                ShowBorder="True"
                                                IsGroup="True"
                                                VerticalAlignment="Center"
                                                Margin="4,0,12,0"
                                                AvatarUrl="{Binding ActiveCommunity.AvatarUrl}"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ActiveCommunityTitle, Mode=OneWay}"
                                   FontSize="18"
                                   FontFamily="{StaticResource MainFontSemibold}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveCommunitySubtitle, Mode=OneWay}"
                                   Margin="0,2,0,0"
                                   FontSize="13"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="{ThemeResource ChatDetailHeaderStatusBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ListView x:Name="CommunityHubList"
                      Grid.Row="1"
                      ItemsSource="{Binding ActiveCommunity.CommunityMembers}"
                      ItemTemplate="{StaticResource ChatItemTemplate}"
                      ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                      SelectionMode="Single"
                      IsRightTapEnabled="True"
                      SelectionChanged="CommunityHubList_SelectionChanged"
                      ContainerContentChanging="CommunityHubList_ContainerContentChanging"
                      PointerPressed="ChatList_PointerPressed"
                      RightTapped="ChatList_RightTapped"
                      ContextRequested="ChatList_ContextRequested"
                      ShowsScrollingPlaceholders="False"/>
        </Grid>

        <!-- List-side only: collapses with the list in NarrowDetail (chat fullscreen).
             The grid paints the full 54. The CommandBar template only paints its content strip. -->
        <Grid x:Name="ListCommandBarHost"
              Grid.Row="3"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
        <CommandBar x:Name="ListCommandBar"
                    Style="{StaticResource LegacyCommandBarStyle}"
                    Loaded="ListCommandBar_Loaded">
                <AppBarButton x:Uid="Shell_LegacyAppBar_Search"
                          Style="{StaticResource LegacyAppBarButtonStyle}"
                          Label="Search"
                          Click="SearchAppBar_Click">
                    <TextBlock Text="&#xEB01;"
                           FontFamily="{StaticResource LegacyIconFont}"
                           FontSize="{StaticResource LegacyAppBarGlyphSize}"
                           TextLineBounds="Tight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </AppBarButton>
                <AppBarButton x:Uid="Shell_LegacyAppBar_NewChat"
                          Style="{StaticResource LegacyAppBarButtonStyle}"
                          Label="New chat"
                          Click="NewChatAppBar_Click">
                    <TextBlock Text="&#xEB06;"
                           FontFamily="{StaticResource LegacyIconFont}"
                           FontSize="{StaticResource LegacyAppBarGlyphSize}"
                           TextLineBounds="Tight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </AppBarButton>
                <AppBarButton x:Uid="Shell_LegacyAppBar_AddContact"
                          Style="{StaticResource LegacyAppBarButtonStyle}"
                          Label="Add contact"
                          Command="{x:Bind ViewModel.AddContactCommand}">
                    <TextBlock Text="&#xEB02;"
                           FontFamily="{StaticResource LegacyIconFont}"
                           FontSize="{StaticResource LegacyAppBarGlyphSize}"
                           TextLineBounds="Tight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ProfileSecondaryButton"
                              x:Uid="Shell_LegacyMenu_Profile"
                              Label="Profile"
                              Click="ProfileAppBar_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE77B;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton x:Uid="Shell_LegacyMenu_Debug"
                              Label="Debug"
                              Click="DebugAppBar_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEBE8;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="Shell_LegacyMenu_Settings"
                              Label="Settings"
                              Click="SettingsAppBar_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
        </CommandBar>
        </Grid>

        <!-- Hold on a row: same layout as ChatDetail MessageActions —
             scrim over list (rows 0–2), actions bar on row 3 above ListCommandBar.
             Desktop right-click uses MenuFlyout at the pointer (see code-behind). -->
        <!-- Invisible dismiss layer above the list (not the actions bar). Tap/press outside closes. -->
        <Border x:Name="ChatActionsScrim"
                Grid.Row="0"
                Grid.RowSpan="3"
                Canvas.ZIndex="20"
                Background="Transparent"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                PointerPressed="ChatActionsScrim_PointerPressed"
                Tapped="ChatActionsScrim_Tapped"/>
        <Grid x:Name="ChatActionsBarHost"
              Grid.Row="3"
              Canvas.ZIndex="21"
              Visibility="Collapsed"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
                <CommandBar x:Name="ChatActionsBar"
                            Style="{StaticResource LegacyCommandBarStyle}"
                            Loaded="ChatActionsBar_Loaded">
                    <AppBarButton x:Name="ChatActionsPinButton"
                                  Style="{StaticResource LegacyAppBarButtonStyle}"
                                  Label="Pin"
                                  Click="ChatActionsPin_Click">
                        <TextBlock Text="&#xE840;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="{StaticResource LegacyAppBarGlyphSize}"
                                   TextLineBounds="Tight"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </AppBarButton>
                    <AppBarButton x:Name="ChatActionsMuteButton"
                                  Style="{StaticResource LegacyAppBarButtonStyle}"
                                  Label="Mute"
                                  Click="ChatActionsMute_Click">
                        <TextBlock Text="&#xE74F;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="{StaticResource LegacyAppBarGlyphSize}"
                                   TextLineBounds="Tight"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </AppBarButton>
                    <AppBarButton x:Name="ChatActionsArchiveButton"
                                  Style="{StaticResource LegacyAppBarButtonStyle}"
                                  Label="Archive"
                                  Click="ChatActionsArchive_Click">
                        <TextBlock Text="&#xE7B8;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="{StaticResource LegacyAppBarGlyphSize}"
                                   TextLineBounds="Tight"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </AppBarButton>
                    <AppBarButton x:Name="ChatActionsDeleteButton"
                                  Style="{StaticResource LegacyAppBarButtonStyle}"
                                  Label="Delete"
                                  Click="ChatActionsDelete_Click">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="{StaticResource LegacyAppBarGlyphSize}"
                                   TextLineBounds="Tight"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="ChatActionsViewProfileButton"
                                      Label="View profile"
                                      Click="ChatActionsViewProfile_Click">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE77B;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ChatActionsPinToStartButton"
                                      Label="Pin to Start"
                                      Click="ChatActionsPinToStart_Click">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource LegacyIconFont}" Glyph="&#xEB08;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ChatActionsAddContactButton"
                                      Label="Add contact"
                                      Click="ChatActionsAddContact_Click">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8FA;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <!-- Label set in ApplyChatActionsChrome (Add/Remove). No x:Uid —
                             AppBarButton has Label, not Text; ChatList_AddFavorite.Text is for MenuFlyoutItem. -->
                        <AppBarButton x:Name="ChatActionsFavoriteButton"
                                      Label="Add to favorites"
                                      Click="ChatActionsFavorite_Click">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE734;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator/>
                        <AppBarButton x:Name="ChatActionsMute8hButton"
                                      Label="Mute 8 hours"
                                      Click="ChatActionsMute8h_Click"/>
                        <AppBarButton x:Name="ChatActionsMute1wButton"
                                      Label="Mute 1 week"
                                      Click="ChatActionsMute1w_Click"/>
                        <AppBarButton x:Name="ChatActionsMuteForeverButton"
                                      Label="Mute always"
                                      Click="ChatActionsMuteForever_Click"/>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
        </Grid>
    </Grid>
</UserControl>
