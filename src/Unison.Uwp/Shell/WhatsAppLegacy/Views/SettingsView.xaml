<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:Core="using:Microsoft.Xaml.Interactions.Core"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      WP8-style settings (shell ContentFrame, not dialog):
      small page title, large section titles, rows = description + toggle, no SettingBox fill.
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="PageHeader" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Command="{Binding LeaveCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    MinWidth="40"
                    Foreground="{ThemeResource WhatsAppTextHighBrush}">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72B;" FontSize="20"/>
            </Button>
            <TextBlock x:Name="PageTitle"
                       x:Uid="Settings_Title"
                       Grid.Column="1"
                       Text="settings"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       CharacterSpacing="40"
                       FontFamily="{StaticResource MainFontLight}"
                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
        </Grid>

        <ScrollViewer x:Name="SettingsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,8,16,24">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">

                <TextBlock x:Uid="Settings_Profile"
                           Text="profile"
                           Margin="0,16,0,8"
                           FontSize="28"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <controls:ProfileBox x:Name="YourProfileBox"
                                     Title="Your profile"
                                     Glyph="&#xE77B;"
                                     Margin="0,0,0,8"
                                     Value="{Binding CurrentUserName}"
                                     Click="YourProfileBox_Click"/>

                <TextBlock x:Uid="Settings_General"
                           Text="general"
                           Margin="0,24,0,8"
                           FontSize="28"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <controls:SettingBox LocalizationUid="Settings_LiveTiles"
                                     Margin="0,0,0,4"
                                     Header="Live Tiles"
                                     Text="Update the primary tile with the latest message.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                      IsOn="{Binding LiveTilesEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_AutoUnlink"
                                     Margin="0,0,0,4"
                                     Header="Auto unlink"
                                     Text="If the phone invalidates the session, clear local data and ask for QR.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                      IsOn="{Binding AutoUnlinkOnLogoutEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_PublishWindowsContacts"
                                     Margin="0,0,0,4"
                                     Header="Windows contacts"
                                     Text="Show Unison 1:1 chats in the People app.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                      IsOn="{Binding PublishContactsToWindowsEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <TextBlock x:Uid="Settings_NotificationsSection"
                           Text="notifications"
                           Margin="0,24,0,8"
                           FontSize="28"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <controls:SettingBox LocalizationUid="Settings_Notifications"
                                     Margin="0,0,0,4"
                                     Header="Notifications"
                                     Text="Show toasts and badge for new messages.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                      IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <TextBlock x:Uid="Settings_Customization"
                           Text="customization"
                           Margin="0,24,0,8"
                           FontSize="28"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <controls:SettingBox LocalizationUid="Settings_Shell"
                                     Margin="0,0,0,4"
                                     Header="Shell"
                                     Text="Choose Unison, WhatsApp, or WhatsApp Legacy chrome.">
                    <controls:SettingBox.Control>
                        <ComboBox x:Name="ShellComboBox"
                                  MinWidth="160"
                                  SelectedIndex="{Binding SelectedShellIndex, Mode=OneWay}">
                            <Interactivity:Interaction.Behaviors>
                                <Core:EventTriggerBehavior EventName="SelectionChanged">
                                    <Core:InvokeCommandAction
                                        Command="{Binding ChangeShellCommand}"
                                        CommandParameter="{Binding SelectedIndex, ElementName=ShellComboBox}"/>
                                </Core:EventTriggerBehavior>
                            </Interactivity:Interaction.Behaviors>
                            <ComboBoxItem Content="Unison"/>
                            <ComboBoxItem Content="WhatsApp"/>
                            <ComboBoxItem Content="WhatsApp Legacy"/>
                        </ComboBox>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_Language"
                                     Margin="0,0,0,4"
                                     Header="Language"
                                     Text="App display language.">
                    <controls:SettingBox.Control>
                        <ComboBox x:Name="LanguageComboBox"
                                  MinWidth="160"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <TextBlock x:Uid="Settings_Advanced"
                           Text="account"
                           Margin="0,24,0,8"
                           FontSize="28"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,14"
                        Margin="0,0,0,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DisconnectCommand}">
                    <TextBlock x:Uid="Settings_Disconnect"
                               Text="Disconnect"
                               Foreground="#E81123"
                               FontFamily="{StaticResource MainFont}"/>
                </Button>

                <controls:AboutControl Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Profile sub-page (same ContentFrame stack, WP8 drill-in). -->
        <Grid x:Name="ProfilePane"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Click="CloseProfile_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        MinWidth="40"
                        Foreground="{ThemeResource WhatsAppTextHighBrush}">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72B;" FontSize="20"/>
                </Button>
                <TextBlock x:Uid="Settings_Profile"
                           Grid.Column="1"
                           Text="profile"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           CharacterSpacing="40"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,24">
                <controls:WhatsAppProfileControl/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
