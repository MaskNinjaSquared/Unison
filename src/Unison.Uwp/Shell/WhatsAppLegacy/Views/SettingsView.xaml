<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:Core="using:Microsoft.Xaml.Interactions.Core"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource LegacySettingsComboBoxStyle}"/>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <!-- Phone: full-width disconnect. Wider windows: the button fits its label, on the right. -->
                <VisualState x:Name="Minimal"/>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DisconnectButton.HorizontalAlignment" Value="Right"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="PageHeader" Margin="12,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Click="BackButton_Click"
                    Style="{StaticResource LegacyBackButtonStyle}"/>
            <TextBlock x:Name="PageTitle"
                       x:Uid="Settings_Title"
                       Grid.Column="1"
                       Text="configurações"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontFamily="{StaticResource MainFontLight}"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
        </Grid>

        <ScrollViewer x:Name="SettingsScroll"
                      Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,12,0,24">
            <Grid HorizontalAlignment="Stretch">
                <!-- Root: one row per category. The open category hides this list. -->
                <StackPanel x:Name="RootCategories"
                            MaxWidth="800"
                            HorizontalAlignment="Stretch">
                    <Button Tag="profile" Click="Category_Click" Style="{StaticResource LegacySettingsCategoryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                      Foreground="{ThemeResource WhatsAppTextHighBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Settings_Profile" Text="Perfil" FontSize="22"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <TextBlock x:Uid="Settings_ProfileHint" Text="Seu nome e foto" FontSize="14"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Tag="general" Click="Category_Click" Style="{StaticResource LegacySettingsCategoryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                      Foreground="{ThemeResource WhatsAppTextHighBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Settings_General" Text="Geral" FontSize="22"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <TextBlock x:Uid="Settings_GeneralHint" Text="Live tiles, sessão e contatos" FontSize="14"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Tag="notifications" Click="Category_Click" Style="{StaticResource LegacySettingsCategoryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                      Foreground="{ThemeResource WhatsAppTextHighBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Settings_NotificationsSection" Text="Notificações" FontSize="22"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <TextBlock x:Uid="Settings_NotificationsHint" Text="Toasts e selo de mensagens" FontSize="14"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Tag="customization" HorizontalAlignment="Stretch" Click="Category_Click" Style="{StaticResource LegacySettingsCategoryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE771;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                      Foreground="{ThemeResource WhatsAppTextHighBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Settings_Customization" Text="Personalização" FontSize="22"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <TextBlock x:Uid="Settings_CustomizationHint" Text="Tema e idioma" FontSize="14"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Tag="account" Click="Category_Click" Style="{StaticResource LegacySettingsCategoryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                      Foreground="{ThemeResource WhatsAppTextHighBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Settings_Advanced" Text="Conta" FontSize="22"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <TextBlock x:Uid="Settings_AccountHint" Text="Desligar este aparelho" FontSize="14"
                                           FontFamily="{StaticResource MainFontLight}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Drill-in categories: full width, left-aligned (no 800px cap — that stays on RootCategories only). -->
                <StackPanel x:Name="ProfileCategory"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="Settings_Profile" Text="Perfil" FontSize="32" Margin="20,8,10,16"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <controls:WhatsAppProfileControl/>
                </StackPanel>

                <StackPanel x:Name="GeneralCategory"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="Settings_General" Text="Geral" FontSize="32" Margin="20,8,10,16"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <controls:SettingBox LocalizationUid="Settings_LiveTiles" Margin="10,0,10,4"
                                         Header="Live Tiles"
                                         Text="Update the primary tile with the latest message.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding LiveTilesEnabled, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_AutoUnlink" Margin="10,0,10,4"
                                         Header="Auto unlink"
                                         Text="If the phone invalidates the session, clear local data and ask for QR.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding AutoUnlinkOnLogoutEnabled, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_PublishWindowsContacts" Margin="10,0,10,4"
                                         Header="Windows contacts"
                                         Text="Show Unison 1:1 chats in the People app.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding PublishContactsToWindowsEnabled, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                </StackPanel>

                <StackPanel x:Name="NotificationsCategory"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="Settings_NotificationsSection" Text="Notificações" FontSize="32" Margin="20,8,10,16"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <controls:SettingBox LocalizationUid="Settings_Notifications" Margin="10,0,10,4"
                                         Header="Notifications"
                                         Text="Show toasts and badge for new messages.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_MessageNotificationSound" Margin="10,0,10,4"
                                         Header="Message notifications"
                                         Text="Sound for 1:1 message toasts.">
                        <controls:SettingBox.Control>
                            <ComboBox x:Name="MessageSoundComboBox"
                                      MinWidth="160"
                                      SelectedIndex="{Binding SelectedMessageNotificationSoundIndex, Mode=OneWay}">
                                <Interactivity:Interaction.Behaviors>
                                    <Core:EventTriggerBehavior EventName="SelectionChanged">
                                        <Core:InvokeCommandAction
                                            Command="{Binding ChangeMessageNotificationSoundCommand}"
                                            CommandParameter="{Binding SelectedIndex, ElementName=MessageSoundComboBox}"/>
                                    </Core:EventTriggerBehavior>
                                </Interactivity:Interaction.Behaviors>
                                <ComboBoxItem x:Uid="Settings_NotificationSound_SystemDefault" Content="System default"/>
                            </ComboBox>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_GroupNotificationSound" Margin="10,0,10,4"
                                         Header="Group notifications"
                                         Text="Sound for group message toasts.">
                        <controls:SettingBox.Control>
                            <ComboBox x:Name="GroupSoundComboBox"
                                      MinWidth="160"
                                      SelectedIndex="{Binding SelectedGroupNotificationSoundIndex, Mode=OneWay}">
                                <Interactivity:Interaction.Behaviors>
                                    <Core:EventTriggerBehavior EventName="SelectionChanged">
                                        <Core:InvokeCommandAction
                                            Command="{Binding ChangeGroupNotificationSoundCommand}"
                                            CommandParameter="{Binding SelectedIndex, ElementName=GroupSoundComboBox}"/>
                                    </Core:EventTriggerBehavior>
                                </Interactivity:Interaction.Behaviors>
                                <ComboBoxItem x:Uid="Settings_NotificationSound_SystemDefaultGroup" Content="System default"/>
                            </ComboBox>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                </StackPanel>

                <StackPanel x:Name="CustomizationCategory"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="Settings_Customization" Text="Personalização" FontSize="32" Margin="20,8,10,16"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <controls:SettingBox LocalizationUid="Settings_Shell" Margin="10,0,10,4"
                                         Header="Shell"
                                         Text="Choose Unison, WhatsApp, or WhatsApp Legacy chrome.">
                        <controls:SettingBox.Control>
                            <ComboBox x:Name="ShellComboBox"
                                      MinWidth="160"
                                      SelectedIndex="{Binding SelectedShellIndex, Mode=OneWay}">
                                <Interactivity:Interaction.Behaviors>
                                    <Core:EventTriggerBehavior EventName="SelectionChanged">
                                        <Core:InvokeCommandAction
                                            Command="{Binding ChangeShellCommand}"
                                            CommandParameter="{Binding SelectedIndex, ElementName=ShellComboBox}"/>
                                    </Core:EventTriggerBehavior>
                                </Interactivity:Interaction.Behaviors>
                                <ComboBoxItem Content="Unison"/>
                                <ComboBoxItem Content="WhatsApp"/>
                                <ComboBoxItem Content="WhatsApp Legacy"/>
                            </ComboBox>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_Language" Margin="10,0,10,4"
                                         Header="Language"
                                         Text="App display language.">
                        <controls:SettingBox.Control>
                            <ComboBox x:Name="LanguageComboBox"
                                      MinWidth="160"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_TimeFormat" Margin="10,0,10,4"
                                         Header="Time format"
                                         Text="Choose 24-hour or 12-hour clock.">
                        <controls:SettingBox.Control>
                            <ComboBox x:Name="TimeFormatComboBox"
                                      MinWidth="140"
                                      SelectedIndex="{Binding SelectedTimeFormatIndex, Mode=OneWay}">
                                <Interactivity:Interaction.Behaviors>
                                    <Core:EventTriggerBehavior EventName="SelectionChanged">
                                        <Core:InvokeCommandAction
                                            Command="{Binding ChangeTimeFormatCommand}"
                                            CommandParameter="{Binding SelectedIndex, ElementName=TimeFormatComboBox}"/>
                                    </Core:EventTriggerBehavior>
                                </Interactivity:Interaction.Behaviors>
                                <ComboBoxItem x:Uid="Settings_TimeFormat24Hours" Content="24 Hours"/>
                                <ComboBoxItem x:Uid="Settings_TimeFormat12Hours" Content="12 Hours"/>
                            </ComboBox>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_StartTile" Margin="10,0,10,4"
                                         Header="Start tile"
                                         Text="Choose the icon and pin a tile that receives the same notifications.">
                        <controls:SettingBox.Control>
                            <Button x:Uid="Settings_StartTileChoose"
                                    Content="Choose"
                                    MinWidth="96"
                                    Style="{StaticResource LegacySettingsButtonStyle}"
                                    Command="{Binding ChooseStartTileCommand}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                </StackPanel>

                <StackPanel x:Name="AccountCategory"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="Settings_Advanced" Text="Conta" FontSize="32" Margin="20,8,10,16"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <controls:SettingBox LocalizationUid="Settings_ShowSyncStatus" Margin="10,0,10,4"
                                         Header="Show sync status"
                                         Text="Show the synchronization status in the chat list.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding ShowSyncStatus, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_KeepAlive" Margin="10,0,10,4"
                                         Header="Background mode"
                                         Text="Uses location only so the system does not freeze the app. The position is not read or sent.">
                        <controls:SettingBox.Control>
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                                          IsOn="{Binding LocationKeepAliveEnabled, Mode=TwoWay}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <controls:SettingBox LocalizationUid="Settings_MediaCache" Margin="10,0,10,4"
                                         Header="Chat media"
                                         Text="{Binding DiskUsageText, Mode=OneWay}">
                        <controls:SettingBox.Control>
                            <Button x:Uid="Settings_MediaCacheClean"
                                    Content="Clear data"
                                    MinWidth="120"
                                    Style="{StaticResource LegacySettingsButtonStyle}"
                                    IsEnabled="{Binding CanCleanMediaCache, Mode=OneWay}"
                                    Command="{Binding CleanMediaCacheCommand}"/>
                        </controls:SettingBox.Control>
                    </controls:SettingBox>
                    <Button x:Name="DisconnectButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="10,12,10,8"
                            Foreground="#E81123"
                            Style="{StaticResource LegacySettingsButtonStyle}"
                            Command="{Binding DisconnectCommand}">
                        <TextBlock x:Uid="Settings_Disconnect"
                                   Text="Disconnect"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#E81123"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Button>
                    <controls:AboutControl Margin="20,12,10,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
