<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.StatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- List only — status viewer opens on ShellView DetailHost (same as Chats/Channels). -->
    <local:StatusListView x:Name="StatusListPart"
                          MenuClicked="StatusListPart_MenuClicked"
                          AuthorSelected="StatusListPart_AuthorSelected"
                          SelectionCleared="StatusListPart_SelectionCleared"/>
</Page>
