<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.LegacySectionAppBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Search opens the shell search chrome. It does not query this section.
         The grid paints the full 54. The CommandBar template only paints its content strip. -->
    <Grid MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
          Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
    <CommandBar Style="{StaticResource LegacyCommandBarStyle}"
                Loaded="Bar_Loaded">
        <AppBarButton x:Uid="Shell_LegacyAppBar_Search"
                      Style="{StaticResource LegacyAppBarButtonStyle}"
                      Label="Search"
                      Click="Search_Click">
            <TextBlock Text="&#xEB01;"
                       FontFamily="{StaticResource LegacyIconFont}"
                       FontSize="{StaticResource LegacyAppBarGlyphSize}"
                       TextLineBounds="Tight"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </AppBarButton>
        <CommandBar.SecondaryCommands>
            <AppBarButton x:Name="ProfileSecondaryButton"
                          x:Uid="Shell_LegacyMenu_Profile"
                          Label="Profile"
                          Click="Profile_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE77B;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Uid="Shell_LegacyMenu_Debug"
                          Label="Debug"
                          Click="Debug_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEBE8;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="Shell_LegacyMenu_Settings"
                          Label="Settings"
                          Click="Settings_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar.SecondaryCommands>
    </CommandBar>
    </Grid>
</UserControl>
