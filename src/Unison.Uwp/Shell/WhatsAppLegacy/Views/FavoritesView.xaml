<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Views"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- List + A–Z chip; CommandBar owns Search / Add (same split as Calls). -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SortChip"
                Grid.Row="0"
                Padding="16,10,16,6"
                Background="Transparent"
                Visibility="Collapsed">
            <TextBlock x:Name="SortLabelText"
                       Text="A-Z"
                       FontSize="14"
                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                       FontFamily="{StaticResource MainFont}"
                       VerticalAlignment="Center"/>
        </Border>

        <controls:FavoritesListControl x:Name="FavoritesList"
                                       Grid.Row="1"/>

        <local:LegacySectionAppBar x:Name="FavoritesAppBar"
                                   Grid.Row="2"/>

        <controls:ContactsVisualizerControl
            x:Name="PickerOverlay"
            x:Load="{x:Bind ViewModel.IsPickerOpen, Mode=OneWay}"
            Grid.RowSpan="3"
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.IsPickerOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.PickerTitle, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.PickerCandidates, Mode=OneWay}"
            ItemClickCommand="{x:Bind ViewModel.AddFavoriteCommand}"
            BackCommand="{x:Bind ViewModel.ClosePickerCommand}"/>
    </Grid>
</Page>
