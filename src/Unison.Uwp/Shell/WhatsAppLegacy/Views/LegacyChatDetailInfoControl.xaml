<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.LegacyChatDetailInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ChatDetailInfoBackgroundBrush" Color="#00656A"/>
        <SolidColorBrush x:Key="ChatDetailInfoCommandBarBrush" Color="#00656A"/>
        <SolidColorBrush x:Key="ChatDetailInfoToggleOnBrush" Color="#00656A"/>
        <SolidColorBrush x:Key="ChatDetailInfoToggleOnHoverBrush" Color="#007A80"/>
        <SolidColorBrush x:Key="ChatDetailInfoToggleOnPressedBrush" Color="#005256"/>

        <Style x:Key="LegacyInfoBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="9,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse Width="40" Height="40"
                                     Stroke="{ThemeResource LegacyAppBarRingBrush}"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LegacyInfoMoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ChatDetailInfoCloseHoverBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ChatDetailInfoClosePressedBrush" Color="#55FFFFFF"/>

        <Style x:Key="ChatDetailInfoCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoCloseHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoClosePressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4"
                                                             Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <!-- The divider only separates chat and info when both are on screen. -->
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InfoPaneDivider.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InfoPaneDivider.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="InfoPaneDivider"
                Grid.RowSpan="2"
                Width="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                Visibility="Collapsed"
                Canvas.ZIndex="2"
                IsHitTestVisible="False"/>

        <Grid x:Name="InfoBodyHost"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <controls:ChatDetailUserInfoControl x:Name="UserInfoPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="Collapsed"/>
            <controls:ChatDetailGroupInfoControl x:Name="GroupInfoPanel"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Visibility="Collapsed"/>

            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,8,0"
                    Canvas.ZIndex="1"
                    Style="{StaticResource ChatDetailInfoCloseButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"/>
            </Button>
        </Grid>

        <!-- Circled icons centered; "..." stays on the right and only reveals the captions. -->
        <Grid Grid.Row="1"
              VerticalAlignment="Bottom"
              Background="{StaticResource ChatDetailInfoCommandBarBrush}">
            <StackPanel>
                <Grid Height="54">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="AddContactButton"
                                Style="{StaticResource LegacyInfoBarButtonStyle}"
                                Visibility="Collapsed"
                                Click="AddContactButton_Click">
                            <TextBlock Text="&#xEB02;"
                                       FontFamily="{StaticResource LegacyIconFont}"
                                       FontSize="18"
                                       TextLineBounds="Tight"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="ChatPinButton"
                                Style="{StaticResource LegacyInfoBarButtonStyle}"
                                Click="ChatPinButton_Click">
                            <TextBlock Text="&#xEB07;"
                                       FontFamily="{StaticResource LegacyIconFont}"
                                       FontSize="18"
                                       TextLineBounds="Tight"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="PinButton"
                                Style="{StaticResource LegacyInfoBarButtonStyle}"
                                Click="PinButton_Click">
                            <TextBlock Text="&#xEB08;"
                                       FontFamily="{StaticResource LegacyIconFont}"
                                       FontSize="28"
                                       Margin="1,0,0,0"
                                       TextLineBounds="Tight"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="DeleteChatButton"
                                Style="{StaticResource LegacyInfoBarButtonStyle}"
                                Visibility="Collapsed"
                                Click="DeleteChatButton_Click">
                            <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="MoreButton"
                            Style="{StaticResource LegacyInfoMoreButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            Click="MoreButton_Click">
                        <TextBlock Text="..." FontSize="22" FontFamily="{StaticResource MainFont}" Foreground="White" Margin="0,-8,0,0"/>
                    </Button>
                </Grid>
                <StackPanel x:Name="CaptionRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="0,0,0,8">
                    <TextBlock x:Name="AddContactCaption" Text="add contact" Width="50" Margin="9,0" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="White" Visibility="Collapsed"/>
                    <TextBlock x:Name="ChatPinCaption" Text="pin chat" Width="50" Margin="9,0" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="PinCaption" Text="pin to start" Width="50" Margin="9,0" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="DeleteCaption" Text="delete chat" Width="50" Margin="9,0" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="White" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
