<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.StatusComposerView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:legacyControls="using:Unison.Uwp.Shell.WhatsAppLegacy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="400">

    <!-- Full-screen page (INavigator.NavigateFullScreen). DataContext: StatusComposerViewModel. Send / privacy live in the bottom Legacy CommandBar. -->
    <Page.Resources>
        <!-- No chrome in any state: only the text and its placeholder. RichEditBox so emoji
             render with the packaged WhatsApp face (a TextBox cannot mix fonts per character). -->
        <Style x:Key="StatusComposerInputStyle" TargetType="RichEditBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsSpellCheckEnabled" Value="False"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichEditBox">
                        <Grid Background="Transparent">
                            <ContentControl x:Name="PlaceholderTextContentPresenter"
                                            Content="{TemplateBinding PlaceholderText}"
                                            Foreground="White"
                                            Opacity="0.7"
                                            IsHitTestVisible="False"
                                            IsTabStop="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontFamily="{TemplateBinding FontFamily}"/>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Hidden"
                                          ZoomMode="Disabled"
                                          IsTabStop="False"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{Binding BackgroundColor, Converter={StaticResource HexColorToBrushConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource ModernIconButtonStyle}"
                    Foreground="White"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}"/>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding ToggleEmojiTrayCommand}"
                        AutomationProperties.Name="Emoji">
                    <FontIcon Glyph="{Binding EmojiToggleGlyph}" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleBackgroundCommand}"
                        AutomationProperties.Name="Background color">
                    <FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleFontCommand}"
                        AutomationProperties.Name="Font">
                    <TextBlock Text="Aa"
                               FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}}"
                               FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ChatComposerInput sets chat-sized layout locally in its constructor; these attributes override it. -->
        <controls:ChatComposerInput x:Name="StatusTextInput"
                                    x:Uid="StatusComposer_Input"
                                    Grid.Row="1"
                                    Margin="24,16"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    MinHeight="0"
                                    MaxHeight="100000"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    MaxLength="700"
                                    PlaceholderText="Type a status"
                                    Style="{StaticResource StatusComposerInputStyle}"
                                    FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}, ConverterParameter=Emoji}"
                                    BoundText="{Binding Text, Mode=TwoWay}"/>

        <controls:ChatStickerBox Grid.Row="2"
                                 Visibility="{Binding IsEmojiTrayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Closed-height spacer: the live bar overlays the page so Compact→Open can grow upward. -->
        <Border Grid.Row="3"
                Height="{StaticResource LegacyCommandBarCompactHeight}"
                Background="{ThemeResource LegacyCommandBarBackgroundBrush}"
                IsHitTestVisible="False"/>

        <!--
            Bottom overlay (same idea as Profile inside ContentFrame): Stretch inside an Auto row
            clips the open labels. Host sizes to the bar; open paints over the composer above.
        -->
        <Grid x:Name="ComposerCommandBarHost"
              Grid.RowSpan="4"
              VerticalAlignment="Bottom"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
            <CommandBar x:Name="ComposerCommandBar"
                        Style="{StaticResource LegacyCommandBarStyle}"
                        DefaultLabelPosition="Bottom"
                        VerticalAlignment="Bottom"
                        Loaded="ComposerCommandBar_Loaded">
                <!-- ElementName: CommandBar primary items often do not inherit DataContext. -->
                <AppBarButton x:Uid="StatusComposer_SendAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Send"
                              Command="{Binding DataContext.SendCommand, ElementName=Root}">
                    <TextBlock Text="{StaticResource LegacyGlyphSend}"
                               FontFamily="{StaticResource LegacyIconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>
                <AppBarButton x:Uid="StatusComposer_PrivacyAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Privacy"
                              Command="{Binding DataContext.PrivacyCommand, ElementName=Root}">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>

            </CommandBar>
        </Grid>

        <legacyControls:StatusContactPickerView x:Name="ContactPicker"
                                                Grid.RowSpan="4"
                                                Canvas.ZIndex="5"
                                                ViewModel="{Binding}"
                                                x:Load="{Binding IsContactPickerOpen}"/>

        <Grid Grid.RowSpan="4"
              Canvas.ZIndex="10"
              Background="#B3000000"
              Visibility="{Binding IsPublishing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:ModernProgressRing IsActive="{Binding IsPublishing}"
                                             Width="48" Height="48"
                                             HorizontalAlignment="Center"/>
                <TextBlock x:Uid="StatusComposer_Publishing"
                           Text="Publishing status..."
                           Margin="0,16,0,0"
                           FontSize="15"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
