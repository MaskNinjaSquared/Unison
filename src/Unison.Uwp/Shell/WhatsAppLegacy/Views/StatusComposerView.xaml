<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.StatusComposerView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="400">

    <!-- Full-screen page (INavigator.NavigateFullScreen). DataContext: StatusComposerViewModel. Send / privacy live in the bottom Legacy CommandBar. -->
    <Page.Resources>
        <!-- No chrome in any state: only the text and its placeholder. -->
        <Style x:Key="StatusComposerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsSpellCheckEnabled" Value="False"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ContentControl x:Name="PlaceholderTextContentPresenter"
                                            Content="{TemplateBinding PlaceholderText}"
                                            Foreground="White"
                                            Opacity="0.7"
                                            IsHitTestVisible="False"
                                            IsTabStop="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontFamily="{TemplateBinding FontFamily}"/>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Hidden"
                                          ZoomMode="Disabled"
                                          IsTabStop="False"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{Binding BackgroundColor, Converter={StaticResource HexColorToBrushConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource ModernIconButtonStyle}"
                    Foreground="White"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}"/>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding ToggleEmojiTrayCommand}"
                        AutomationProperties.Name="Emoji">
                    <FontIcon Glyph="{Binding EmojiToggleGlyph}" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleBackgroundCommand}"
                        AutomationProperties.Name="Background color">
                    <FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleFontCommand}"
                        AutomationProperties.Name="Font">
                    <TextBlock Text="Aa"
                               FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}}"
                               FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBox x:Name="StatusTextInput"
                 x:Uid="StatusComposer_Input"
                 Grid.Row="1"
                 Margin="24,16"
                 VerticalAlignment="Center"
                 MaxLength="700"
                 PlaceholderText="Type a status"
                 Style="{StaticResource StatusComposerTextBoxStyle}"
                 FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}}"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <controls:ChatStickerBox Grid.Row="2"
                                 Visibility="{Binding IsEmojiTrayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Closed-height spacer: the live bar overlays the page so Compact→Open can grow upward. -->
        <Border Grid.Row="3"
                Height="{StaticResource LegacyCommandBarCompactHeight}"
                Background="{ThemeResource LegacyCommandBarBackgroundBrush}"
                IsHitTestVisible="False"/>

        <!--
            Bottom overlay (same idea as Profile inside ContentFrame): Stretch inside an Auto row
            clips the open labels. Host sizes to the bar; open paints over the composer above.
        -->
        <Grid x:Name="ComposerCommandBarHost"
              Grid.RowSpan="4"
              VerticalAlignment="Bottom"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
            <CommandBar x:Name="ComposerCommandBar"
                        Style="{StaticResource LegacyCommandBarStyle}"
                        DefaultLabelPosition="Bottom"
                        VerticalAlignment="Bottom"
                        Loaded="ComposerCommandBar_Loaded">
                <!-- ElementName: CommandBar primary items often do not inherit DataContext. -->
                <AppBarButton x:Uid="StatusComposer_SendAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Send"
                              Command="{Binding DataContext.SendCommand, ElementName=Root}">
                    <TextBlock Text="{StaticResource LegacyGlyphSend}"
                               FontFamily="{StaticResource LegacyIconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>
                <AppBarButton x:Uid="StatusComposer_PrivacyAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Privacy"
                              Command="{Binding DataContext.PrivacyCommand, ElementName=Root}">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>

                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="Shell_LegacyMenu_StatusMoreProbe"
                                  Label="More probe"
                                  Command="{Binding DataContext.PrivacyCommand, ElementName=Root}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE710;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
    </Grid>
</Page>
