<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.CallsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Views"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootContentGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="RootContentGrid_SizeChanged">
        <!-- ChatPaneStates: same as StatusView / ChatsView (WideBoth | NarrowList | NarrowDetail). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChatPaneStates">
                <VisualState x:Name="WideBoth">
                    <VisualState.Setters>
                        <Setter Target="Column0.MinWidth" Value="280"/>
                        <Setter Target="Column0.MaxWidth" Value="720"/>
                        <Setter Target="Column1.Width" Value="*"/>
                        <Setter Target="Column1.MinWidth" Value="280"/>
                        <Setter Target="CallsListHost.Visibility" Value="Visible"/>
                        <Setter Target="CallsDetailHost.Visibility" Value="Visible"/>
                        <Setter Target="CallsDetailHost.BorderThickness" Value="1,0,0,0"/>
                        <Setter Target="PaneSplitter.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="Column0.Width" Value="*"/>
                        <Setter Target="Column0.MinWidth" Value="0"/>
                        <Setter Target="Column0.MaxWidth" Value="10000"/>
                        <Setter Target="Column1.Width" Value="0"/>
                        <Setter Target="Column1.MinWidth" Value="0"/>
                        <Setter Target="CallsListHost.Visibility" Value="Visible"/>
                        <Setter Target="CallsDetailHost.Visibility" Value="Collapsed"/>
                        <Setter Target="PaneSplitter.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="Column0.Width" Value="0"/>
                        <Setter Target="Column0.MinWidth" Value="0"/>
                        <Setter Target="Column0.MaxWidth" Value="10000"/>
                        <Setter Target="Column1.Width" Value="*"/>
                        <Setter Target="Column1.MinWidth" Value="0"/>
                        <Setter Target="CallsListHost.Visibility" Value="Collapsed"/>
                        <Setter Target="CallsDetailHost.Visibility" Value="Visible"/>
                        <Setter Target="CallsDetailHost.BorderThickness" Value="0"/>
                        <Setter Target="PaneSplitter.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Column0" Width="380" MinWidth="280" MaxWidth="720"/>
            <ColumnDefinition x:Name="Column1" Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- List only — CommandBar owns New Call / search / menu (no Unison header). -->
        <Grid x:Name="CallsListHost"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:CallsListControl x:Name="CallsList"
                                       Grid.Row="0"/>

            <local:LegacySectionAppBar x:Name="CallsAppBar"
                                       Grid.Row="1"/>
        </Grid>

        <Grid x:Name="CallsDetailHost"
              Grid.Column="1"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource ChatDetailPaneSeparatorBrush}"
              BorderThickness="1,0,0,0">
            <controls:CallsEmptyControl x:Name="RightEmpty"/>
            <controls:CallDetailsControl x:Name="DetailsPane"
                                         Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="PaneSplitter"
                Grid.ColumnSpan="2"
                Width="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Visibility="Collapsed"
                ManipulationMode="None"
                PointerEntered="PaneSplitter_PointerEntered"
                PointerExited="PaneSplitter_PointerExited"
                PointerPressed="PaneSplitter_PointerPressed"
                PointerMoved="PaneSplitter_PointerMoved"
                PointerReleased="PaneSplitter_PointerReleased"
                PointerCaptureLost="PaneSplitter_PointerCaptureLost">
            <Border x:Name="SplitterChrome"
                    Background="{ThemeResource ChatPaneSplitterBackgroundBrush}"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
