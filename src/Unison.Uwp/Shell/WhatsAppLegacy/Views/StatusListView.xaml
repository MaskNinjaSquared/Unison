<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.StatusListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Unison.Core.Models"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter right as a text link (same pattern as Legacy ChatList). -->
        <Grid Grid.Row="0"
              MinHeight="36"
              Padding="0,4"
              Background="Transparent">
            <HyperlinkButton x:Name="FilterButton"
                             Style="{StaticResource LegacyHyperlinkButtonStyle}"
                             Margin="0,0,10,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Click="FilterButton_Click"
                             AutomationProperties.Name="Filter status">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEA01;"
                              FontFamily="{StaticResource UnisonIconFont}"
                              FontSize="11"
                              Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="FilterLabel"
                               Text="Filter Status"
                               Margin="5,0,0,0"
                               FontSize="12"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <ListView x:Name="AuthorList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Authors, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                  SelectionMode="Single"
                  SelectionChanged="AuthorList_SelectionChanged">
            <ListView.Header>
                <StackPanel>
                    <!-- My status row in the list item design (ring, title, caption, time) + "+". -->
                    <ListViewItem x:Name="MyStatusItem"
                                  Style="{StaticResource WhatsAppChatListItemStyle}">
                    <Grid Height="72"
                          Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                            <controls:StatusListAvatarControl x:Name="MyStatusRing"
                                                              Width="56" Height="56"
                                                              Size="56"/>
                            <Grid x:Name="MyStatusPlainAvatar">
                                <controls:ChatAvatarControl Width="48" Height="48"
                                                            Size="48"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            AvatarUrl="{x:Bind ViewModel.SelfAvatarUrl, Mode=OneWay}"/>
                            </Grid>

                            <!-- "+" badge over the photo; its own tap never opens the viewer. -->
                            <Button x:Name="AddStatusButton"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="0"
                                    MinHeight="0"
                                    MinWidth="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Command="{x:Bind ViewModel.AddStatusCommand}"
                                    Tapped="AddStatusButton_Tapped"
                                    AutomationProperties.Name="Add status">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Ellipse Fill="{StaticResource StatusRecentRingBrush}"
                                             Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                             StrokeThickness="2"/>
                                    <FontIcon Glyph="&#xE710;"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="11"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <TextBlock x:Uid="StatusList_MyStatus"
                                       Text="My status"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MyStatusCaption"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       FontFamily="{StaticResource MainFont}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock x:Name="MyStatusTime"
                                   Grid.Column="2"
                                   FontSize="12"
                                   Opacity="0.85"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>

                    </Grid>
                    </ListViewItem>

                    <TextBlock x:Uid="StatusList_RecentHeader"
                               Text="RECENT"
                               Margin="16,12,16,8"
                               FontSize="13"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                               CharacterSpacing="40"/>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StatusAuthorItem">
                    <Grid Height="72" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:StatusListAvatarControl Width="56" Height="56"
                                                          Size="56"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          AvatarUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                                                          ViewState="{x:Bind ViewState, Mode=OneWay}"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewStateCaption, Mode=OneWay}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       FontFamily="{StaticResource MainFont}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind LatestTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   x:Uid="StatusList_Empty"
                   Text="No recent status updates"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                   FontFamily="{StaticResource MainFont}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Grid.Row="1"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:ModernProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Uid="ChatList_Loading"
                           Text="Preparing conversations…"
                           FontSize="14"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           FontFamily="{StaticResource MainFont}"/>
            </StackPanel>
        </Grid>

        <!-- Bottom-aligned: Stretch + MinHeight host clips Compact→Open (same note as ProfileView). -->
        <Grid Grid.Row="2"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
        <CommandBar x:Name="StatusCommandBar"
                    Style="{StaticResource LegacyCommandBarStyle}"
                    DefaultLabelPosition="Bottom"
                    VerticalAlignment="Bottom"
                    Loaded="StatusCommandBar_Loaded">
            <AppBarButton x:Uid="Shell_LegacyAppBar_Search"
                          Style="{StaticResource LegacyAppBarButtonStyle}"
                          Label="Search"
                          Click="SearchAppBar_Click">
                <TextBlock Text="&#xEB01;"
                           FontFamily="{StaticResource LegacyIconFont}"
                           FontSize="{StaticResource LegacyAppBarGlyphSize}"
                           TextLineBounds="Tight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </AppBarButton>
                <AppBarButton x:Uid="Shell_LegacyAppBar_NewStatus"
                          Style="{StaticResource LegacyAppBarButtonStyle}"
                          Label="New status"
                          Command="{x:Bind ViewModel.NewStatusCommand}">
                    <TextBlock Text="&#xEB02;"
                           FontFamily="{StaticResource LegacyIconFont}"
                           FontSize="{StaticResource LegacyAppBarGlyphSize}"
                           TextLineBounds="Tight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </AppBarButton>

                <CommandBar.SecondaryCommands>
                <!-- Probe item: if "…" opens but labels still hide, overflow still works. -->
                <AppBarButton x:Uid="Shell_LegacyMenu_StatusMoreProbe"
                              Label="More probe"
                              Command="{x:Bind ViewModel.NewStatusCommand}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE710;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="ProfileSecondaryButton"
                              x:Uid="Shell_LegacyMenu_Profile"
                              Label="Profile"
                              Click="ProfileAppBar_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE77B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="Shell_LegacyMenu_Debug"
                              Label="Debug"
                              Click="DebugAppBar_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEBE8;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Shell_LegacyMenu_Settings"
                              Label="Settings"
                              Click="SettingsAppBar_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        </Grid>

        <!-- My status page: rows 0–1 only so the CommandBar (and new-status dock) stay available. -->
        <Grid x:Name="MyStatusPanel"
              Grid.Row="0"
              Grid.RowSpan="2"
              Visibility="{x:Bind ViewModel.IsMyStatusOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Border (not Grid.CornerRadius): Creators Update-safe rounded grey strip. -->
            <Border Background="{ThemeResource CommunityHubHeaderBrush}"
                    Margin="10,20,10,0"
                    CornerRadius="3"
                    Padding="4,10,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="MyStatusBackButton_Click"
                            Style="{StaticResource ModernIconButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="4,0,4,0"
                            AutomationProperties.Name="Back">
                        <FontIcon Glyph="&#xE72B;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="18"
                                  Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"/>
                    </Button>
                    <TextBlock Grid.Column="1"
                               x:Uid="StatusList_MyStatusPageTitle"
                               Text="My status"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <ListView x:Name="OwnStatusList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.OwnStatuses, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OwnStatusList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:OwnStatusItem">
                        <Grid Height="72" Padding="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:ChatAvatarControl Width="48" Height="48"
                                                        Size="48"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        AvatarUrl="{x:Bind ThumbnailUri}"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                <TextBlock Text="{x:Bind ViewCountText, Mode=OneWay}"
                                           FontSize="18"
                                           FontFamily="{StaticResource MainFontSemibold}"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind TimestampUtc, Converter={StaticResource ElapsedTimeConverter}}"
                                           FontSize="13"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource MainFont}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ModernIconButtonStyle}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="More options">
                                <FontIcon Glyph="&#xE712;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="18"/>
                                <Button.Flyout>
                                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                                        <MenuFlyoutItem x:Uid="StatusList_OwnForward"
                                                        Text="Forward"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnSave"
                                                        Text="Save"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnShare"
                                                        Text="Share"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnDelete"
                                                        Text="Delete"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--
            New status dock: same chrome as the chat attachment bar (scrim over everything, bar
            sliding up over the CommandBar, heading, accent tiles, chevron strip) with two tiles.
            Driven by IsNewStatusPickerOpen; the slide runs from the view.
        -->
        <Border x:Name="NewStatusScrim"
                Grid.RowSpan="3"
                Canvas.ZIndex="3"
                Background="#99000000"
                Opacity="0"
                Visibility="Collapsed"
                Tapped="NewStatusScrim_Tapped"/>

        <Grid x:Name="NewStatusDock"
              Grid.RowSpan="3"
              Canvas.ZIndex="4"
              VerticalAlignment="Bottom"
              Visibility="Collapsed"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NewStatusDockTranslate" Y="1000"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <TextBlock x:Uid="StatusList_NewStatusDockTitle"
                       Text="NEW STATUS"
                       Margin="10,14,10,4"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       Foreground="{ThemeResource ChatDetailMutedTextBrush}"/>

            <!-- Same 5px padding + 5px tile margin as the attachment bar; tiles centred. -->
            <Grid x:Name="NewStatusTilesGrid"
                  Grid.Row="1"
                  Padding="5,5,5,0"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:AttachTile Grid.Column="0"
                                     IconGlyph="&#xEB10;"
                                     IconFontFamily="{StaticResource LegacyIconFont}"
                                     Label="Photo &amp; video"
                                     LocalizationUid="StatusList_NewMediaStatusTile"
                                     Command="{x:Bind ViewModel.StartMediaStatusCommand}"/>

                <controls:AttachTile Grid.Column="1"
                                     IconGlyph="&#xE8D2;"
                                     IconFontFamily="{StaticResource IconFont}"
                                     Label="Text"
                                     LocalizationUid="StatusList_NewTextStatusTile"
                                     Command="{x:Bind ViewModel.StartTextStatusCommand}"/>
            </Grid>

            <Grid Grid.Row="2" Padding="12,0">
                <Button Style="{StaticResource WhatsAppIconButtonStyle}"
                        Width="40" Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CloseNewStatusPickerCommand}"
                        AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{ThemeResource ChatDetailMutedTextBrush}"/>
                </Button>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
