<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.StatusListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Unison.Core.Models"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Legacy: no page title (pivot owns section name). -->
        <Grid Grid.Row="0" Padding="16,8,16,8">
            <Button x:Name="MenuButton"
                    HorizontalAlignment="Right"
                    Click="MenuButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>
        </Grid>

        <ListView x:Name="AuthorList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Authors, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                  SelectionMode="Single"
                  SelectionChanged="AuthorList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StatusAuthorItem">
                    <Grid Height="72" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:ChatAvatarControl Width="48" Height="48"
                                                    Size="48"
                                                    ShowBorder="True"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    AvatarUrl="{x:Bind AvatarUrl, Mode=OneWay}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   FontSize="18"
                                   FontFamily="{StaticResource MainFontSemibold}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind LatestTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   x:Uid="StatusList_Empty"
                   Text="No recent status updates"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                   FontFamily="{StaticResource MainFont}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
