<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Unison.Uwp.UI.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Dark">

    <!--
      Left: brand + pivot + list frame (+ list search).
      Right: chat detail host — column only exists when a chat is open.
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: pivot + list -->
        <Grid x:Name="ListChromeRoot"
              Grid.Column="0"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="BrandHeader"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="16,12,16,4"
                        VerticalAlignment="Center">
                <Image Width="40" Height="40"
                       Stretch="Uniform"
                       Source="ms-appx:///Assets/CustomTiles/WhatsAppLegacy.png"
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="BrandTitle"
                           x:Uid="Shell_LegacyBrand"
                           Text="WHATSAPP LEGACY"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           CharacterSpacing="-20"/>
            </StackPanel>

            <!-- Search only on the list column -->
            <Grid x:Name="SearchHeader"
                  Grid.Row="0"
                  Margin="8,10,8,6"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Click="SearchBackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        MinWidth="40"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource WhatsAppTextHighBrush}">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72B;" FontSize="20"/>
                </Button>
                <TextBox x:Name="ShellSearchBox"
                         Grid.Column="1"
                         Style="{StaticResource LegacySearchBoxStyle}"
                         x:Uid="Shell_LegacySearchBox"
                         PlaceholderText="search"
                         VerticalAlignment="Center"
                         TextChanged="ShellSearchBox_TextChanged"/>
                <Button Grid.Column="2"
                        x:Uid="Shell_LegacySearch_Cancel"
                        Content="cancel"
                        Click="CancelSearchButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource WhatsAppTextHighBrush}"
                        FontFamily="{StaticResource MainFontLight}"/>
            </Grid>

            <Pivot x:Name="SectionPivot"
                   Grid.Row="1"
                   Height="56"
                   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                   SelectionChanged="SectionPivot_SelectionChanged">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="18"
                                   FontFamily="{StaticResource MainFontLight}"
                                   Margin="0,0,12,0"/>
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem Header="chats" Tag="chats"/>
                <PivotItem x:Uid="Shell_LegacyPivot_Calls" Header="calls" Tag="calls"/>
                <PivotItem Header="status" Tag="status"/>
                <PivotItem x:Uid="Shell_LegacyPivot_Favorites" Header="favorites" Tag="favorites"/>
                <PivotItem Header="archived" Tag="archived"/>
            </Pivot>

            <Frame x:Name="ContentFrame"
                   Grid.Row="2"
                   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                   Navigated="ContentFrame_Navigated"
                   NavigationFailed="ContentFrame_NavigationFailed"/>
        </Grid>

        <!-- RIGHT: only when a chat is open (wide) or fullscreen (narrow) -->
        <Border x:Name="DetailHost"
                Grid.Column="1"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed">
            <views:ChatDetailView x:Name="ShellChatDetail"/>
        </Border>
    </Grid>
</Page>
