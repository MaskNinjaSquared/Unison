<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Dark">

    <!--
      Left: brand + pivot + list frame (+ list search).
      Right: chat detail host — column only exists when a chat is open.
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: pivot + list -->
        <Grid x:Name="ListChromeRoot"
              Grid.Column="0"
              
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="BrandHeader"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,5,10,-10"
                        
                        VerticalAlignment="Center">
                <Image Width="40" Height="40"
                       Stretch="Uniform"
                       Source="ms-appx:///Assets/CustomTiles/WhatsAppLegacy.png"
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="BrandTitle"
                           x:Uid="Shell_LegacyBrand"
                           Text="WHATSAPP LEGACY"
                           Margin="0,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           CharacterSpacing="-20"/>
                <TextBlock Text="{Binding NotificationCounterBadgeText}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource ChatDetailAccentBrush}"/>
            
            </StackPanel>

            <!-- Search: back + title, then a short WP8 text box. Enter runs the pivot search. -->
            <Grid x:Name="SearchHeader"
                  Grid.Row="0"
                  Margin="12,8,12,8"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SearchBackButton_Click"
                            Style="{StaticResource LegacyBackButtonStyle}"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Uid="Shell_LegacySearchTitle"
                               Text="buscar"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </StackPanel>
                <TextBox x:Name="ShellSearchBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         Style="{StaticResource LegacySearchBoxStyle}"
                         x:Uid="Shell_LegacySearchBox"
                         PlaceholderText="search"
                         VerticalAlignment="Center"
                         KeyDown="ShellSearchBox_KeyDown"/>
            </Grid>

            <!-- Section views are created into these presenters the first time the index is opened. -->
            <Pivot x:Name="SectionPivot"
                   Grid.Row="1"
                   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                   SelectionChanged="SectionPivot_SelectionChanged">
                <Pivot.Resources>
                    <Thickness x:Key="PivotItemMargin">0</Thickness>
                    <Thickness x:Key="PivotHeaderItemMargin">0</Thickness>
                </Pivot.Resources>
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="18"
                                   FontFamily="{StaticResource MainFontLight}"
                                   Padding="16,0"/>
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <PivotItem Header="chats" Tag="chats">
                    <ContentPresenter x:Name="ChatsPresenter"/>
                </PivotItem>
                <PivotItem x:Uid="Shell_LegacyPivot_Calls" Header="calls" Tag="calls">
                    <ContentPresenter x:Name="CallsPresenter"/>
                </PivotItem>
                <PivotItem Header="status" Tag="status">
                    <ContentPresenter x:Name="StatusPresenter"/>
                </PivotItem>
                <PivotItem x:Uid="Shell_LegacyPivot_Favorites" Header="favorites" Tag="favorites">
                    <ContentPresenter x:Name="FavoritesPresenter"/>
                </PivotItem>
                <PivotItem Header="archived" Tag="archived">
                    <ContentPresenter x:Name="ArchivedPresenter"/>
                </PivotItem>
            </Pivot>

            <!-- Settings and debug only. Pivot sections are not navigated here. -->
            <Frame x:Name="ContentFrame"
                   Grid.Row="1"
                   Canvas.ZIndex="2"
                   Visibility="Collapsed"
                   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                   Navigated="ContentFrame_Navigated"
                   NavigationFailed="ContentFrame_NavigationFailed"/>
        </Grid>

        <!-- RIGHT: only when a chat is open (wide) or fullscreen (narrow) -->
        <Border x:Name="DetailHost"
                Grid.Column="1"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed">
            <local:ChatDetailView x:Name="ShellChatDetail"/>
        </Border>
    </Grid>
</Page>
