<Page
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Views"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Dark">

    <!--
      Left: brand + pivot + list frame (+ list search).
      Right: chat detail host — column only exists when a chat is open.
    -->
    <Grid x:Name="RootContentGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: pivot + list -->
        <Grid x:Name="ListChromeRoot"
              Grid.Column="0"
              
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="BrandHeader"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,5,10,-10"
                        
                        VerticalAlignment="Center">
                <Image Width="40" Height="40"
                       Stretch="Uniform"
                       Source="ms-appx:///Assets/CustomTiles/WhatsAppLegacy.png"
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="BrandTitle"
                           x:Uid="Shell_LegacyBrand"
                           Text="WHATSAPP LEGACY"
                           Margin="0,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           CharacterSpacing="-20"/>
                <TextBlock Text="{Binding NotificationCounterBadgeText}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontLight}"
                           Foreground="{ThemeResource ChatDetailAccentBrush}"/>
            
            </StackPanel>

            <!-- Search: back + title, then a short WP8 text box. Enter runs the pivot search. -->
            <Grid x:Name="SearchHeader"
                  Grid.Row="0"
                  Margin="12,8,12,8"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SearchBackButton_Click"
                            Style="{StaticResource LegacyBackButtonStyle}"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Uid="Shell_LegacySearchTitle"
                               Text="Search"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="28"
                               FontFamily="{StaticResource MainFontLight}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </StackPanel>
                <TextBox x:Name="ShellSearchBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         Style="{StaticResource LegacySearchBoxStyle}"
                         x:Uid="Shell_LegacySearchBox"
                         PlaceholderText="search"
                         VerticalAlignment="Center"
                         KeyDown="ShellSearchBox_KeyDown"/>
            </Grid>

            <!-- Section views land in presenters on first open; overlay paints before heavy Create. -->
            <Grid Grid.Row="1">
                <Pivot x:Name="SectionPivot"
                       Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                       SelectionChanged="SectionPivot_SelectionChanged">
                    <Pivot.Resources>
                        <Thickness x:Key="PivotItemMargin">0</Thickness>
                        <Thickness x:Key="PivotHeaderItemMargin">0</Thickness>
                    </Pivot.Resources>
                    <Pivot.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontLight}"
                                       Padding="16,0"/>
                        </DataTemplate>
                    </Pivot.HeaderTemplate>
                    <PivotItem Header="chats" Tag="chats">
                        <ContentPresenter x:Name="ChatsPresenter"/>
                    </PivotItem>
                    <PivotItem x:Uid="Shell_LegacyPivot_Calls" Header="calls" Tag="calls">
                        <ContentPresenter x:Name="CallsPresenter"/>
                    </PivotItem>
                    <PivotItem Header="status" Tag="status">
                        <ContentPresenter x:Name="StatusPresenter"/>
                    </PivotItem>
                    <PivotItem x:Uid="Shell_LegacyPivot_Favorites" Header="favorites" Tag="favorites">
                        <ContentPresenter x:Name="FavoritesPresenter"/>
                    </PivotItem>
                    <PivotItem Header="archived" Tag="archived">
                        <ContentPresenter x:Name="ArchivedPresenter"/>
                    </PivotItem>
                </Pivot>

                <Grid x:Name="SectionLoadingOverlay"
                      Visibility="Collapsed"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      Canvas.ZIndex="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:ModernProgressRing IsActive="True" Width="36" Height="36"/>
                        <TextBlock x:Name="SectionLoadingText"
                                   x:Uid="ChatList_Loading"
                                   Text="Preparing conversations…"
                                   FontSize="14"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                                   FontFamily="{StaticResource MainFont}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right edge of the list, desktop only. Narrow keeps the list full-bleed. -->
            <Border x:Name="ListDesktopDivider"
                    Grid.RowSpan="2"
                    Canvas.ZIndex="3"
                    Width="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
        </Grid>

        <!-- Drag handle between list and chat. Desktop only, same limits as the other shells. -->
        <Border x:Name="PaneSplitter"
                Grid.ColumnSpan="2"
                Canvas.ZIndex="3"
                Width="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Visibility="Collapsed"
                ManipulationMode="None"
                PointerEntered="PaneSplitter_PointerEntered"
                PointerExited="PaneSplitter_PointerExited"
                PointerPressed="PaneSplitter_PointerPressed"
                PointerMoved="PaneSplitter_PointerMoved"
                PointerReleased="PaneSplitter_PointerReleased"
                PointerCaptureLost="PaneSplitter_PointerCaptureLost">
            <Border x:Name="SplitterChrome"
                    Background="{ThemeResource ChatPaneSplitterBackgroundBrush}"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="0,2" Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2" Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2" Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- RIGHT: only when a chat is open (wide) or fullscreen (narrow) -->
        <Border x:Name="DetailHost"
                Grid.Column="1"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed">
            <local:ChatDetailView x:Name="ShellChatDetail"/>
        </Border>

        <!-- Settings and debug. Spans both columns so an open chat cannot stay beside them. -->
        <Frame x:Name="ContentFrame"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Canvas.ZIndex="4"
               Visibility="Collapsed"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
               Navigated="ContentFrame_Navigated"
               NavigationFailed="ContentFrame_NavigationFailed"/>
    </Grid>
</Page>
