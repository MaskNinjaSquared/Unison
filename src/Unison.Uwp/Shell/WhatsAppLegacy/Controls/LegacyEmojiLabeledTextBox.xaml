<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Controls.LegacyEmojiLabeledTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    x:Name="Root">

    <!--
      WP8-style labeled field for Legacy create flows: header outside above the box,
      emoji glyph inside on the right (same chrome family as LegacySearchBoxStyle).
    -->
    <StackPanel>
        <TextBlock x:Name="HeaderText"
                   Text="{Binding ElementName=Root, Path=Header}"
                   FontSize="16"
                   FontFamily="{StaticResource MainFontLight}"
                   Foreground="{ThemeResource WhatsAppTextHighBrush}"
                   Margin="0,0,0,8"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>

        <Border Background="Transparent"
                BorderBrush="{ThemeResource LegacySearchBorderBrush}"
                BorderThickness="2"
                MinHeight="{Binding ElementName=Root, Path=MinBoxHeight}"
                Padding="10,2,4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:ChatComposerInput x:Name="InputBox"
                                            PlaceholderText="{Binding ElementName=Root, Path=PlaceholderText}"
                                            BoundText="{Binding ElementName=Root, Path=Text, Mode=TwoWay}"
                                            AcceptsReturn="{Binding ElementName=Root, Path=AcceptsReturn}"
                                            TextWrapping="{Binding ElementName=Root, Path=TextWrapping}"
                                            BorderThickness="0"
                                            Padding="0,2,0,2"
                                            MinHeight="28"
                                            MaxHeight="{Binding ElementName=Root, Path=MaxInputHeight}"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="{Binding ElementName=Root, Path=InputVerticalContentAlignment}"
                                            Background="Transparent"
                                            Foreground="{ThemeResource WhatsAppTextHighBrush}"
                                            FontSize="16"
                                            FontFamily="{StaticResource MainFontLight}"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <Button Grid.Column="1"
                        Width="36"
                        Height="32"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        Click="EmojiButton_Click"
                        AutomationProperties.Name="Emoji">
                    <FontIcon Glyph="&#xE76E;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
