<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Controls.StatusContactPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    x:Name="Root"
    Background="{ThemeResource ChatListBackgroundBrush}">

    <!-- Legacy: title only on top; Confirm / Cancel in the bottom CommandBar. DataContext: StatusComposerViewModel. -->
    <UserControl.Resources>
        <DataTemplate x:Key="PickerContactTemplate">
            <Grid Padding="12,10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChatAvatarControl Width="40" Height="40"
                                            Size="40"
                                            ShowBorder="True"
                                            VerticalAlignment="Center"
                                            AvatarUrl="{Binding AvatarUrl}"
                                            IsGroup="{Binding IsGroup}"/>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Text="{Binding Name}"
                           FontSize="17"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PickerGroupHeaderTemplate">
            <Border Width="36" Height="36"
                    Margin="10,12,16,4"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="2"
                    Background="Transparent">
                <TextBlock Text="{Binding Key}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontSemibold}"
                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <Style x:Key="PickerGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PickerZoomedOutTemplate">
            <Border Width="72" Height="72"
                    Margin="6"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Key}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Padding="16,12,16,8">
            <TextBlock Text="{Binding ContactPickerTitle}"
                       FontSize="20"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
            <TextBlock Text="{Binding ContactPickerSubtitle}"
                       FontSize="13"
                       FontFamily="{StaticResource MainFont}"
                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </StackPanel>

        <SemanticZoom x:Name="PickerZoom" Grid.Row="1">
            <SemanticZoom.ZoomedInView>
                <ListView x:Name="PickerList"
                          SelectionMode="Multiple"
                          IsMultiSelectCheckBoxEnabled="True"
                          ItemTemplate="{StaticResource PickerContactTemplate}"
                          Background="Transparent"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource PickerGroupHeaderTemplate}"
                                    HeaderContainerStyle="{StaticResource PickerGroupHeaderContainerStyle}"/>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <GridView x:Name="PickerJumpList"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemTemplate="{StaticResource PickerZoomedOutTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          Background="Transparent">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           MaximumRowsOrColumns="4"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>

        <!-- Icon via Content: LegacyAppBarButtonStyle ignores Icon. -->
        <Grid Grid.Row="2"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              VerticalAlignment="Bottom"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}">
            <CommandBar x:Name="PickerCommandBar"
                        Style="{StaticResource LegacyCommandBarStyle}"
                        DefaultLabelPosition="Bottom"
                        VerticalAlignment="Bottom"
                        Loaded="PickerCommandBar_Loaded">
                <!-- ElementName: CommandBar primary items often do not inherit DataContext. -->
                <AppBarButton x:Uid="StatusPicker_ConfirmAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Confirm"
                              Command="{Binding ViewModel.ContactPickerConfirmCommand, ElementName=Root}">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>
                <AppBarButton x:Uid="StatusPicker_CancelAppBar"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="Cancel"
                              Command="{Binding ViewModel.ContactPickerCancelCommand, ElementName=Root}">
                    <TextBlock Text="&#xE711;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="{StaticResource LegacyAppBarGlyphSize}"
                               TextLineBounds="Tight"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </AppBarButton>
            </CommandBar>
        </Grid>
    </Grid>
</UserControl>
