<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Controls.LegacyChatDetailHeaderIdentity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="40"
    d:DesignWidth="40"
    IsTabStop="False"
    Visibility="Collapsed">

    <!--
      Legacy chat header never shows a contact/group photo.
      Community Avisos is the only exception: megaphone on a blue plate (no photo).
    -->
    <Grid x:Name="RootGrid" Width="40" Height="40">
        <Ellipse x:Name="Plate"
                 Width="40" Height="40"
                 Fill="#FF3390EC"/>
        <FontIcon x:Name="Megaphone"
                  Glyph="&#xE789;"
                  FontFamily="{StaticResource IconFont}"
                  FontSize="17"
                  Foreground="White"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
    </Grid>
</UserControl>
