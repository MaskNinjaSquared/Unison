<UserControl
    x:Class="Unison.Uwp.Shell.WhatsAppLegacy.Controls.CreateConversationFlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:local="using:Unison.Uwp.Shell.WhatsAppLegacy.Controls"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    x:Name="Root"
    Background="{ThemeResource ChatListBackgroundBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="CreateFlowContactTemplate">
            <Grid Padding="12,10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChatAvatarControl Width="40" Height="40"
                                            Size="40"
                                            ShowBorder="True"
                                            VerticalAlignment="Center"
                                            AvatarUrl="{Binding AvatarUrl}"
                                            IsGroup="{Binding IsGroup}"/>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Text="{Binding Name}"
                           FontSize="17"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CreateFlowGroupHeaderTemplate">
            <Border Width="36" Height="36"
                    Margin="10,12,16,4"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="2"
                    Background="Transparent">
                <TextBlock Text="{Binding Key}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontSemibold}"
                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <Style x:Key="CreateFlowGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CreateFlowZoomedOutTemplate">
            <Border Width="72" Height="72"
                    Margin="6"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Key}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ChatListBackgroundBrush}">
        <!-- Collapses while IsCreating so only the centered ProgressRing remains. -->
        <Grid x:Name="CreateContentHost"
              Visibility="{Binding IsCreating, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CreateFormColumn" Width="*"/>
            <ColumnDefinition x:Name="CreateExplainColumn" Width="0" MinWidth="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form-column header: the explain pane and grip run to the top like chat list/detail.
             Hidden while GroupPermissionsOverlay owns back + title. -->
        <Grid x:Name="CreateHeader"
              Grid.Row="0"
              Grid.Column="0"
              Padding="4,8,16,8"
              Background="{ThemeResource ChatListBackgroundBrush}"
              Visibility="{Binding ShowCreateFlowHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ModernIconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0"
                    Command="{Binding HeaderBackCommand}">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding HeaderTitle}"
                       FontSize="20"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </Grid>

        <!-- Community Minimal intro -->
        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              Visibility="{Binding ShowCommunityIntro, Converter={StaticResource BooleanToVisibilityConverter}}"
              Padding="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CreateExplainTitle}"
                           FontSize="22"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CreateExplainBody}"
                           Margin="0,12,0,0"
                           FontSize="15"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Margin="0,16,0,8"
                    MinHeight="44"
                    Background="{ThemeResource WhatsAppGreenFocusBrush}"
                    Foreground="White"
                    Command="{Binding StartCommunityCreateCommand}">
                <TextBlock x:Uid="CreateFlow_Start"
                           Text="Get started"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <controls:CreateChannelIntroOverlay Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Visibility="{Binding ShowChannelIntro, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Form: emoji docks sit outside Pivot/community padding (full form width). -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Visibility="{Binding ShowCreateForm, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Pivot x:Name="CreateGroupPivot"
                   Grid.Row="0"
                   Visibility="{Binding IsCreateGroup, Converter={StaticResource BooleanToVisibilityConverter}}"
                   SelectionChanged="CreateGroupPivot_SelectionChanged">
                <PivotItem x:Uid="CreateGroup_MembersHeader" Header="Select members">
                    <!-- Same A–Z SemanticZoom composition as New Conversation contacts. -->
                    <SemanticZoom x:Name="MembersZoom">
                        <SemanticZoom.ZoomedInView>
                            <ListView x:Name="CreateMembersList"
                                      SelectionMode="Multiple"
                                      IsMultiSelectCheckBoxEnabled="True"
                                      SelectionChanged="CreateMembersList_SelectionChanged"
                                      ItemTemplate="{StaticResource CreateFlowContactTemplate}"
                                      Background="Transparent"
                                      ScrollViewer.IsVerticalScrollChainingEnabled="False">
                                <ListView.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource CreateFlowGroupHeaderTemplate}"
                                                HeaderContainerStyle="{StaticResource CreateFlowGroupHeaderContainerStyle}"/>
                                </ListView.GroupStyle>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </SemanticZoom.ZoomedInView>
                        <SemanticZoom.ZoomedOutView>
                            <GridView x:Name="MembersJumpList"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ItemTemplate="{StaticResource CreateFlowZoomedOutTemplate}"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      Background="Transparent">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                       HorizontalAlignment="Center"
                                                       MaximumRowsOrColumns="4"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                            </GridView>
                        </SemanticZoom.ZoomedOutView>
                    </SemanticZoom>
                </PivotItem>
                <PivotItem x:Uid="CreateGroup_InfoHeader" Header="Group details">
                        <ScrollViewer x:Name="GroupInfoScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,50,0,50"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Padding="16,24"
                                  HorizontalAlignment="Stretch">
                                <StackPanel MaxWidth="600"
                                            HorizontalAlignment="Stretch">
                                <!-- Camera on the right edge (same column as ephemeral status glyph). -->
                                <Grid MinHeight="160" HorizontalAlignment="Center" Margin="0,0,0,50">
                                    <toolkit:DropShadowPanel BlurRadius="80"
                                                             OffsetX="0"
                                                             OffsetY="4"
                                                             ShadowOpacity="0.45"
                                                             Color="Black"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                        <Grid Width="160" Height="160">
                                            <Ellipse Fill="{ThemeResource AvatarFallbackBackgroundBrush}"/>
                                            <Viewbox Width="64" Height="64"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasGroupPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                                <Canvas Width="20" Height="19">
                                                    <Path Fill="{ThemeResource AvatarFallbackIconBrush}"
                                                          Data="M1.50,11.00L11.50,11.00C12.27,11.00,12.92,11.59,12.99,12.36L13.00,12.50 13.00,14.50C13.00,18.00 9.28,19.00 6.50,19.00 3.78,19.00 0.16,18.04 0.00,14.73L0.00,14.50 0.00,12.50C0.00,11.73 0.59,11.08 1.36,11.01z M13.49,11.00L18.50,11.00C19.27,11.00 19.92,11.59 19.99,12.35L20.00,12.50 20.00,14.00C20.00,17.06 17.14,18.00 15.00,18.00 14.27,18.00 13.55,17.89 12.86,17.68 13.51,16.93 13.94,15.97 13.99,14.78L14.00,14.50 14.00,12.50C14.00,12.01 13.85,11.55 13.60,11.16L13.49,11.00 18.50,11.00z M6.50,0.00C8.99,0.00 11.00,2.01 11.00,4.50 11.00,6.99 8.99,9.00 6.50,9.00 4.01,9.00 2.00,6.99 2.00,4.50 2.00,2.01 4.01,0.00 6.50,0.00z M15.50,2.00C17.43,2.00 19.00,3.57 19.00,5.50 19.00,7.43 17.43,9.00 15.50,9.00 13.57,9.00 12.00,7.43 12.00,5.50 12.00,3.57 13.57,2.00 15.50,2.00z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <Ellipse Visibility="{Binding HasGroupPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="GroupPhotoBrush"
                                                                Stretch="UniformToFill"
                                                                AlignmentX="Center"
                                                                AlignmentY="Center"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Fill="#66000000"
                                                     Visibility="{Binding HasGroupPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                                     IsHitTestVisible="False"/>
                                            <TextBlock x:Uid="CreateGroup_AddPhotoOverlay"
                                                       Text="Add group image..."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       Margin="20"
                                                       FontSize="13"
                                                       FontFamily="{StaticResource MainFont}"
                                                       Foreground="White"
                                                       Visibility="{Binding HasGroupPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </toolkit:DropShadowPanel>
                                    <controls:ProfilePhotoButton x:Name="GroupPhotoButton"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Bottom"/>
                                </Grid>

                                <local:LegacyEmojiLabeledTextBox x:Name="GroupNameField"
                                                           x:Uid="CreateGroup_Name"
                                                           Margin="0,20,0,0"
                                                           Header="Group name"
                                                           PlaceholderText="Group name"
                                                           Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           AcceptsReturn="False"
                                                           TextWrapping="NoWrap"
                                                           MaxInputHeight="36"
                                                           MinBoxHeight="40"
                                                           HorizontalAlignment="Stretch"
                                                           EmojiInvoked="GroupField_EmojiInvoked"/>

                                <Button Margin="0,20,0,0"
                                        Padding="10,12,20,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding EditGroupEphemeralCommand}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch">
                                            <TextBlock x:Uid="CreateGroup_EphemeralTitle"
                                                       Text="Temporary messages"
                                                       FontSize="16"
                                                       FontFamily="{StaticResource MainFontSemibold}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                            <TextBlock Text="{Binding GroupEphemeralStatusLabel}"
                                                       Margin="0,2,0,0"
                                                       FontSize="14"
                                                       FontFamily="{StaticResource MainFont}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xEA0A;"
                                                  FontFamily="{StaticResource UnisonIconFont}"
                                                  FontSize="22"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                                    </Grid>
                                </Button>

                                <Button Margin="0,4,0,0"
                                        Height="65"
                                        Padding="10,12,20,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding OpenGroupPermissionsCommand}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="CreateGroup_PermissionsTitle"
                                                   Text="Group permissions"
                                                   FontSize="16"
                                                   FontFamily="{StaticResource MainFontSemibold}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE713;"
                                                  FontFamily="{StaticResource IconFont}"
                                                  FontSize="20"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                                    </Grid>
                                </Button>

                                <Grid Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedMembersCount}"
                                                   FontSize="14"
                                                   FontFamily="{StaticResource MainFont}"
                                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="CreateGroup_MembersSelectedSuffix"
                                                   Text=" selected"
                                                   Margin="4,0,0,0"
                                                   FontSize="14"
                                                   FontFamily="{StaticResource MainFont}"
                                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1"
                                                     x:Uid="CreateGroup_ManageMembers"
                                                     Content="Manage"
                                                     Padding="8,4"
                                                     VerticalAlignment="Center"
                                                     Command="{Binding ManageGroupMembersCommand}"/>
                                </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                </PivotItem>
            </Pivot>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCreateCommunity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Padding="16,24" MaxWidth="420" HorizontalAlignment="Center">
                        <Grid Width="160" Height="160" HorizontalAlignment="Center">
                            <toolkit:DropShadowPanel BlurRadius="24"
                                                     OffsetX="0"
                                                     OffsetY="4"
                                                     ShadowOpacity="0.45"
                                                     Color="Black"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch">
                                <Border Width="160" Height="160"
                                        CornerRadius="12"
                                        Background="{ThemeResource AvatarFallbackBackgroundBrush}">
                                    <Grid>
                                        <Viewbox Width="64" Height="64"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding HasCommunityPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                            <Canvas Width="20" Height="19">
                                                <Path Fill="{ThemeResource AvatarFallbackIconBrush}"
                                                      Data="M1.50,11.00L11.50,11.00C12.27,11.00,12.92,11.59,12.99,12.36L13.00,12.50 13.00,14.50C13.00,18.00 9.28,19.00 6.50,19.00 3.78,19.00 0.16,18.04 0.00,14.73L0.00,14.50 0.00,12.50C0.00,11.73 0.59,11.08 1.36,11.01z M13.49,11.00L18.50,11.00C19.27,11.00 19.92,11.59 19.99,12.35L20.00,12.50 20.00,14.00C20.00,17.06 17.14,18.00 15.00,18.00 14.27,18.00 13.55,17.89 12.86,17.68 13.51,16.93 13.94,15.97 13.99,14.78L14.00,14.50 14.00,12.50C14.00,12.01 13.85,11.55 13.60,11.16L13.49,11.00 18.50,11.00z M6.50,0.00C8.99,0.00 11.00,2.01 11.00,4.50 11.00,6.99 8.99,9.00 6.50,9.00 4.01,9.00 2.00,6.99 2.00,4.50 2.00,2.01 4.01,0.00 6.50,0.00z M15.50,2.00C17.43,2.00 19.00,3.57 19.00,5.50 19.00,7.43 17.43,9.00 15.50,9.00 13.57,9.00 12.00,7.43 12.00,5.50 12.00,3.57 13.57,2.00 15.50,2.00z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Border x:Name="CommunityPhotoImageHost"
                                                CornerRadius="12"
                                                Visibility="{Binding HasCommunityPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush x:Name="CommunityPhotoBrush"
                                                            Stretch="UniformToFill"
                                                            AlignmentX="Center"
                                                            AlignmentY="Center"/>
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#66000000"
                                                CornerRadius="12"
                                                Visibility="{Binding HasCommunityPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                            <TextBlock x:Uid="CreateCommunity_AddPhotoOverlay"
                                                       Text="Add community image..."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       Margin="16"
                                                       FontSize="13"
                                                       FontFamily="{StaticResource MainFont}"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </toolkit:DropShadowPanel>
                            <Button Width="36" Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,-4,-4"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    BorderThickness="0"
                                    Background="{ThemeResource WhatsAppGreenFocusBrush}"
                                    Command="{Binding PickCommunityPhotoCommand}"
                                    AutomationProperties.Name="Change community photo"
                                    Canvas.ZIndex="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{TemplateBinding Background}"/>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                                <FontIcon Glyph="&#xE72C;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="14"
                                          Foreground="White"/>
                            </Button>
                        </Grid>

                        <local:LegacyEmojiLabeledTextBox x:Name="CommunityNameField"
                                                     x:Uid="CreateCommunity_Name"
                                                     Margin="0,20,0,0"
                                                     Header="Community name"
                                                     PlaceholderText="Community name"
                                                     Text="{Binding CommunityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinBoxHeight="56"
                                                     EmojiInvoked="CommunityField_EmojiInvoked"/>
                        <local:LegacyEmojiLabeledTextBox x:Name="CommunityDescriptionField"
                                                   x:Uid="CreateCommunity_Description"
                                                   Margin="0,12,0,0"
                                                   Header="Community description"
                                                   PlaceholderText="Community description"
                                                   Text="{Binding CommunityDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   AcceptsReturn="True"
                                                   TextWrapping="Wrap"
                                                   InputVerticalContentAlignment="Top"
                                                   MinBoxHeight="140"
                                                   MaxInputHeight="220"
                                                   EmojiInvoked="CommunityField_EmojiInvoked"/>
                    </StackPanel>
            </ScrollViewer>

            <controls:CreateChannelFormOverlay x:Name="ChannelFormOverlay"
                                               Grid.Row="0"
                                               Grid.RowSpan="2"
                                               Visibility="{Binding IsCreateChannel, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Border x:Name="GroupEmojiDock"
                    Grid.Row="1"
                    Height="280"
                    Visibility="Collapsed"
                    Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                    BorderBrush="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                    BorderThickness="0,1,0,0">
                <controls:EmojiPickerPanel x:Name="GroupEmojiPanel"
                                           GlyphPicked="GroupEmojiPanel_GlyphPicked"/>
            </Border>

            <Border x:Name="CommunityEmojiDock"
                    Grid.Row="1"
                    Height="280"
                    Visibility="Collapsed"
                    Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                    BorderBrush="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                    BorderThickness="0,1,0,0">
                <controls:EmojiPickerPanel x:Name="CommunityEmojiPanel"
                                           GlyphPicked="CommunityEmojiPanel_GlyphPicked"/>
            </Border>
        </Grid>

        <!-- Replaces create header + both group pivots + Legacy command bar. -->
        <Grid x:Name="GroupPermissionsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Grid.Column="0"
              Canvas.ZIndex="10"
              Visibility="{Binding IsGroupPermissionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{ThemeResource ChatListBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Padding="4,8,16,8"
                  BorderBrush="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="4,0,8,0"
                        Command="{Binding CloseGroupPermissionsCommand}">
                    <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                </Button>
                <TextBlock Grid.Column="1"
                           x:Uid="CreateGroup_PermissionsOverlayTitle"
                           Text="Group permissions"
                           FontSize="20"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </Grid>
        </Grid>

        <!-- Same empty layout as CallsEmpty / chat empty: 1px divider + centered icon + title + body. -->
        <Border x:Name="CreateExplainPane"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                Visibility="{Binding ShowCreateExplainPane, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{ThemeResource ChatListBackgroundBrush}"
                BorderBrush="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <controls:CreateChannelExplainOverlay
                    Visibility="{Binding IsCreateChannel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Margin="32,24"
                            Visibility="{Binding IsCreateChannel, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <FontIcon Glyph="{Binding CreateExplainGlyph}"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="100"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,20"
                              Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                    <TextBlock Text="{Binding CreateExplainTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               FontSize="28"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource MainFontSemibold}"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <TextBlock Text="{Binding CreateExplainBody}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Margin="0,12,0,0"
                               FontSize="14"
                               LineHeight="22"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Legacy CommandBar: left form column only. Icon via Content — LegacyAppBarButtonStyle ignores Icon. -->
        <Grid Grid.Row="2"
              Grid.Column="0"
              MinHeight="{StaticResource LegacyCommandBarCompactHeight}"
              VerticalAlignment="Bottom"
              Background="{ThemeResource LegacyCommandBarBackgroundBrush}"
              Visibility="{Binding ShowCreateActionChrome, Converter={StaticResource BooleanToVisibilityConverter}}">
            <CommandBar x:Name="CreateLegacyCommandBar"
                        Style="{StaticResource LegacyCommandBarStyle}"
                        DefaultLabelPosition="Bottom"
                        VerticalAlignment="Bottom"
                        Loaded="CreateLegacyCommandBar_Loaded">
                <!-- ElementName: CommandBar primary items often do not inherit DataContext. -->
                <AppBarButton x:Name="CreateLegacyPrimaryButton"
                              Style="{StaticResource LegacyAppBarButtonStyle}"
                              Label="{Binding ViewModel.PrimaryActionLabel, ElementName=Root}"
                              Command="{Binding ViewModel.CreateNextCommand, ElementName=Root}">
                    <Grid>
                        <!-- Theme asset (white, tinted by Foreground) for Next; glyph for Confirm. -->
                        <BitmapIcon UriSource="ms-appx:///Assets/WhatsAppLegacy/Icons/appbar-next.png"
                                    Width="26" Height="26"
                                    Foreground="{ThemeResource LegacyCommandBarForegroundBrush}"
                                    Visibility="{Binding ViewModel.IsPrimaryActionNext, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ViewModel.PrimaryActionGlyph, ElementName=Root}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="{StaticResource LegacyAppBarGlyphSize}"
                                   TextLineBounds="Tight"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ViewModel.IsPrimaryActionNext, ElementName=Root, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                    </Grid>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Full-height grip (form + command bar). Chrome only on hover / drag. -->
        <Border x:Name="CreateSplitter"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.ColumnSpan="2"
                Width="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Visibility="Collapsed"
                ManipulationMode="None"
                Canvas.ZIndex="2">
            <Border x:Name="CreateSplitterChrome"
                    Background="{ThemeResource ChatPaneSplitterBackgroundBrush}"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                    <Ellipse Width="3" Height="3" Margin="0,2"
                             Fill="{ThemeResource ChatPaneSplitterGripBrush}"/>
                </StackPanel>
            </Border>
        </Border>

        </Grid>

        <!-- Replaces CreateContentHost: centered ProgressRing on the same page background. -->
        <Grid x:Name="CreateBusyOverlay"
              Canvas.ZIndex="20"
              Background="{ThemeResource ChatListBackgroundBrush}"
              IsHitTestVisible="True"
              Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:ModernProgressRing Width="48"
                                         Height="48"
                                         IsActive="{Binding IsCreating}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
