<Page
    x:Class="Unison.Uwp.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- AppShell: SplitView chrome + content Frame (Chats / Settings / Debug). -->
    <Grid x:Name="RootLayoutGrid">
        <VisualStateManager.VisualStateGroups>
            <!-- LayoutStates (app-wide): Minimal | Extended | ExtendedWide -->
            <VisualStateGroup x:Name="LayoutStates"
                              CurrentStateChanged="LayoutStates_CurrentStateChanged">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Overlay"/>
                        <!-- Align with UnisonPrivate-main NarrowState — Overlay + closed pane + InApp acrylic
                             avoids SplitView cast crash on W10M Creators during MainView Navigate. -->
                        <Setter Target="RootSplitView.IsPaneOpen" Value="False"/>
                        <Setter Target="RootSplitView.PaneBackground" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
                        <Setter Target="SidebarPaneRoot.Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Inline"/>
                        <!-- Do not force IsPaneOpen — resize closes Inline pane; user opens via hamburger. -->
                        <Setter Target="RootSplitView.PaneBackground" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                        <Setter Target="SidebarPaneRoot.Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ExtendedWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Inline"/>
                        <Setter Target="RootSplitView.PaneBackground" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                        <Setter Target="SidebarPaneRoot.Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <SplitView x:Name="RootSplitView"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="260"
                   PaneBackground="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid x:Name="SidebarPaneRoot"
                      Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,8,8,4" VerticalAlignment="Center">
                        <Button x:Name="HamburgerButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                Width="40" Height="40"
                                Click="HamburgerButton_Click">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                        </Button>
                        <Image Source="ms-appx:///Assets/WhatsAppLogo.png"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                        <TextBlock Text="WhatsApp"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontSize="13"
                                   Foreground="{ThemeResource WhatsAppTextHighBrush}"
                                   FontFamily="{StaticResource MainFontSemibold}"/>
                    </StackPanel>

                    <ListView x:Name="NavListView"
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="NavListView_SelectionChanged"
                              Margin="0,8"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource WhatsAppSidebarItemStyle}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="chats" IsSelected="True">
                            <Grid Padding="12,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock x:Uid="Shell_Chats" Text="Chats" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListViewItem>

                        <ListViewItem Tag="calls" IsEnabled="False" Foreground="{ThemeResource WhatsAppTextLowBrush}">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                                <TextBlock x:Uid="Shell_Calls" Text="Calls" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="status">
                            <Grid Padding="12,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock x:Uid="Shell_Status" Text="Status" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListViewItem>

                        <ListViewItem Tag="starred" IsEnabled="False" Foreground="{ThemeResource WhatsAppTextLowBrush}">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                                <TextBlock x:Uid="Shell_Starred" Text="Starred messages" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="archived" IsEnabled="False" Foreground="{ThemeResource WhatsAppTextLowBrush}">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                                <TextBlock x:Uid="Shell_Archived" Text="Archived chats" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{ThemeResource WhatsAppTextLowBrush}"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <ListView x:Name="BottomNavListView"
                                  SelectionMode="Single"
                                  SelectionChanged="NavListView_SelectionChanged"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource WhatsAppSidebarItemStyle}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListViewItem Tag="settings">
                                <StackPanel Orientation="Horizontal" Padding="12,0">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock x:Uid="Shell_Settings" Text="Settings" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListViewItem>

                            <ListViewItem Tag="debug">
                                <StackPanel Orientation="Horizontal" Padding="12,0">
                                    <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock x:Uid="Shell_Debug" Text="Debug" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListViewItem>
                        </ListView>

                        <Grid x:Name="ProfileNavRow" Padding="8,8,12,8" Margin="4,2" Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                <Ellipse Fill="#2A2A2A"
                                         Stroke="{ThemeResource WhatsAppGreenFocusBrush}"
                                         StrokeThickness="1.5"/>
                                <FontIcon Glyph="&#xE77B;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="14"
                                          Foreground="#808080"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding CurrentUserAvatar, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=64}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProfileDisplayName}"
                                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                                       Margin="12,0,0,0"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Frame x:Name="ShellContentFrame"
                       Background="{ThemeResource WhatsAppBackgroundBrush}"/>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
