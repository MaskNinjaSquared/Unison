<ResourceDictionary
    x:Class="Unison.Uwp.UI.Templates.MessageTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Unison.Core.ViewModels"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    xmlns:selectors="using:Unison.Uwp.UI.TemplateSelectors">

    <DataTemplate x:Key="MessageSentTemplate" x:DataType="vm:ChatMessageViewModel">
        <Grid HorizontalAlignment="Right" Margin="48,0,12,0" RightTapped="MessageBubble_RightTapped" Holding="MessageBubble_Holding">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Gap by run: 5 when sender changes, 2 for same-person sequence -->
            <Border Grid.Row="0" Height="5" Background="Transparent"
                    Visibility="{x:Bind IsRunStart, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Grid.Row="0" Height="2" Background="Transparent"
                    Visibility="{x:Bind IsRunStart, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

            <Grid Grid.Row="1" HorizontalAlignment="Right">
                <controls:MessageBubbleChrome
                    IsFromMe="True"
                    IsRunStart="{x:Bind ShowTail, Mode=OneWay}"/>

                <Border Background="Transparent" Margin="0,1,0,0" Padding="12,8,16,8">
                    <StackPanel>
                        <Button Click="ImageOpenButton_Click"
                                Style="{StaticResource TransparentMediaButtonStyle}"
                                Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6"
                                Padding="0">
                            <Image Source="{x:Bind ImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=320}"
                                   MaxWidth="300"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"/>
                        </Button>
                        <Grid Width="300" Height="300" Margin="0,0,0,6"
                              Visibility="{x:Bind NeedsImageDownload, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{StaticResource WhatsAppItemSelectedBrush}" CornerRadius="4"/>
                            <ProgressRing Width="36" Height="36"
                                          IsActive="{x:Bind IsImageDownloading, Mode=OneWay}"
                                          Visibility="{x:Bind IsImageDownloading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Click="ImageDownloadButton_Click"
                                    Style="{StaticResource TransparentMediaButtonStyle}"
                                    IsEnabled="{x:Bind CanDownloadImage, Mode=OneWay}"
                                    Visibility="{x:Bind ShowImageDownloadIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="36"
                                           Foreground="{StaticResource ChatDetailSentTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <RichTextBlock helpers:CommentRichService.Text="{x:Bind Caption, Mode=OneWay}"
                                       Visibility="{x:Bind HasCaption, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{StaticResource ChatDetailSentTextBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       LineHeight="20"
                                       Margin="0,0,0,2"/>
                        <Button Click="AudioButton_Click"
                                Visibility="{x:Bind IsAudio, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource ChatDetailSentTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Bind AudioButtonText, Mode=OneWay}" Foreground="{StaticResource ChatDetailSentTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <RichTextBlock helpers:CommentRichService.Text="{x:Bind Content, Mode=OneWay}"
                                       Visibility="{x:Bind ShowTextContent, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{StaticResource ChatDetailSentTextBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="{x:Bind ContentMaxLines, Mode=OneWay}"
                                       FontSize="15"
                                       LineHeight="20"/>
                        <HyperlinkButton Content="{x:Bind ExpandLinkText, Mode=OneWay}"
                                         Command="{x:Bind ToggleExpandCommand, Mode=OneWay}"
                                         Visibility="{x:Bind CanExpand, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Style="{StaticResource ChatDetailReadMoreHyperlinkButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource ChatDetailSentMetaBrush}" FontSize="10" Margin="0,0,4,0"
                                       Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind FormattedTime}" Foreground="{StaticResource ChatDetailSentMetaBrush}" FontSize="11" FontFamily="{StaticResource MainFont}"/>
                            <Image Source="{x:Bind StatusCheckmarkUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=32}"
                                   Visibility="{x:Bind HasStatusCheckmark, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Width="16"
                                   Height="12"
                                   Stretch="Uniform"
                                   Margin="4,1,0,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="!" Foreground="{StaticResource ChatDetailSendFailedBrush}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"
                                       Visibility="{x:Bind IsSendFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    Margin="0,-4,4,0"
                    Style="{StaticResource ChatDetailReactionChipButtonStyle}"
                    Background="{StaticResource ChatDetailReactionChipSentBrush}"
                    BorderBrush="{StaticResource ChatDetailReactionChipSentBorderBrush}"
                    Visibility="{x:Bind HasReactions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{x:Bind ShowReactionsCommand, Mode=OneWay}"
                    Content="{x:Bind ReactionsDisplayText, Mode=OneWay}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MessageReceivedTemplate" x:DataType="vm:ChatMessageViewModel">
        <Grid HorizontalAlignment="Left" Margin="12,0,48,0" RightTapped="MessageBubble_RightTapped" Holding="MessageBubble_Holding">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Gap by run: 5 when sender changes, 2 for same-person sequence -->
            <Border Grid.Row="0" Height="5" Background="Transparent"
                    Visibility="{x:Bind IsRunStart, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Grid.Row="0" Height="2" Background="Transparent"
                    Visibility="{x:Bind IsRunStart, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

            <Grid Grid.Row="1" HorizontalAlignment="Left">
                <controls:MessageBubbleChrome
                    IsFromMe="False"
                    IsRunStart="{x:Bind ShowTail, Mode=OneWay}"/>

                <Border Background="Transparent" Margin="0,1,0,0" Padding="16,8,12,8">
                    <StackPanel>
                        <TextBlock Text="{x:Bind SenderName, Mode=OneWay}"
                                   Visibility="{x:Bind ShowGroupSenderName, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource ChatDetailGroupSenderBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource MainFont}"
                                   Margin="0,0,0,4"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Click="ImageOpenButton_Click"
                                Style="{StaticResource TransparentMediaButtonStyle}"
                                Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6"
                                Padding="0">
                            <Image Source="{x:Bind ImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=320}"
                                   MaxWidth="300"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"/>
                        </Button>
                        <Grid Width="300" Height="300" Margin="0,0,0,6"
                              Visibility="{x:Bind NeedsImageDownload, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{StaticResource WhatsAppItemSelectedBrush}" CornerRadius="4"/>
                            <ProgressRing Width="36" Height="36"
                                          IsActive="{x:Bind IsImageDownloading, Mode=OneWay}"
                                          Visibility="{x:Bind IsImageDownloading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Click="ImageDownloadButton_Click"
                                    Style="{StaticResource TransparentMediaButtonStyle}"
                                    IsEnabled="{x:Bind CanDownloadImage, Mode=OneWay}"
                                    Visibility="{x:Bind ShowImageDownloadIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="36"
                                           Foreground="{StaticResource ChatDetailReceivedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <RichTextBlock helpers:CommentRichService.Text="{x:Bind Caption, Mode=OneWay}"
                                       Visibility="{x:Bind HasCaption, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{StaticResource ChatDetailReceivedTextBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       LineHeight="20"
                                       FontFamily="{StaticResource MainFont}"
                                       Margin="0,0,0,2"/>
                        <Button Click="AudioButton_Click"
                                Visibility="{x:Bind IsAudio, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource ChatDetailReceivedTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Bind AudioButtonText, Mode=OneWay}" Foreground="{StaticResource ChatDetailReceivedTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <RichTextBlock helpers:CommentRichService.Text="{x:Bind Content, Mode=OneWay}"
                                       Visibility="{x:Bind ShowTextContent, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{StaticResource ChatDetailReceivedTextBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="{x:Bind ContentMaxLines, Mode=OneWay}"
                                       FontSize="15"
                                       LineHeight="20"
                                       FontFamily="{StaticResource MainFont}"/>
                        <HyperlinkButton Content="{x:Bind ExpandLinkText, Mode=OneWay}"
                                         Command="{x:Bind ToggleExpandCommand, Mode=OneWay}"
                                         Visibility="{x:Bind CanExpand, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Style="{StaticResource ChatDetailReadMoreHyperlinkButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource ChatDetailReceivedMetaBrush}" FontSize="10" Margin="0,0,4,0"
                                       Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind FormattedTime}" Foreground="{StaticResource ChatDetailReceivedMetaBrush}" FontSize="11" FontFamily="{StaticResource MainFont}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    HorizontalAlignment="Left"
                    Margin="0,-4,4,0"
                    Style="{StaticResource ChatDetailReactionChipButtonStyle}"
                    Background="{StaticResource ChatDetailReactionChipReceivedBrush}"
                    BorderBrush="{StaticResource ChatDetailReactionChipReceivedBorderBrush}"
                    Visibility="{x:Bind HasReactions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{x:Bind ShowReactionsCommand, Mode=OneWay}"
                    Content="{x:Bind ReactionsDisplayText, Mode=OneWay}"/>
        </Grid>
    </DataTemplate>

    <selectors:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                       SentTemplate="{StaticResource MessageSentTemplate}"
                                       ReceivedTemplate="{StaticResource MessageReceivedTemplate}"/>
</ResourceDictionary>
