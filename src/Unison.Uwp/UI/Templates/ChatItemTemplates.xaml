<ResourceDictionary
    x:Class="Unison.Uwp.UI.Templates.ChatItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Unison.Uwp.UI.Views"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    xmlns:models="using:Unison.Core.Models"
    xmlns:controls="using:Unison.Uwp.UI.Controls">

    <DataTemplate x:Key="ChatItemTemplate" x:DataType="models:ChatItem">
        <!-- ContextFlyout (Imgur): right-click + long-press on Mobile without FlyoutBase.ShowAt(element) [1809+]. -->
        <Grid Height="76" Padding="12,0" Background="Transparent">
            <Grid.ContextFlyout>
                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}"
                            Opening="ChatContextFlyout_Opening">
                    <MenuFlyoutItem Tag="chatPin"
                                   x:Uid="ChatList_PinChat"
                                   Text="Pin chat"
                                   Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                   Click="PinChat_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE840;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Tag="widgetPin"
                                   x:Uid="ChatDetail_PinToStart"
                                   Text="Pin to Start"
                                   Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                   Click="PinToStart_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE718;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem Tag="localMuteSub"
                                      x:Uid="ChatDetail_MuteNotifications"
                                      Text="Mute notifications"
                                      Style="{StaticResource ModernMenuFlyoutSubItemStyle}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Tag="mute8h"
                                       x:Uid="ChatDetail_MuteFor8Hours"
                                       Text="8 hours"
                                       Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                       Click="MuteDuration_Click"/>
                        <MenuFlyoutItem Tag="mute1w"
                                       x:Uid="ChatDetail_MuteFor1Week"
                                       Text="1 week"
                                       Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                       Click="MuteDuration_Click"/>
                        <MenuFlyoutItem Tag="muteForever"
                                       x:Uid="ChatDetail_MuteForever"
                                       Text="Always"
                                       Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                       Click="MuteDuration_Click"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Tag="unmute"
                                   x:Uid="ChatDetail_UnmuteNotifications"
                                   Text="Unmute notifications"
                                   Style="{StaticResource ModernMenuFlyoutItemStyle}"
                                   Visibility="Collapsed"
                                   Click="Unmute_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:ChatAvatarControl Width="48" Height="48"
                                        Size="48"
                                        ShowBorder="True"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        AvatarUrl="{x:Bind GetAvatarUrl(AvatarUrl, AvatarHighUrl), Mode=OneWay}"
                                        IsGroup="{x:Bind IsGroup, Mode=OneWay}"/>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{x:Bind templates:ChatItemTemplates.GetChatDisplayName(Name, Kind), Mode=OneWay}"
                           FontSize="18"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <controls:ChatListPreviewStrip Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Kind="{x:Bind LastMessageKind, Mode=OneWay}"
                                               Author="{x:Bind LastMessageAuthor, Mode=OneWay}"
                                               Text="{x:Bind LastMessage, Mode=OneWay}"
                                               MentionedJids="{x:Bind LastMessageMentionedJids, Mode=OneWay}"/>
            </Grid>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,0,0">
                <TextBlock Text="{x:Bind LastMessageTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                           FontSize="12"
                           Opacity="0.85"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource MainFont}"
                           Visibility="{x:Bind HasUnread, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                <TextBlock Text="{x:Bind LastMessageTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                           FontSize="12"
                           Foreground="{ThemeResource ChatListUnreadBadgeBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource MainFontSemibold}"
                           Visibility="{x:Bind HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,1,0">
                    <!-- Start live tile (widget) | mute | WhatsApp list pin -->
                    <FontIcon Glyph="&#xECA5;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="14"
                              Margin="0,0,6,0"
                              Opacity="0.85"
                              Visibility="{x:Bind IsWidgetPinned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xE74F;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="14"
                              Margin="0,0,6,0"
                              Opacity="0.85"
                              Visibility="{x:Bind IsMutedLocally, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xE718;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="14"
                              Opacity="0.85"
                              Visibility="{x:Bind IsChatPinned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Border Background="{ThemeResource ChatListUnreadBadgeBrush}"
                        CornerRadius="10"
                        MinWidth="20"
                        Height="20"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Visibility="{x:Bind HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}"
                               Foreground="{ThemeResource ChatListUnreadBadgeForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="6,0,6,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MainFont}"/>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
