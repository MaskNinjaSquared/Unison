<UserControl
    x:Class="Unison.Uwp.UI.Controls.EmptyStateBrandLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="72"
    d:DesignWidth="72"
    Width="72"
    Height="72"
    HorizontalAlignment="Center"
    Margin="0,0,0,20">

    <!-- Transparent (unplated) Start-tile glyph — bounce on Low+ only (code-behind). -->
    <Grid>
        <Image x:Name="LogoImage"
               Source="ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-256.png"
               Width="72"
               Height="72"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,1">
            <Image.RenderTransform>
                <TranslateTransform x:Name="LogoTranslate" Y="0"/>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
