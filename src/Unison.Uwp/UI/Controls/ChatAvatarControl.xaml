<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatAvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="48"
    d:DesignWidth="48"
    IsTabStop="False">

    <!-- Fallback circle + contact/group glyph under optional photo overlay. -->
    <Grid x:Name="RootGrid" Width="48" Height="48">
        <Ellipse x:Name="FallbackEllipse"
                 Width="48" Height="48"
                 Fill="{ThemeResource AvatarFallbackBackgroundBrush}"/>

        <FontIcon x:Name="ContactFallbackIcon"
                  Glyph="&#xEA8C;"
                  FontFamily="{StaticResource IconFont}"
                  FontSize="20"
                  Foreground="{ThemeResource AvatarFallbackIconBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>

        <Viewbox x:Name="GroupFallbackHost"
                 Width="24" Height="24"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed">
            <Canvas Width="20" Height="19">
                <Path Fill="{ThemeResource AvatarFallbackIconBrush}"
                      Data="M1.50,11.00L11.50,11.00C12.27,11.00,12.92,11.59,12.99,12.36L13.00,12.50 13.00,14.50C13.00,18.00 9.28,19.00 6.50,19.00 3.78,19.00 0.16,18.04 0.00,14.73L0.00,14.50 0.00,12.50C0.00,11.73 0.59,11.08 1.36,11.01z M13.49,11.00L18.50,11.00C19.27,11.00 19.92,11.59 19.99,12.35L20.00,12.50 20.00,14.00C20.00,17.06 17.14,18.00 15.00,18.00 14.27,18.00 13.55,17.89 12.86,17.68 13.51,16.93 13.94,15.97 13.99,14.78L14.00,14.50 14.00,12.50C14.00,12.01 13.85,11.55 13.60,11.16L13.49,11.00 18.50,11.00z M6.50,0.00C8.99,0.00 11.00,2.01 11.00,4.50 11.00,6.99 8.99,9.00 6.50,9.00 4.01,9.00 2.00,6.99 2.00,4.50 2.00,2.01 4.01,0.00 6.50,0.00z M15.50,2.00C17.43,2.00 19.00,3.57 19.00,5.50 19.00,7.43 17.43,9.00 15.50,9.00 13.57,9.00 12.00,7.43 12.00,5.50 12.00,3.57 13.57,2.00 15.50,2.00z"/>
            </Canvas>
        </Viewbox>

        <Ellipse x:Name="PhotoEllipse"
                 Width="48" Height="48"
                 Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="PhotoBrush"
                            Stretch="UniformToFill"
                            ImageFailed="PhotoBrush_ImageFailed"/>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 1px ring when ShowBorder=true: light gray in Light, transparent in Dark. -->
        <Ellipse x:Name="BorderEllipse"
                 Width="48" Height="48"
                 Fill="Transparent"
                 Stroke="{ThemeResource AvatarBorderBrush}"
                 StrokeThickness="0.5"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"/>
    </Grid>
</UserControl>
