<UserControl
    x:Class="Unison.Uwp.UI.Controls.ContactsVisualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    Background="{ThemeResource ChatListBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ChatItemTemplates/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Reusable overlay picker: Title + ItemsSource + ItemClickCommand (+ optional BackCommand).
      Host toggles Visibility / IsOpen; the command instance lives on the ViewModel so add/remove
      runs through the same IChatService path as the context menu (no NavigationService hop).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,8,16,8" Background="{ThemeResource ChatListBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="20"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </Grid>

        <ListView x:Name="ItemsList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="ItemsList_ItemClick"
                  SelectionMode="None"
                  ItemTemplate="{StaticResource ChatItemTemplate}"
                  Background="Transparent"/>
    </Grid>
</UserControl>
