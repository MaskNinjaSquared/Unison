<UserControl
    x:Class="Unison.Uwp.UI.Controls.ContactsVisualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    Background="{ThemeResource ChatListBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ChatItemTemplates/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Lightweight picker row: avatar + name only (Mobile open must stay cheap). -->
            <DataTemplate x:Key="ContactsPickerCompactTemplate">
                <Grid Padding="12,10" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:ChatAvatarControl Width="40" Height="40"
                                                Size="40"
                                                ShowBorder="True"
                                                VerticalAlignment="Center"
                                                AvatarUrl="{Binding AvatarUrl}"
                                                IsGroup="{Binding IsGroup}"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding Name}"
                               FontSize="17"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Reusable overlay picker: Title + ItemsSource + ItemClickCommand (+ optional BackCommand).
      Host toggles IsOpen; shell theme strategy decides compact rows / deferred bind / fade.
    -->
    <Grid Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,8,16,8" Background="{ThemeResource ChatListBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="20"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </Grid>

        <ListView x:Name="ItemsList"
                  Grid.Row="1"
                  IsItemClickEnabled="True"
                  ItemClick="ItemsList_ItemClick"
                  SelectionMode="None"
                  ItemTemplate="{StaticResource ContactsPickerCompactTemplate}"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
