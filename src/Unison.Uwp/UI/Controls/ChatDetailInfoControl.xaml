<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatDetailInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ChatDetailInfoBackgroundBrush" Color="#01B051"/>
        <SolidColorBrush x:Key="ChatDetailInfoCommandBarBrush" Color="#019944"/>
        <SolidColorBrush x:Key="ChatDetailInfoCloseHoverBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ChatDetailInfoClosePressedBrush" Color="#55FFFFFF"/>

        <Style x:Key="ChatDetailInfoCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoCloseHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoClosePressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4"
                                                             Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatDetailInfoAppBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoCloseHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ChatDetailInfoClosePressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.45"
                                                             Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ChatDetailInfoBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid x:Name="InfoBodyHost"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <controls:ChatDetailUserInfoControl x:Name="UserInfoPanel"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="Collapsed"/>
            <controls:ChatDetailGroupInfoControl x:Name="GroupInfoPanel"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Visibility="Collapsed"/>

            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,8,0"
                    Canvas.ZIndex="1"
                    Style="{StaticResource ChatDetailInfoCloseButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Height="64"
              Background="{StaticResource ChatDetailInfoCommandBarBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Margin="0">
                <Button x:Name="ChatPinButton"
                        Style="{StaticResource ChatDetailInfoAppBarButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Click="ChatPinButton_Click"
                        ToolTipService.ToolTip="Pin chat">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE840;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="18"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChatPinButtonLabel"
                                   Text="Pin&#x0a;chat"
                                   FontSize="10"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="White"
                                   Margin="0,2,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextLineBounds="Tight"
                                   MaxWidth="68"
                                   MaxLines="2"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PinButton"
                        Style="{StaticResource ChatDetailInfoAppBarButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Click="PinButton_Click"
                        ToolTipService.ToolTip="Pin to Start">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE718;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="18"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PinButtonLabel"
                                   Text="Pin to&#x0a;Start"
                                   FontSize="10"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="White"
                                   Margin="0,2,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextLineBounds="Tight"
                                   MaxWidth="68"
                                   MaxLines="2"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
