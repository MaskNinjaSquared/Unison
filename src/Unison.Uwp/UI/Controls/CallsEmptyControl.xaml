<UserControl
    x:Class="Unison.Uwp.UI.Controls.CallsEmptyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400">

    <!-- Same empty layout as StatusDetail / chat empty: centered icon + title + body. -->
    <Grid Background="Transparent">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Margin="32,24">
            <!-- EB18 newcall phone (WhatsAppLegacyIcons) — same silhouette as Legacy New Call. -->
            <FontIcon Glyph="&#xEB18;"
                      FontFamily="{StaticResource LegacyIconFont}"
                      FontSize="100"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>

            <TextBlock x:Uid="Calls_EmptyTitle"
                       Text="Voice and video calls"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       FontSize="28"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource MainFontSemibold}"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

            <TextBlock x:Uid="Calls_EmptyBody"
                       Text="Share your screen, react with emojis and much more with up to 32 people…"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       Margin="0,12,0,0"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                       FontFamily="{StaticResource MainFont}"/>
        </StackPanel>
    </Grid>
</UserControl>
