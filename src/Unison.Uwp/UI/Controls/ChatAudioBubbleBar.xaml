<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatAudioBubbleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    MinWidth="0"
    MinHeight="36"
    HorizontalAlignment="Stretch">

    <!-- WhatsApp shell: transparent icon play/pause — Ready label ↔ slider — timestamp -->
    <Grid MinWidth="0" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Center" Margin="0,0,6,0">
            <Button x:Name="PlayButton"
                    Click="PlayPause_Click"
                    Style="{StaticResource WhatsAppIconButtonStyle}"
                    Padding="0"
                    MinWidth="36" MinHeight="36"
                    Visibility="Collapsed">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{Binding GlyphForeground, ElementName=Root}"/>
            </Button>
            <Button x:Name="PauseButton"
                    Click="PlayPause_Click"
                    Style="{StaticResource WhatsAppIconButtonStyle}"
                    Padding="0"
                    MinWidth="36" MinHeight="36"
                    Visibility="Collapsed">
                <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{Binding GlyphForeground, ElementName=Root}"/>
            </Button>
        </Grid>

        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" MinHeight="28" MinWidth="0">
            <TextBlock x:Name="ReadyLabel"
                       Text="Voice message"
                       FontSize="14"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Foreground="{Binding GlyphForeground, ElementName=Root}"
                       Opacity="1"/>
            <Slider x:Name="PositionSlider"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    VerticalAlignment="Center"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource WhatsAppGreenFocusBrush}"
                    PointerPressed="PositionSlider_PointerPressed"
                    PointerReleased="PositionSlider_PointerReleased"
                    PointerCaptureLost="PositionSlider_PointerCaptureLost"
                    ValueChanged="PositionSlider_ValueChanged"/>
        </Grid>

        <TextBlock x:Name="TimestampText"
                   Grid.Column="2"
                   Text="0:00"
                   FontSize="12"
                   FontFamily="{StaticResource MainFont}"
                   VerticalAlignment="Center"
                   MaxWidth="48"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"
                   TextAlignment="Right"
                   Foreground="{Binding GlyphForeground, ElementName=Root}"/>
    </Grid>
</UserControl>
