<UserControl
    x:Class="Unison.Uwp.UI.Controls.SettingBox"
    x:Name="SettingBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:selectors="using:Unison.Uwp.UI.TemplateSelectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="80"
    d:DesignWidth="400"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <!-- No description: glyph + title + toggle on one row. -->
        <DataTemplate x:Key="SettingBoxCompactTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Margin="12,12,0,12"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="18"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource WhatsAppTextHighBrush}"
                          Glyph="{Binding Glyph, ElementName=SettingBoxControl}"
                          Visibility="{Binding Glyph, ElementName=SettingBoxControl, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Margin="12,12,8,12"
                           FontSize="14"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           Text="{Binding Header, ElementName=SettingBoxControl}"/>
                <ContentPresenter Grid.Column="2"
                                  Margin="10,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="{Binding Control, ElementName=SettingBoxControl}"/>
            </Grid>
        </DataTemplate>

        <!-- With description: glyph + title on top; subtitle below; control spans rows. -->
        <DataTemplate x:Key="SettingBoxWithDescriptionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0"
                          Margin="12,12,0,0"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="18"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource WhatsAppTextHighBrush}"
                          Glyph="{Binding Glyph, ElementName=SettingBoxControl}"
                          Visibility="{Binding Glyph, ElementName=SettingBoxControl, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1"
                           Margin="12,12,8,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           Text="{Binding Header, ElementName=SettingBoxControl}"/>
                <TextBlock Margin="12,4,8,12"
                           Grid.Row="1"
                           Grid.Column="1"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           Opacity="0.9"
                           Text="{Binding Text, ElementName=SettingBoxControl}"/>
                <ContentPresenter Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="2"
                                  Margin="10,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="{Binding Control, ElementName=SettingBoxControl}"/>
            </Grid>
        </DataTemplate>

        <selectors:SettingBoxLayoutTemplateSelector x:Key="SettingBoxLayoutSelector"
                                                    CompactTemplate="{StaticResource SettingBoxCompactTemplate}"
                                                    WithDescriptionTemplate="{StaticResource SettingBoxWithDescriptionTemplate}"/>
    </UserControl.Resources>

    <Border Background="{ThemeResource SettingBoxBackgroundBrush}"
            BorderBrush="{ThemeResource SettingBoxBorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
        <ContentControl HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{x:Bind HasDescription, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource SettingBoxLayoutSelector}"/>
    </Border>
</UserControl>
