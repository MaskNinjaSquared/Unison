<UserControl
    x:Class="Unison.Uwp.UI.Controls.StatusListAvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:selectors="using:Unison.Uwp.UI.TemplateSelectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="56"
    d:DesignWidth="56"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="StatusListTextFaceTemplate" x:DataType="controls:StatusListAvatarFace">
            <controls:StatusTextListAvatarControl
                Width="{x:Bind Size}"
                Height="{x:Bind Size}"
                Size="{x:Bind Size}"
                BackgroundArgb="{x:Bind BackgroundArgb}"
                TextArgb="{x:Bind TextArgb}"
                Text="{x:Bind PreviewText}"/>
        </DataTemplate>
        <DataTemplate x:Key="StatusListPhotoFaceTemplate" x:DataType="controls:StatusListAvatarFace">
            <controls:ChatAvatarControl
                Width="{x:Bind Size}"
                Height="{x:Bind Size}"
                Size="{x:Bind Size}"
                ShowBorder="False"
                AvatarUrl="{x:Bind AvatarUrl}"/>
        </DataTemplate>
        <selectors:StatusListAvatarKindTemplateSelector
            x:Key="StatusListAvatarKindSelector"
            TextTemplate="{StaticResource StatusListTextFaceTemplate}"
            PhotoTemplate="{StaticResource StatusListPhotoFaceTemplate}"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Width="56" Height="56">
        <Ellipse x:Name="Ring"
                 Width="56"
                 Height="56"
                 StrokeThickness="2.5"
                 Fill="Transparent"
                 Stroke="#FF25D366"/>
        <ContentControl x:Name="FaceHost"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        ContentTemplateSelector="{StaticResource StatusListAvatarKindSelector}"/>
    </Grid>
</UserControl>
