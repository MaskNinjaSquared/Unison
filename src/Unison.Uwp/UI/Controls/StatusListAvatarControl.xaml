<UserControl
    x:Class="Unison.Uwp.UI.Controls.StatusListAvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="56"
    d:DesignWidth="56"
    IsTabStop="False">

    <!-- Status list ring: green = Recent (unviewed), gray = Viewed. Inner plate keeps profile placeholder. -->
    <Grid x:Name="RootGrid" Width="56" Height="56">
        <Ellipse x:Name="Ring"
                 Width="56"
                 Height="56"
                 StrokeThickness="2.5"
                 Fill="Transparent"
                 Stroke="#FF25D366"/>
        <controls:ChatAvatarControl x:Name="InnerAvatar"
                                    Width="48"
                                    Height="48"
                                    Size="48"
                                    ShowBorder="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
    </Grid>
</UserControl>
