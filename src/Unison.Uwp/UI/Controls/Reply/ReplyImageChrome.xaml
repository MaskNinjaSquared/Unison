<UserControl
    x:Class="Unison.Uwp.UI.Controls.Reply.ReplyImageChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48">
            <Image Source="{Binding PreviewImageUri, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" Stretch="UniformToFill"/>
        </Border>
        <TextBlock Grid.Column="1"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   helpers:EmojiTextBlock.Text="{Binding ReplyDockPreviewText}"
                   helpers:EmojiTextBlock.MentionedJids="{Binding MentionedJids}"
                   helpers:EmojiTextBlock.MentionLookup="{Binding MentionLookup}"
                   helpers:EmojiTextBlock.RefreshKey="{Binding MentionRefreshKey}"
                   Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                   MaxLines="2"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource MainFont}"
                   FontSize="13"/>
    </Grid>
</UserControl>
