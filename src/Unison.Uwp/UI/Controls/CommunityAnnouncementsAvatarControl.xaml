<UserControl
    x:Class="Unison.Uwp.UI.Controls.CommunityAnnouncementsAvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="48"
    d:DesignWidth="48"
    IsTabStop="False">

    <!-- Temporary Avisos plate: group photo on a blue disc (will be redesigned). -->
    <Grid x:Name="RootGrid" Width="48" Height="48">
        <Ellipse x:Name="FallbackPlate"
                 Width="48" Height="48"
                 Fill="#FF3390EC"/>

        <FontIcon x:Name="MegaphoneFallback"
                  Glyph="&#xE789;"
                  FontFamily="{StaticResource IconFont}"
                  FontSize="20"
                  Foreground="White"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>

        <Ellipse x:Name="PhotoEllipse"
                 Width="48" Height="48"
                 Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="PhotoBrush"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center"
                            ImageFailed="PhotoBrush_ImageFailed"/>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="BorderEllipse"
                 Width="48" Height="48"
                 Fill="Transparent"
                 Stroke="{ThemeResource AvatarBorderBrush}"
                 StrokeThickness="0.5"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"/>
    </Grid>
</UserControl>
