<UserControl
    x:Class="Unison.Uwp.UI.Controls.FavoritesEmptyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400">

    <!-- Desktop (≥720): message at the top-left. Mobile: centered in the pane. -->
    <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Narrow"/>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MessageText.HorizontalAlignment" Value="Left"/>
                        <Setter Target="MessageText.VerticalAlignment" Value="Top"/>
                        <Setter Target="MessageText.TextAlignment" Value="Left"/>
                        <Setter Target="MessageText.Margin" Value="24,24,48,24"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="MessageText"
                   x:Uid="Favorites_Empty"
                   Text="Favorites are shown in the Chats and Calls sections. Add as many people and groups as you want."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="WrapWholeWords"
                   Margin="24"
                   MaxWidth="420"
                   FontSize="15"
                   LineHeight="22"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                   FontFamily="{StaticResource MainFont}"/>
    </Grid>
</UserControl>
