<UserControl
    x:Class="Unison.Uwp.UI.Controls.FavoritesEmptyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="400">

    <Grid Background="Transparent">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Margin="24">
            <TextBlock x:Uid="Favorites_EmptyTitle"
                       Text="Add favorites"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"/>

            <TextBlock x:Uid="Favorites_Empty"
                       Text="Favorites are shown in the Chats and Calls tabs. Add as many people and groups as you want."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       Margin="0,12,0,0"
                       FontSize="15"
                       LineHeight="22"
                       Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                       FontFamily="{StaticResource MainFont}"/>

            <Button x:Name="AddButton"
                    x:Uid="Favorites_AddPeopleOrGroups"
                    Content="Add people or groups"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Padding="20,10"
                    Background="Transparent"
                    BorderBrush="{ThemeResource LoginAccentBrush}"
                    BorderThickness="1.5"
                    Foreground="{ThemeResource LoginAccentBrush}"
                    FontFamily="{StaticResource MainFontSemibold}"
                    Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
