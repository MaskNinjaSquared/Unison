<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatStickerBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    Height="300">

    <!--
        Complement under the composer. Pivot Emoji / GIF / Stickers; emoji body is EmojiPickerPanel.
    -->
    <Grid Background="{ThemeResource ChatDetailInputBarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                IsHitTestVisible="False"/>

        <Pivot Grid.Row="1"
               Margin="10,0,0,0"
               SelectedIndex="0"
               Background="Transparent">
            <Pivot.Resources>
                <Thickness x:Key="PivotItemMargin">0</Thickness>
                <Style TargetType="PivotHeaderItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="5,0,10,0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Style>
            </Pivot.Resources>
            <PivotItem>
                <PivotItem.Header>
                    <TextBlock x:Uid="StickerBox_EmojiTab"
                               Text="Emoji"
                               FontSize="13"
                               FontFamily="{StaticResource MainFont}"/>
                </PivotItem.Header>
                <controls:EmojiPickerPanel x:Name="EmojiPanel"
                                           CategoriesSource="{Binding EmojiCategories}"
                                           GlyphCommand="{Binding InsertEmojiCommand}"
                                           SearchQuery="{Binding EmojiSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsCatalogLoading="{Binding IsEmojiCatalogLoading}"
                                           GlyphPicked="EmojiPanel_GlyphPicked"/>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <TextBlock x:Uid="StickerBox_GifTab"
                               Text="GIF"
                               FontSize="13"
                               FontFamily="{StaticResource MainFont}"/>
                </PivotItem.Header>
                <TextBlock x:Uid="StickerBox_GifSoon"
                           Text="GIFs coming soon"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"/>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <TextBlock x:Uid="StickerBox_StickerTab"
                               Text="Stickers"
                               FontSize="13"
                               FontFamily="{StaticResource MainFont}"/>
                </PivotItem.Header>
                <TextBlock x:Uid="StickerBox_StickerSoon"
                           Text="Stickers coming soon"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"/>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
