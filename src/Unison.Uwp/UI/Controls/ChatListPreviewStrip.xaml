<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatListPreviewStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    d:DesignHeight="24"
    d:DesignWidth="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Templates/ChatPreviewKindTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Outgoing ticks | Author | chip | body — author preferred; remainder ellipsizes. -->
    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="StatusHost"
              Grid.Column="0"
              VerticalAlignment="Center"
              Margin="0,4,0,0"
              Visibility="Collapsed">
            <Image x:Name="StatusImage"
                   Width="16"
                   Height="12"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
            <TextBlock x:Name="FailedMark"
                       Text="!"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#E81123"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="AuthorBlock"
                   Grid.Column="1"
                   FontSize="16"
                   Margin="0,0,4,0"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource MainFont}"
                   Text="{x:Bind Author, Mode=OneWay}"
                   Visibility="{x:Bind Author, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

        <ContentControl x:Name="KindHost"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Foreground="{Binding Foreground, ElementName=Root}"
                        IsTabStop="False"
                        Content="{x:Bind Kind, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource ChatPreviewKindTemplateSelector}"/>

        <TextBlock x:Name="PreviewTextBlock"
                   Grid.Column="3"
                   FontSize="16"
                   Margin="5,0,0,0"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"
                   FontFamily="{StaticResource MainFont}"/>
    </Grid>
</UserControl>
