<UserControl
    x:Class="Unison.Uwp.UI.Controls.StatusTextListAvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="48"
    d:DesignWidth="48"
    IsTabStop="False">

    <!-- Colored Status text face: Viewbox scales the body into the circle. -->
    <Grid x:Name="RootGrid" Width="48" Height="48">
        <Ellipse x:Name="BackgroundPlate"
                 Width="48"
                 Height="48"
                 Fill="#FF128C7E"/>
        <Viewbox x:Name="TextHost"
                 Stretch="Uniform"
                 Margin="7"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <TextBlock x:Name="PreviewTextBlock"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="120"
                       FontSize="28"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       Foreground="White"
                       LineStackingStrategy="MaxHeight"
                       LineHeight="32"/>
        </Viewbox>
    </Grid>
</UserControl>
