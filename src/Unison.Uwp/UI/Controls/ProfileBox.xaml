<UserControl
    x:Class="Unison.Uwp.UI.Controls.ProfileBox"
    x:Name="ProfileBoxRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="72"
    d:DesignWidth="400"
    HorizontalAlignment="Stretch">

    <!-- Whole row is a button: icon | title / value. Parent sets x:Uid → {uid}.Title. -->
    <Button HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            MinWidth="0"
            MinHeight="0"
            BorderThickness="0"
            Background="Transparent"
            Click="RootButton_Click">
        <Border Background="{ThemeResource SettingBoxBackgroundBrush}"
                BorderBrush="{ThemeResource SettingBoxBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <FontIcon Grid.RowSpan="2"
                          Glyph="{Binding Glyph, ElementName=ProfileBoxRoot}"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource WhatsAppTextHighBrush}"/>

                <TextBlock Grid.Column="1"
                           Margin="0,12,12,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           Text="{Binding Title, ElementName=ProfileBoxRoot}"/>

                <TextBlock x:Name="ValueText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,2,12,12"
                           MinHeight="16"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           Opacity="0.9"/>
            </Grid>
        </Border>
    </Button>
</UserControl>
