<UserControl
    x:Class="Unison.Uwp.UI.Controls.RichLabeledTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    x:Name="Root">

    <!--
      Unison / WhatsApp: label inside the input chrome, emoji aligned with the text.
      ChatComposerInput stays transparent so focus/typing does not darken the fill.
    -->
    <Border Background="{ThemeResource ChatListSearchBackgroundBrush}"
            BorderBrush="{ThemeResource ChatListSearchBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10,8,10"
            MinHeight="{Binding ElementName=Root, Path=MinBoxHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText"
                       Text="{Binding ElementName=Root, Path=Header}"
                       FontSize="12"
                       FontFamily="{StaticResource MainFont}"
                       Foreground="{ThemeResource ChatListSearchPlaceholderBrush}"
                       Margin="0,0,0,4"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>

            <controls:ChatComposerInput x:Name="InputBox"
                                        Grid.Row="1"
                                        PlaceholderText="{Binding ElementName=Root, Path=PlaceholderText}"
                                        BoundText="{Binding ElementName=Root, Path=Text, Mode=TwoWay}"
                                        AcceptsReturn="{Binding ElementName=Root, Path=AcceptsReturn}"
                                        TextWrapping="{Binding ElementName=Root, Path=TextWrapping}"
                                        BorderThickness="0"
                                        Padding="0,2,4,2"
                                        MinHeight="28"
                                        MaxHeight="{Binding ElementName=Root, Path=MaxInputHeight}"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="{Binding ElementName=Root, Path=InputVerticalContentAlignment}"
                                        Background="Transparent"
                                        Foreground="{ThemeResource ChatListSearchForegroundBrush}"
                                        FontSize="15"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

            <Button Grid.Column="1"
                    Grid.Row="1"
                    Style="{StaticResource ModernIconButtonStyle}"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    Click="EmojiButton_Click"
                    AutomationProperties.Name="Emoji">
                <FontIcon Glyph="&#xE76E;"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="18"
                          Foreground="{ThemeResource ChatListSearchPlaceholderBrush}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
