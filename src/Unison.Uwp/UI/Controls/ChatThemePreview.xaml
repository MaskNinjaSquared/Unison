<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatThemePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:selectors="using:Unison.Uwp.UI.TemplateSelectors"
    HorizontalAlignment="Center"
    VerticalAlignment="Top">

    <UserControl.Resources>
        <!-- Phone portrait chrome -->
        <DataTemplate x:Key="ChatThemePreviewMobileTemplate">
            <Border x:Name="PreviewRoot"
                    Width="180"
                    Height="320"
                    CornerRadius="12"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    Background="Transparent">
                <Grid>
                    <controls:ChatBackgroundSurface
                        BackgroundKind="{Binding BackgroundKind, Mode=OneWay}"
                        CustomPath="{Binding CustomPath, Mode=OneWay}"
                        SolidColorHex="{Binding SolidColorHex, Mode=OneWay}"/>

                    <Border VerticalAlignment="Top"
                            Height="36"
                            Background="#E6075E54">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xE72B;"
                                      FontSize="14"
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Chat"
                                       FontSize="13"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,16">
                        <Border HorizontalAlignment="Left"
                                MaxWidth="120"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                CornerRadius="8"
                                Background="#FFFFFFFF">
                            <TextBlock Text="Hey"
                                       FontSize="12"
                                       Foreground="#FF111111"/>
                        </Border>
                        <Image HorizontalAlignment="Right"
                               Width="96"
                               Stretch="Uniform"
                               Source="ms-appx:///Assets/ChatTheme/OutgoingBubble.png"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- PC / wide chat pane chrome -->
        <DataTemplate x:Key="ChatThemePreviewDesktopTemplate">
            <Border x:Name="PreviewRoot"
                    Width="320"
                    Height="200"
                    CornerRadius="8"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    Background="Transparent">
                <Grid>
                    <controls:ChatBackgroundSurface
                        BackgroundKind="{Binding BackgroundKind, Mode=OneWay}"
                        CustomPath="{Binding CustomPath, Mode=OneWay}"
                        SolidColorHex="{Binding SolidColorHex, Mode=OneWay}"/>

                    <Border VerticalAlignment="Top"
                            Height="40"
                            Background="#E6075E54">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="22"
                                     Height="22"
                                     Fill="#66FFFFFF"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Chat"
                                       FontSize="14"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14">
                        <Border HorizontalAlignment="Left"
                                MaxWidth="160"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                CornerRadius="8"
                                Background="#FFFFFFFF">
                            <TextBlock Text="Hey"
                                       FontSize="12"
                                       Foreground="#FF111111"/>
                        </Border>
                        <Image HorizontalAlignment="Right"
                               Width="120"
                               Stretch="Uniform"
                               Source="ms-appx:///Assets/ChatTheme/OutgoingBubble.png"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:ChatThemePreviewFormFactorTemplateSelector
            x:Key="ChatThemePreviewFormFactorSelector"
            MobileTemplate="{StaticResource ChatThemePreviewMobileTemplate}"
            DesktopTemplate="{StaticResource ChatThemePreviewDesktopTemplate}"/>
    </UserControl.Resources>

    <ContentControl x:Name="FormFactorHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Top"
                    ContentTemplateSelector="{StaticResource ChatThemePreviewFormFactorSelector}"/>
</UserControl>
