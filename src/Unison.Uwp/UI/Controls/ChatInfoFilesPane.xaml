<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatInfoFilesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="ChatDetailInfoEmptyIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="96"/>
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="ChatDetailInfoEmptyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="24"/>
            <Setter Property="MaxWidth" Value="280"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="FilesHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel x:Name="FilesEmptyHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="&#xE7C3;"
                       FontFamily="{StaticResource IconFont}"
                       Style="{StaticResource ChatDetailInfoEmptyIconStyle}"/>
            <TextBlock x:Name="FilesEmptyText"
                       Style="{StaticResource ChatDetailInfoEmptyTextStyle}"
                       Margin="24,16,24,24"/>
        </StackPanel>
        <ProgressRing x:Name="FilesLoadingRing"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="White"
                      IsActive="False"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"/>
        <ListView x:Name="FilesList"
                  SelectionMode="None"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="helpers:DesktopCursor.CursorKind" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:ChatInfoFileRowControl/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
