<UserControl
    x:Class="Unison.Uwp.UI.Controls.CallsListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:models="using:Unison.Core.Models"
    Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CallsListItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="CallFavoriteRowTemplate" x:DataType="models:CallFavoriteItem">
            <Grid Padding="16,10"
                  Background="Transparent"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:ChatAvatarControl Width="48" Height="48"
                                            Size="48"
                                            ShowBorder="True"
                                            AvatarUrl="{x:Bind AvatarUrl}"
                                            IsGroup="{x:Bind Chat.IsGroup}"
                                            VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind DisplayName}"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           FontSize="17"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button IsEnabled="False"
                            Style="{StaticResource ModernIconButtonStyle}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="Video call">
                        <FontIcon Glyph="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                  Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                    </Button>
                    <Button IsEnabled="False"
                            Style="{StaticResource ModernIconButtonStyle}"
                            AutomationProperties.Name="Voice call">
                        <FontIcon Glyph="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                  Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CallRecentRowTemplate" x:DataType="models:CallRecentItem">
            <Grid Padding="16,10"
                  Background="Transparent"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:ChatAvatarControl Width="48" Height="48"
                                            Size="48"
                                            ShowBorder="True"
                                            AvatarUrl="{x:Bind AvatarUrl}"
                                            IsGroup="{x:Bind IsGroup}"
                                            VerticalAlignment="Center"/>

                <Grid Grid.Column="1"
                      Margin="12,0,12,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind DisplayName}"
                               HorizontalAlignment="Stretch"
                               FontSize="17"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind DirectionGlyph}"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Foreground="{x:Bind Direction, Converter={StaticResource CallDirectionToBrushConverter}}"/>
                        <TextBlock Text="{x:Bind CategoryLabel}"
                                   FontSize="13"
                                   Foreground="{x:Bind Direction, Converter={StaticResource CallDirectionToBrushConverter}}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="2"
                           Text="{x:Bind TimestampLabel}"
                           VerticalAlignment="Top"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid x:Name="FavoritesSection" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="Calls_FavoritesSection"
                           Text="FAVORITES"
                           Margin="16,8,16,4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           CharacterSpacing="40"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>

                <ListView x:Name="FavoritesList"
                          Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          HorizontalAlignment="Stretch"
                          ItemClick="FavoritesList_ItemClick"
                          ItemTemplate="{StaticResource CallFavoriteRowTemplate}"
                          ItemContainerStyle="{StaticResource CallsListItemContainerStyle}"/>

                <HyperlinkButton x:Name="SeeAllFavoritesButton"
                                 Grid.Row="2"
                                 x:Uid="Calls_SeeAllFavorites"
                                 Content="See all"
                                 Margin="16,4,16,8"
                                 HorizontalAlignment="Left"
                                 Click="SeeAllFavoritesButton_Click"
                                 Visibility="Collapsed"/>
            </Grid>

            <Grid x:Name="RecentsSection" Margin="0,8,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="Calls_RecentsSection"
                           Text="RECENT"
                           Margin="16,8,16,4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           CharacterSpacing="40"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>

                <ListView x:Name="RecentsList"
                          Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          HorizontalAlignment="Stretch"
                          ItemClick="RecentsList_ItemClick"
                          ItemTemplate="{StaticResource CallRecentRowTemplate}"
                          ItemContainerStyle="{StaticResource CallsListItemContainerStyle}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
