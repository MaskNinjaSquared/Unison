<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatDetailGroupInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:converters="using:Unison.Uwp.UI.Converters"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ChatDetailInfoPivotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Pivot x:Name="InfoPivot"
           Foreground="White"
           Margin="0,10,0,0"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           HorizontalContentAlignment="Stretch"
           VerticalContentAlignment="Stretch"
           SelectionChanged="InfoPivot_SelectionChanged">
        <Pivot.Resources>
            <Style TargetType="PivotItem" BasedOn="{StaticResource ChatDetailInfoPivotItemStyle}"/>
            <Style TargetType="PivotHeaderItem" BasedOn="{StaticResource ChatDetailInfoPivotHeaderItemStyle}"/>
        </Pivot.Resources>
        <Pivot.HeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="Bold"
                           FontSize="14"/>
            </DataTemplate>
        </Pivot.HeaderTemplate>
        <Pivot.RightHeader>
            <Border Width="60" Height="44" Background="Transparent" IsHitTestVisible="False"/>
        </Pivot.RightHeader>

        <PivotItem x:Name="ProfilePivotItem">
            <ScrollViewer x:Name="ProfileScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="20,8,20,16">
                <StackPanel HorizontalAlignment="Stretch">
                    <controls:ChatAvatarControl x:Name="InfoAvatar"
                                                Size="220"
                                                Width="220"
                                                Height="220"
                                                HorizontalAlignment="Center"
                                                Margin="0,16,0,24"/>
                    <TextBlock x:Name="NameLabel" Style="{StaticResource ChatDetailInfoSectionLabelStyle}" Text="GROUP NAME"/>
                    <TextBlock x:Name="NameValue" Style="{StaticResource ChatDetailInfoSectionValueStyle}"/>
                    <TextBlock x:Name="StatusLabel" Margin="0,20,0,0" Style="{StaticResource ChatDetailInfoSectionLabelStyle}" Text="DESCRIPTION"/>
                    <TextBlock x:Name="StatusValue" Style="{StaticResource ChatDetailInfoSectionValueStyle}"/>
                    <TextBlock x:Name="NotificationsLabel" Margin="0,20,0,0" Style="{StaticResource ChatDetailInfoSectionLabelStyle}" Text="NOTIFICATIONS"/>
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  MinWidth="0"
                                  RequestedTheme="Dark"
                                  Toggled="NotificationsToggle_Toggled"/>
                    <TextBlock x:Name="MembersLabel" Margin="0,20,0,0" Style="{StaticResource ChatDetailInfoSectionLabelStyle}" Text="MEMBERS"/>
                    <TextBlock x:Name="MembersValue" Style="{StaticResource ChatDetailInfoSectionValueStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem x:Name="MembersPivotItem">
            <Grid x:Name="MembersHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="MembersEmptyText" Style="{StaticResource ChatDetailInfoEmptyTextStyle}"/>
                <ListView x:Name="MembersList"
                          Visibility="Collapsed"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="MembersList_ItemClick"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="helpers:DesktopCursor.CursorKind" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:ChatAvatarControl AvatarUrl="{Binding AvatarUrl}"
                                                            Size="40"
                                                            Width="40"
                                                            Height="40"
                                                            VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="16"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="12,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           x:Uid="ChatDetailInfo_Admin"
                                           Text="Admin"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           Foreground="#E8FFFFFF"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </PivotItem>

        <PivotItem x:Name="MediaPivotItem">
            <controls:ChatInfoMediaPane x:Name="MediaPane"/>
        </PivotItem>

        <PivotItem x:Name="FilesPivotItem">
            <controls:ChatInfoFilesPane x:Name="FilesPane"/>
        </PivotItem>
    </Pivot>
</UserControl>
