<UserControl
    x:Class="Unison.Uwp.UI.Controls.CreateChannelFormOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls">

    <!-- Channel form + own emoji dock (isolated from group/community docks). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,24" MaxWidth="420" HorizontalAlignment="Center">
                <Grid MinHeight="160" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <toolkit:DropShadowPanel BlurRadius="80"
                                             OffsetX="0"
                                             OffsetY="4"
                                             ShadowOpacity="0.45"
                                             Color="Black"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                        <Grid Width="160" Height="160">
                            <Ellipse Fill="{ThemeResource AvatarFallbackBackgroundBrush}"/>
                            <FontIcon Glyph="&#xE8BD;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="64"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AvatarFallbackIconBrush}"
                                      Visibility="{Binding HasChannelPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                            <Ellipse Visibility="{Binding HasChannelPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ChannelPhotoBrush"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center"
                                                AlignmentY="Center"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Fill="#66000000"
                                     Visibility="{Binding HasChannelPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                     IsHitTestVisible="False"/>
                            <TextBlock x:Uid="CreateChannel_AddPhotoOverlay"
                                       Text="Add channel image..."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWholeWords"
                                       Margin="20"
                                       FontSize="13"
                                       FontFamily="{StaticResource MainFont}"
                                       Foreground="White"
                                       Visibility="{Binding HasChannelPhoto, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </toolkit:DropShadowPanel>
                    <controls:ProfilePhotoButton x:Name="ChannelPhotoButton"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"/>
                </Grid>

                <controls:RichLabeledTextBox x:Name="ChannelNameField"
                                             x:Uid="CreateChannel_Name"
                                             Margin="0,20,0,0"
                                             Header="Channel name"
                                             PlaceholderText=""
                                             Text="{Binding ChannelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinBoxHeight="56"
                                             EmojiInvoked="ChannelField_EmojiInvoked"/>
                <controls:RichLabeledTextBox x:Name="ChannelDescriptionField"
                                             x:Uid="CreateChannel_Description"
                                             Margin="0,12,0,0"
                                             Header="Channel description"
                                             PlaceholderText="Enter a description for the channel and include useful information for your followers."
                                             Text="{Binding ChannelDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             InputVerticalContentAlignment="Top"
                                             MinBoxHeight="140"
                                             MaxInputHeight="220"
                                             EmojiInvoked="ChannelField_EmojiInvoked"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ChannelEmojiDock"
                Grid.Row="1"
                Height="280"
                Visibility="Collapsed"
                Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                BorderBrush="{ThemeResource ChatDetailPaneSeparatorBrush}"
                BorderThickness="0,1,0,0">
            <controls:EmojiPickerPanel x:Name="ChannelEmojiPanel"
                                       GlyphPicked="ChannelEmojiPanel_GlyphPicked"/>
        </Border>
    </Grid>
</UserControl>
