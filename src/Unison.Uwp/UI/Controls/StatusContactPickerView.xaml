<UserControl
    x:Class="Unison.Uwp.UI.Controls.StatusContactPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    x:Name="Root"
    Background="{ThemeResource ChatListBackgroundBrush}">

    <!-- Unison / WhatsApp: X close on top, circular confirm FAB bottom-right. DataContext: StatusComposerViewModel. -->
    <UserControl.Resources>
        <DataTemplate x:Key="PickerContactTemplate">
            <Grid Padding="12,10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChatAvatarControl Width="40" Height="40"
                                            Size="40"
                                            ShowBorder="True"
                                            VerticalAlignment="Center"
                                            AvatarUrl="{Binding AvatarUrl}"
                                            IsGroup="{Binding IsGroup}"/>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           helpers:EmojiTextBlock.Text="{Binding Name}"
                           FontSize="17"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PickerGroupHeaderTemplate">
            <Border Width="36" Height="36"
                    Margin="10,12,16,4"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="2"
                    Background="Transparent">
                <TextBlock Text="{Binding Key}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontSemibold}"
                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <Style x:Key="PickerGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PickerZoomedOutTemplate">
            <Border Width="72" Height="72"
                    Margin="6"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Key}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="4,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ModernIconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0,8,0"
                    AutomationProperties.Name="Close"
                    Command="{Binding ContactPickerCancelCommand}">
                <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ContactPickerTitle}"
                           FontSize="20"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="{Binding ContactPickerSubtitle}"
                           FontSize="13"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </StackPanel>
        </Grid>

        <SemanticZoom x:Name="PickerZoom" Grid.Row="1">
            <SemanticZoom.ZoomedInView>
                <ListView x:Name="PickerList"
                          SelectionMode="Multiple"
                          IsMultiSelectCheckBoxEnabled="True"
                          ItemTemplate="{StaticResource PickerContactTemplate}"
                          Background="Transparent"
                          Padding="0,0,0,88"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource PickerGroupHeaderTemplate}"
                                    HeaderContainerStyle="{StaticResource PickerGroupHeaderContainerStyle}"/>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <GridView x:Name="PickerJumpList"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemTemplate="{StaticResource PickerZoomedOutTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          Background="Transparent">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           MaximumRowsOrColumns="4"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>

        <Button Grid.Row="1"
                Width="56" Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="0"
                MinWidth="0"
                MinHeight="0"
                BorderThickness="0"
                Background="Transparent"
                AutomationProperties.Name="Confirm"
                Command="{Binding ContactPickerConfirmCommand}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="FabRoot" Width="56" Height="56">
                        <Ellipse Fill="{ThemeResource WhatsAppGreenFocusBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="FabRoot.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="FabRoot.Opacity" Value="0.5"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <FontIcon Glyph="&#xE73E;"
                      FontFamily="{StaticResource IconFont}"
                      FontSize="20"
                      Foreground="White"/>
        </Button>
    </Grid>
</UserControl>
