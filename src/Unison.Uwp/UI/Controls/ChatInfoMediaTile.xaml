<UserControl
    x:Class="Unison.Uwp.UI.Controls.ChatInfoMediaTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid x:Name="Root"
          Background="#FF1A1A1A"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <TextBlock x:Name="ImageGlyph"
                   Text="&#xE91B;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="36"
                   Foreground="#66FFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
        <controls:ChatInfoBlurredThumb x:Name="Thumb"/>

        <Grid x:Name="PlayHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Ellipse Width="40" Height="40" Fill="#99000000"/>
            <TextBlock x:Name="DownloadGlyph"
                       Text="&#xE896;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="PlayGlyph"
                       Text="&#xE768;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="PauseGlyph"
                       Text="&#xE769;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <Button x:Name="DownloadImageButton"
                Command="{Binding DownloadImageCommand}"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <TextBlock Text="&#xE896;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="28"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>
        <ProgressRing x:Name="BusyRing"
                      Width="28"
                      Height="28"
                      Foreground="White"
                      IsActive="False"
                      Visibility="Collapsed"/>

        <StackPanel x:Name="Footer"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="6,0,0,6"
                    IsHitTestVisible="False">
            <TextBlock x:Name="FooterIcon"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="12"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="FooterDuration"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="11"
                       Foreground="White"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
