<UserControl
    x:Class="Unison.Uwp.UI.Controls.FavoritesListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ChatItemTemplates/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="FavoriteGroupHeaderTemplate">
                <Border Width="36" Height="36"
                        Margin="16,12,16,4"
                        BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                        BorderThickness="2"
                        Background="Transparent">
                    <TextBlock Text="{Binding Key}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                </Border>
            </DataTemplate>

            <Style x:Key="FavoriteGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewHeaderItem">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="FavoriteZoomedOutTemplate">
                <Border Width="72" Height="72"
                        Margin="6"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        Opacity="{Binding Opacity}">
                    <TextBlock Text="{Binding Key}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <controls:FavoritesEmptyControl
            x:Name="EmptyState"
            Visibility="Collapsed"/>

        <SemanticZoom x:Name="FavoritesZoom"
                      Visibility="Collapsed"
                      ViewChangeStarted="FavoritesZoom_ViewChangeStarted"
                      ViewChangeCompleted="FavoritesZoom_ViewChangeCompleted">
            <SemanticZoom.ZoomedInView>
                <ListView x:Name="FavoritesList"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesList_ItemClick"
                          SelectionMode="None"
                          Background="Transparent"
                          ItemTemplate="{StaticResource ChatItemTemplate}"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource FavoriteGroupHeaderTemplate}"
                                    HeaderContainerStyle="{StaticResource FavoriteGroupHeaderContainerStyle}"/>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource WhatsAppChatListItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <GridView x:Name="FavoritesJumpList"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ItemTemplate="{StaticResource FavoriteZoomedOutTemplate}"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesJumpList_ItemClick"
                          SelectionMode="None"
                          Background="Transparent"
                          ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           MaximumRowsOrColumns="4"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
    </Grid>
</UserControl>
