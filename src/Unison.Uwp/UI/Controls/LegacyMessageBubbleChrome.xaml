<UserControl
    x:Class="Unison.Uwp.UI.Controls.LegacyMessageBubbleChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="64"
    d:DesignWidth="240">

    <!--
      WhatsApp Legacy: square bubble.
      Received — 1:1: tail above, 10px in from the left.
      Received — group: tail flush left, pointing at the sender photo, same place as Unison.
      Sent — 1:1 and group: tail below, 10px in from the right.
    -->
    <Grid x:Name="RootGrid">
        <Grid x:Name="OutgoingHost" Visibility="Collapsed">
            <Border Background="{ThemeResource ChatDetailSentBubbleBrush}" CornerRadius="0"/>
            <Grid x:Name="OutgoingTailBelow"
                  Width="12"
                  Height="10"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,10,-10"
                  Visibility="Collapsed">
                <Path Stretch="Fill"
                      Fill="{ThemeResource ChatDetailSentBubbleBrush}"
                      Data="M0,0 L12,0 L12,10 Z"/>
            </Grid>
        </Grid>

        <Grid x:Name="IncomingHost" Visibility="Collapsed">
            <Border Background="{ThemeResource ChatDetailReceivedBubbleBrush}" CornerRadius="0"/>
            <Grid x:Name="IncomingTailUp"
                  Width="12"
                  Height="10"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Margin="10,-10,0,0"
                  Visibility="Collapsed">
                <Path Stretch="Fill"
                      Fill="{ThemeResource ChatDetailReceivedBubbleBrush}"
                      Data="M0,10 L12,10 L0,0 Z"/>
            </Grid>
            <Grid x:Name="IncomingTailSide"
                  Width="10"
                  Height="12"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Margin="-10,0,0,0"
                  Visibility="Collapsed">
                <Path Stretch="Fill"
                      Fill="{ThemeResource ChatDetailReceivedBubbleBrush}"
                      Data="M10,0 L10,12 L0,0 Z"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
