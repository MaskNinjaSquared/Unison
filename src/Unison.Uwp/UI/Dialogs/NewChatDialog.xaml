<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.NewChatDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="NewChatDialog"
    Title="New Chat"
    PrimaryButtonText="Start Chat"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Margin="0,10,0,0">
        <TextBlock x:Uid="NewChat_Hint"
                   Text="Enter the phone number of the person you want to message." 
                   TextWrapping="Wrap" 
                   FontSize="14" 
                   Margin="0,0,0,16"
                   FontFamily="{StaticResource MainFont}"/>
        
        <TextBox x:Name="PhoneNumberBox"
                 x:Uid="NewChat_Phone"
                 Header="Phone Number" 
                 PlaceholderText="e.g. +447700900000"
                 InputScope="TelephoneNumber"
                 Margin="0,0,0,16"
                 FontFamily="{StaticResource MainFont}"/>

        <TextBlock x:Name="ErrorText" 
                   Foreground="Red" 
                   FontSize="12" 
                   Visibility="Collapsed"
                   Margin="0,0,0,16"
                   FontFamily="{StaticResource MainFont}"/>
    </StackPanel>
</ContentDialog>
