<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.GroupEphemeralDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="CreateGroup_EphemeralDialog"
    Title="Temporary messages"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">280</x:Double>
        <Thickness x:Key="ContentDialogPadding">16,12</Thickness>
    </ContentDialog.Resources>

    <StackPanel>
        <TextBlock x:Uid="CreateGroup_EphemeralDialogBody"
                   Text="All new messages in this chat will disappear after the selected duration."
                   TextWrapping="WrapWholeWords"
                   Margin="0,0,0,12"
                   FontSize="14"
                   FontFamily="{StaticResource MainFont}"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>

        <RadioButton x:Name="Option24Hours"
                     x:Uid="CreateGroup_Ephemeral_24Hours"
                     Content="24 hours"
                     GroupName="GroupEphemeral"
                     Margin="0,4"/>
        <RadioButton x:Name="Option7Days"
                     x:Uid="CreateGroup_Ephemeral_7Days"
                     Content="7 days"
                     GroupName="GroupEphemeral"
                     Margin="0,4"/>
        <RadioButton x:Name="Option90Days"
                     x:Uid="CreateGroup_Ephemeral_90Days"
                     Content="90 days"
                     GroupName="GroupEphemeral"
                     Margin="0,4"/>
        <RadioButton x:Name="OptionOff"
                     x:Uid="CreateGroup_Ephemeral_Off"
                     Content="Off"
                     GroupName="GroupEphemeral"
                     Margin="0,4"/>
    </StackPanel>
</ContentDialog>
