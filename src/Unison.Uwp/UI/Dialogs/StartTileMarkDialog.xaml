<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.StartTileMarkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="StartTileDialog"
    Title="Tile do Início"
    PrimaryButtonText="Fixar"
    CloseButtonText="Cancelar"
    PrimaryButtonClick="OnPinClick"
    DefaultButton="Primary"
    FullSizeDesired="False">

    <!-- Cap width locally: App.xaml raises ContentDialogMaxWidth to 2000 for settings.
         On Mobile that makes this picker measure wider than the screen and sit off-center. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">360</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">280</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">560</x:Double>
        <Thickness x:Key="ContentDialogPadding">16,12</Thickness>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled"
                  HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <Border x:Name="PreviewPlate"
                    Width="112"
                    Height="112"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,12"
                    Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                <Grid Width="112" Height="112">
                    <!-- Keep glyph larger than the plate (same look as the Start tile),
                         but do not let DesiredSize inflate the dialog width. -->
                    <Image x:Name="PreviewIcon"
                           Width="112"
                           Height="112"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </Image.RenderTransform>
                    </Image>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,112,112"/>
                    </Grid.Clip>
                </Grid>
            </Border>

            <CheckBox x:Name="TransparentTileCheck"
                      x:Uid="StartTileDialog_Transparent"
                      Content="Transparent tile"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Center"
                      Checked="OnTransparentChanged"
                      Unchecked="OnTransparentChanged"/>

            <RadioButton x:Name="UnisonOption"
                         x:Uid="StartTileDialog_Unison"
                         GroupName="StartTileMark"
                         Content="Unison"
                         HorizontalAlignment="Left"
                         Checked="OnMarkChecked"/>
            <RadioButton x:Name="WhatsAppWebOption"
                         x:Uid="StartTileDialog_WhatsAppWeb"
                         GroupName="StartTileMark"
                         Content="WhatsApp Web"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         Checked="OnMarkChecked"/>
            <RadioButton x:Name="WhatsAppLegacyOption"
                         x:Uid="StartTileDialog_WhatsAppLegacy"
                         GroupName="StartTileMark"
                         Content="WhatsApp Legacy"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         Checked="OnMarkChecked"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
