<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.StartTileMarkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="StartTileDialog"
    Title="Tile do Início"
    PrimaryButtonText="Fixar"
    CloseButtonText="Cancelar"
    PrimaryButtonClick="OnPinClick"
    DefaultButton="Primary">

    <StackPanel MinWidth="280">
        <Border Width="150"
                Height="150"
                HorizontalAlignment="Center"
                Margin="0,4,0,16"
                Background="{ThemeResource SystemControlBackgroundAccentBrush}">
            <Grid Width="150" Height="150">
                <Image x:Name="PreviewIcon"
                       Width="220"
                       Height="220"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,150,150"/>
                </Grid.Clip>
            </Grid>
        </Border>

        <RadioButton x:Name="UnisonOption"
                     x:Uid="StartTileDialog_Unison"
                     GroupName="StartTileMark"
                     Content="Unison"
                     Checked="OnMarkChecked"/>
        <RadioButton x:Name="WhatsAppWebOption"
                     x:Uid="StartTileDialog_WhatsAppWeb"
                     GroupName="StartTileMark"
                     Content="WhatsApp Web"
                     Margin="0,4,0,0"
                     Checked="OnMarkChecked"/>
        <RadioButton x:Name="WhatsAppLegacyOption"
                     x:Uid="StartTileDialog_WhatsAppLegacy"
                     GroupName="StartTileMark"
                     Content="WhatsApp Legacy"
                     Margin="0,4,0,0"
                     Checked="OnMarkChecked"/>
    </StackPanel>
</ContentDialog>
