<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.NotificationFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="NotificationFilterDialog"
    Title="Filter notifications"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OnOkClick"
    DefaultButton="Primary"
    FullSizeDesired="False">

    <!-- Cap width locally: App.xaml raises ContentDialogMaxWidth to 2000 for settings.
         On Mobile that makes this picker measure wider than the screen and sit off-center. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">360</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">280</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">560</x:Double>
        <Thickness x:Key="ContentDialogPadding">16,12</Thickness>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled"
                  HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <RadioButton x:Name="AllOption"
                         x:Uid="Settings_LockScreenScope_All"
                         GroupName="NotificationFilterScope"
                         Content="All"
                         HorizontalAlignment="Left"
                         Checked="OnScopeChecked"/>
            <RadioButton x:Name="GroupsOption"
                         x:Uid="Settings_LockScreenScope_Groups"
                         GroupName="NotificationFilterScope"
                         Content="Groups"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         Checked="OnScopeChecked"/>
            <RadioButton x:Name="DirectOption"
                         x:Uid="Settings_LockScreenScope_Direct"
                         GroupName="NotificationFilterScope"
                         Content="Contacts"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         Checked="OnScopeChecked"/>
            <RadioButton x:Name="FavoritesOption"
                         x:Uid="Settings_LockScreenScope_Favorites"
                         GroupName="NotificationFilterScope"
                         Content="Favorites"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         Checked="OnScopeChecked"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
