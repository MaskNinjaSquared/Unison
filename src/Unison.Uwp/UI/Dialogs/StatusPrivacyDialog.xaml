<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.StatusPrivacyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="StatusPrivacyDialog"
    Title="Status privacy"
    PrimaryButtonText="Confirm"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    FullSizeDesired="False">

    <!-- DataContext: StatusComposerViewModel. Same local width cap as NotificationFilterDialog. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">280</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
        <Thickness x:Key="ContentDialogPadding">16,12</Thickness>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled">
        <StackPanel>
            <TextBlock x:Uid="StatusPrivacyDialog_Prompt"
                       Text="Who can see my status updates on WhatsApp"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <RadioButton x:Name="ContactsOption"
                         GroupName="StatusPrivacyAudience"
                         HorizontalAlignment="Stretch"
                         Checked="ContactsOption_Checked">
                <StackPanel>
                    <TextBlock x:Uid="StatusPrivacyDialog_Contacts" Text="My contacts" FontSize="15"/>
                    <TextBlock x:Uid="StatusPrivacyDialog_ContactsHint"
                               Text="Share with all of your contacts"
                               FontSize="13"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ExceptOption"
                         GroupName="StatusPrivacyAudience"
                         HorizontalAlignment="Stretch"
                         Margin="0,8,0,0"
                         Click="ExceptOption_Click">
                <StackPanel>
                    <TextBlock x:Uid="StatusPrivacyDialog_Except" Text="My contacts except..." FontSize="15"/>
                    <TextBlock Text="{Binding ExcludedCountLabel}"
                               FontSize="13"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="OnlyOption"
                         GroupName="StatusPrivacyAudience"
                         HorizontalAlignment="Stretch"
                         Margin="0,8,0,0"
                         Click="OnlyOption_Click">
                <StackPanel>
                    <TextBlock x:Uid="StatusPrivacyDialog_Only" Text="Only share with..." FontSize="15"/>
                    <TextBlock Text="{Binding OnlyShareWithCountLabel}"
                               FontSize="13"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
