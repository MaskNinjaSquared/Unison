<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.DocumentSendPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Send document?"
    PrimaryButtonText="Send"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel>
        <!-- Same icon + name layout as ChatInfoFileRowControl. -->
        <Border Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7C3;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="28"
                           Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                               FontSize="14"
                               FontFamily="{StaticResource MainFont}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InfoText"
                               Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                               FontSize="12"
                               FontFamily="{StaticResource MainFont}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBox x:Name="CaptionBox"
                 Margin="0,12,0,0"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MaxLength="1024"
                 FontFamily="{StaticResource MainFont}"
                 PlaceholderText="Add a caption..."/>
    </StackPanel>
</ContentDialog>
