<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.ImageSendPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ChatDetail_SendImage"
    Title="Send Image?"
    PrimaryButtonText="Send"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel>
        <Grid x:Name="PreviewHost"
              MaxHeight="300"
              ManipulationMode="TranslateX"
              ManipulationCompleted="PreviewHost_ManipulationCompleted">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
            <Button x:Name="PreviousButton"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource TransparentMediaButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="PreviousButton_Click"/>
            <Button x:Name="NextButton"
                    Content="&#xE76C;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource TransparentMediaButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="NextButton_Click"/>
        </Grid>
        <TextBlock x:Name="ImageIndexText"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                   FontSize="12"
                   FontFamily="{StaticResource MainFont}"/>
        <TextBlock x:Name="InfoText"
                   Margin="0,8,0,0"
                   Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                   FontSize="12"
                   FontFamily="{StaticResource MainFont}"/>
        <TextBox x:Name="CaptionBox"
                 x:Uid="ChatDetail_SendImageCaption"
                 Margin="0,12,0,0"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MaxLength="1024"
                 FontFamily="{StaticResource MainFont}"
                 PlaceholderText="Add a caption..."/>
    </StackPanel>
</ContentDialog>
