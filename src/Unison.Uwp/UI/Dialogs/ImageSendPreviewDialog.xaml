<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.ImageSendPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ChatDetail_SendImage"
    Title="Send Image?"
    PrimaryButtonText="Send"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel>
        <Image x:Name="PreviewImage" MaxHeight="300" Stretch="Uniform"/>
        <TextBlock x:Name="InfoText"
                   Margin="0,8,0,0"
                   Foreground="{ThemeResource ChatDetailMutedTextBrush}"
                   FontSize="12"
                   FontFamily="{StaticResource MainFont}"/>
        <TextBox x:Name="CaptionBox"
                 x:Uid="ChatDetail_SendImageCaption"
                 Margin="0,12,0,0"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MaxLength="1024"
                 FontFamily="{StaticResource MainFont}"
                 PlaceholderText="Add a caption..."/>
    </StackPanel>
</ContentDialog>
