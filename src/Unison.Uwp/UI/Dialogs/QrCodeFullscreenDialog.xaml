<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.QrCodeFullscreenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    FullSizeDesired="True"
    Background="{ThemeResource LoginPageBackgroundBrush}">

    <!-- Same zero chrome padding pattern as WhatsApp SettingsDialog (Imgur/Giuraffe). -->
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
    </ContentDialog.Resources>

    <Grid Background="{ThemeResource LoginPageBackgroundBrush}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource LoginQrCardBackgroundBrush}"
                BorderBrush="{ThemeResource LoginQrCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                MaxWidth="400">
            <Image x:Name="QrImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   MinHeight="160"
                   MaxHeight="400"/>
        </Border>

        <!-- Same green CTA as StartView "Get started"; 10px margin keeps it off the edges. -->
        <Button x:Name="CloseButton"
                Grid.Row="1"
                Content="Close"
                MinWidth="200"
                HorizontalAlignment="Center"
                Padding="28,12"
                FontSize="15"
                Margin="10"
                Background="{ThemeResource WhatsAppGreenFocusBrush}"
                Foreground="White"
                Click="CloseButton_Click"/>
    </Grid>
</ContentDialog>
