<ContentDialog
    x:Class="Unison.Uwp.UI.Dialogs.QrCodeFullscreenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    FullSizeDesired="True"
    CloseButtonText="OK"
    Background="{ThemeResource LoginPageBackgroundBrush}">

    <Grid Background="{ThemeResource LoginPageBackgroundBrush}" MinHeight="320">
        <Border Padding="16"
                Background="{ThemeResource LoginQrCardBackgroundBrush}"
                BorderBrush="{ThemeResource LoginQrCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image x:Name="QrImage"
                   Width="320"
                   Height="320"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>
    </Grid>
</ContentDialog>
