<UserControl
    x:Class="Unison.Uwp.UI.Views.ChatDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:views="using:Unison.Uwp.UI.Views"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:MessageTemplates/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ChatDetailGrid"
          Background="{ThemeResource ChatDetailBackgroundBrush}"
          BorderBrush="{ThemeResource ChatDetailPaneSeparatorBrush}"
          BorderThickness="1,0,0,0">
        <VisualStateManager.VisualStateGroups>
            <!-- LayoutStates (app-wide): Minimal | Extended | ExtendedWide -->
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Full-screen detail: no list beside → no left separator -->
                        <Setter Target="ChatDetailGrid.BorderThickness" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChatDetailGrid.BorderThickness" Value="1,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ActiveChatGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChatColumn" Width="*"/>
                <ColumnDefinition x:Name="InfoColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ChatSurface" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Tiled Background Layer -->
            <controls:TiledBackground Grid.RowSpan="4"/>

            <!-- Chat Header with DropShadowPanel (Imgur-style; black cast below) -->
            <toolkit:DropShadowPanel Grid.Row="0"
                                     Canvas.ZIndex="2"
                                     BlurRadius="12"
                                     OffsetX="4"
                                     OffsetY="4"
                                     ShadowOpacity="0.55"
                                     Color="Black"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch">
                <Grid Height="64" Padding="12,0" Background="{ThemeResource ChatDetailHeaderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,4,0"
                            Foreground="{ThemeResource ChatDetailHeaderTitleBrush}">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                    </Button>

                    <controls:ChatAvatarControl x:Name="HeaderAvatar"
                                                Grid.Column="1"
                                                Size="40"
                                                Width="40" Height="40"
                                                ShowBorder="True"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                Tapped="HeaderAvatar_Tapped"/>

                    <!-- Name + status only (avatar has its own tap → OpenChatDetailInfoFromAvatarCommand). -->
                    <Button x:Name="HeaderInfoButton"
                            Grid.Column="2"
                            Click="HeaderInfoButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            HorizontalAlignment="Stretch"
                            Margin="0,5,5,5"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center">
                        <StackPanel x:Name="TitleStatusPanel" VerticalAlignment="Center" Margin="0,0,8,0"
                                    HorizontalAlignment="Left">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TitleTranslateTransform" Y="0"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="ChatTitleText" x:Uid="ChatDetail_SelectChat" Text="Select a chat" FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ChatStatusText" Text="" FontSize="13"
                                       FontFamily="{StaticResource MainFont}"
                                       Foreground="{ThemeResource ChatDetailHeaderStatusBrush}" Opacity="0"
                                       Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <!-- Contact actions (1:1 chats) — disabled until call/contact commands exist -->
                    <StackPanel x:Name="ContactHeaderActions"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="ContactVideoCallButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                IsEnabled="False"
                                Width="40" Height="40" Margin="0,0,2,0"
                                Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                ToolTipService.ToolTip="Video call">
                            <FontIcon Glyph="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                        </Button>
                        <Button x:Name="ContactAudioCallButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                IsEnabled="False"
                                Width="40" Height="40" Margin="0,0,2,0"
                                Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                ToolTipService.ToolTip="Voice call">
                            <FontIcon Glyph="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                        </Button>
                        <Button x:Name="ContactMoreButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                Width="40" Height="40"
                                Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                ToolTipService.ToolTip="More">
                            <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}"
                                            Opening="ChatMoreFlyout_Opening">
                                    <MenuFlyoutItem x:Uid="ChatDetail_ShowContact" Text="View contact" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem x:Uid="ChatDetail_Search" Text="Search" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem x:Uid="ChatDetail_MediaLinksDocs" Text="Media, links, and docs" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutSubItem Tag="localMuteSub"
                                                       x:Uid="ChatDetail_MuteNotifications"
                                                       Text="Mute notifications">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                                        </MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteFor8Hours" Text="8 hours"
                                                        Command="{Binding MuteFor8HoursCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteFor1Week" Text="1 week"
                                                        Command="{Binding MuteFor1WeekCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteForever" Text="Always"
                                                        Command="{Binding MuteForeverCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Tag="unmute"
                                                    x:Uid="ChatDetail_UnmuteNotifications"
                                                    Text="Unmute notifications"
                                                    Command="{Binding UnmuteLocalCommand}"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="ChatDetail_ExportChat" Text="Export chat" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem Tag="widgetPin"
                                                    Text="{Binding LiveTilePinMenuLabel}"
                                                    Command="{Binding PinToStartCommand}"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Group actions — disabled until group commands exist -->
                    <StackPanel x:Name="GroupHeaderActions"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="GroupVideoCallButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                IsEnabled="False"
                                Width="40" Height="40" Margin="0,0,2,0"
                                Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                ToolTipService.ToolTip="Video call">
                            <FontIcon Glyph="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                        </Button>
                        <Button x:Name="GroupMoreButton"
                                Style="{StaticResource WhatsAppIconButtonStyle}"
                                Width="40" Height="40"
                                Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                                ToolTipService.ToolTip="More">
                            <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}"
                                            Opening="ChatMoreFlyout_Opening">
                                    <MenuFlyoutItem x:Uid="ChatDetail_GroupInfo" Text="Group info" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem x:Uid="ChatDetail_Search" Text="Search" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem x:Uid="ChatDetail_GroupMedia" Text="Group media" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutSubItem Tag="localMuteSub"
                                                       x:Uid="ChatDetail_MuteNotifications"
                                                       Text="Mute notifications">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                                        </MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteFor8Hours" Text="8 hours"
                                                        Command="{Binding MuteFor8HoursCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteFor1Week" Text="1 week"
                                                        Command="{Binding MuteFor1WeekCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="ChatDetail_MuteForever" Text="Always"
                                                        Command="{Binding MuteForeverCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Tag="unmute"
                                                    x:Uid="ChatDetail_UnmuteNotifications"
                                                    Text="Unmute notifications"
                                                    Command="{Binding UnmuteLocalCommand}"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="ChatDetail_ExportChat" Text="Export chat" IsEnabled="False"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    <MenuFlyoutItem Tag="widgetPin"
                                                    Text="{Binding LiveTilePinMenuLabel}"
                                                    Command="{Binding PinToStartCommand}"
                                                    Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </toolkit:DropShadowPanel>

            <Button Grid.Row="1" x:Name="PinnedMessageButton" Visibility="Collapsed"
                    Click="PinnedMessageButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource ChatDetailPinnedBarBackgroundBrush}" BorderThickness="0" Padding="12,7">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{ThemeResource ChatDetailAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="PinnedMessageTitleText" x:Uid="ChatDetail_Pinned" Text="Pinned message" FontSize="11" Foreground="{ThemeResource ChatDetailAccentBrush}"/>
                        <TextBlock x:Name="PinnedMessagePreviewText" Text="" FontSize="13" Foreground="{ThemeResource ChatDetailPinnedPreviewBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Messages List -->
            <ListView Grid.Row="2" x:Name="MessageListView" 
                      ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                      SelectionMode="None"
                      Padding="0,12">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Hidden player for voice bubbles; SMTC driven via MediaPlayer (Imgur-style). -->
            <MediaPlayerElement x:Name="AudioPlayer" Grid.Row="2"
                                Width="1" Height="1" Opacity="0"
                                IsHitTestVisible="False"
                                AreTransportControlsEnabled="False"
                                AutoPlay="False"/>

            <!-- Composer / recording overlay share row 3 (hidden when group announce-lock) -->
            <Grid Grid.Row="3"
                  Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                  Visibility="{Binding IsGroupLockedForMessages, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Border Height="1"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                        IsHitTestVisible="False"/>

                <!-- Normal input bar (hidden while recording) -->
                <Grid Padding="12"
                      Visibility="{Binding IsRecording, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            Command="{Binding AttachMediaCommand}">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="20"/>
                    </Button>

                    <TextBox Grid.Column="1" x:Name="MessageInput" x:Uid="ChatDetail_MessageInput"
                             PlaceholderText="Type a message"
                             Text="{Binding MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0" VerticalAlignment="Center" BorderThickness="0"
                             Style="{StaticResource TransparentTextBoxStyle}"
                             Background="Transparent" KeyDown="MessageInput_KeyDown"/>

                    <Button x:Name="MicButton" Grid.Column="2"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            Command="{Binding StartRecordingCommand}">
                        <TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{ThemeResource ChatDetailAccentBrush}"/>
                    </Button>

                    <Button x:Name="SendButton" Grid.Column="3"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            Command="{Binding SendMessageCommand}">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{ThemeResource ChatDetailAccentBrush}"/>
                    </Button>
                </Grid>

                <!-- Recording overlay: red mic + elapsed | trash + send -->
                <Grid x:Name="RecordingOverlay" Padding="12"
                      Visibility="{Binding IsRecording, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RecordingMicIcon"
                               Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="Red" VerticalAlignment="Center" Margin="4,0,0,0"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="RecordingMicTranslate"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock x:Name="RecordingElapsedText"
                               Grid.Column="1"
                               Text="{Binding RecordingElapsedText}"
                               FontSize="16"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="{ThemeResource ChatDetailHeaderTitleBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0"/>

                    <Button x:Name="CancelRecordingButton"
                            Grid.Column="2"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            Click="CancelRecordingButton_Click"
                            ToolTipService.ToolTip="Cancel">
                        <TextBlock x:Name="RecordingTrashIcon"
                                   Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{ThemeResource ChatDetailMutedTextBrush}"/>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            Command="{Binding SendRecordingCommand}"
                            ToolTipService.ToolTip="Send">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{ThemeResource ChatDetailAccentBrush}"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- Group announce-only lock (replaces composer on row 3) -->
            <Grid Grid.Row="3"
                  Background="{ThemeResource ChatDetailInputBarBackgroundBrush}"
                  Visibility="{Binding IsGroupLockedForMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Height="1"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ChatDetailInputBarTopBorderBrush}"
                        IsHitTestVisible="False"/>
                <TextBlock x:Uid="ChatDetail_GroupOnlyAdminsCanSend"
                           Text="Only admins can send messages"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"
                           Margin="16,14"
                           FontSize="14"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="{ThemeResource ChatDetailMutedTextBrush}"/>
            </Grid>
            </Grid><!-- ChatSurface -->

            <controls:ChatDetailInfoControl x:Name="ChatDetailInfoPanel"
                                            Grid.Column="1"
                                            Visibility="Collapsed"
                                            CloseCommand="{Binding CloseChatDetailInfoCommand}">
                <controls:ChatDetailInfoControl.RenderTransform>
                    <TranslateTransform x:Name="ChatDetailInfoSlideTransform" X="0"/>
                </controls:ChatDetailInfoControl.RenderTransform>
            </controls:ChatDetailInfoControl>
        </Grid>

        <!-- Empty State -->
        <Grid x:Name="EmptyStateGrid" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Button x:Name="EmptyBackButton"
                        Style="{StaticResource WhatsAppIconButtonStyle}"
                        Width="40" Height="40"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                </Button>
                <TextBlock x:Uid="ChatDetail_Empty" Text="Select a chat to start messaging" Foreground="{ThemeResource ChatDetailMutedTextBrush}" FontSize="16" FontFamily="{StaticResource MainFont}" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Full-screen image viewer (Imgur-style chrome) -->
        <views:ImageViewerView x:Name="ImageViewerOverlay"
                               Visibility="Collapsed"
                               Canvas.ZIndex="100"/>

        <!-- Full-screen video viewer (Imgur FullScreenMediaView layout) -->
        <views:VideoViewerView x:Name="VideoViewerOverlay"
                               Visibility="Collapsed"
                               Canvas.ZIndex="101"/>
    </Grid>
</UserControl>
