<UserControl
    x:Class="Unison.Uwp.UI.Views.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="480">

    <Grid x:Name="RootGrid"
          Background="Black"
          Tapped="RootGrid_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image area only (does not span caption row) -->
        <ScrollViewer x:Name="ImageScroll"
                      Grid.Row="0"
                      ZoomMode="Enabled"
                      MinZoomFactor="1"
                      MaxZoomFactor="5"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Auto"
                      VerticalScrollMode="Disabled"
                      ZoomSnapPointsType="Optional"
                      BringIntoViewOnFocusChange="False"
                      IsTabStop="True"
                      Background="Black">
            <Grid x:Name="ImageHost"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="Transparent">
                <Image x:Name="ViewerImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ImageOpened="ViewerImage_ImageOpened"
                       DoubleTapped="ViewerImage_DoubleTapped"/>
            </Grid>
        </ScrollViewer>

        <!-- Top chrome overlays image row only -->
        <Grid x:Name="TopChrome"
              Grid.Row="0"
              VerticalAlignment="Top"
              Canvas.ZIndex="2"
              Tapped="Chrome_Tapped">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid MinHeight="72" Padding="8,12,8,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Command="{Binding CloseCommand}"
                        Width="34" Height="34"
                        Margin="4,0,8,0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <Grid Width="34" Height="34">
                        <Ellipse Fill="#E6232424"/>
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="WhiteSmoke"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,8,0">
                    <TextBlock Text="{Binding SenderDisplayName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>
                    <TextBlock Text="{Binding FormattedDateTime}"
                               FontSize="12"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="#B3FFFFFF"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Command="{Binding DownloadCommand}"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            ToolTipService.ToolTip="{Binding DownloadTooltip}">
                        <TextBlock Text="&#xE896;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="18"
                                   Foreground="White"/>
                    </Button>
                    <Button Command="{Binding ShareCommand}"
                            Style="{StaticResource WhatsAppIconButtonStyle}"
                            Width="40" Height="40"
                            ToolTipService.ToolTip="{Binding ShareTooltip}">
                        <TextBlock Text="&#xE72D;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="18"
                                   Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Caption in its own Auto row (never overlaid on the image) -->
        <Border x:Name="CaptionChrome"
                Grid.Row="1"
                Background="#FF111111"
                Padding="16,12,16,16"
                Visibility="Collapsed"
                Tapped="Chrome_Tapped">
            <TextBlock Text="{Binding Caption}"
                       FontSize="15"
                       FontFamily="{StaticResource MainFont}"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="5"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"
                       IsTextSelectionEnabled="True"/>
        </Border>
    </Grid>
</UserControl>
