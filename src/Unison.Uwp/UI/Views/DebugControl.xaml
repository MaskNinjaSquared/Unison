<UserControl
    x:Class="Unison.Uwp.UI.Views.DebugControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    Background="{ThemeResource DebugPageBackgroundBrush}">

    <!-- Same shell geometry as SettingsView: columns, header margins, scroll padding. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource DebugPageBackgroundBrush}"
          Padding="15">
        <VisualStateManager.VisualStateGroups>
            <!-- LayoutStates (app-wide): Minimal | Extended | ExtendedWide -->
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" MaxWidth="800" MinWidth="290"/>
            <ColumnDefinition Width="0.4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,5,0,0" Opacity="0.8">
            <Button x:Name="BackButton" Command="{Binding BackCommand}"
                    Style="{StaticResource WhatsAppIconButtonStyle}"
                    Width="34" Height="34" Margin="5,0,0,0"
                    Background="Transparent" Opacity="0.9"
                    Foreground="{ThemeResource WhatsAppTextHighBrush}">
                <FontIcon FontSize="16" FontFamily="{StaticResource IconFont}"
                          Glyph="&#xE72B;"/>
            </Button>
            <TextBlock x:Uid="Debug_Title" Text="Debug &amp; Protocol Logs"
                       FontWeight="SemiBold" Margin="5,0,0,0" FontSize="22"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"/>
        </StackPanel>

        <ScrollViewer x:Name="LeftContent" Grid.Row="1" Padding="5,0"
                      HorizontalAlignment="Stretch" Grid.ColumnSpan="2">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                <controls:SettingsSectionHeader Glyph="&#xE713;"
                                                Title="Logging"
                                                LocalizationUid="Debug_Logging"/>

                <controls:SettingBox LocalizationUid="Debug_Verbose"
                                     Margin="5"
                                     Header="Verbose Debug Logging"
                                     Text="Enable detailed debug output. May slow down the app.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch x:Name="VerboseLoggingToggle"
                                      IsOn="{Binding IsVerboseLoggingEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Debug_Capture"
                                     Margin="5"
                                     Header="Capture Protocol Traffic"
                                     Text="Record all incoming and outgoing binary nodes.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch x:Name="SessionLoggingToggle"
                                      IsOn="{Binding IsSessionLoggingEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingsSectionHeader Glyph="&#xE9D9;"
                                                Title="Runtime Health"
                                                LocalizationUid="Debug_RuntimeTitle"/>

                <Border Background="{ThemeResource SettingBoxBackgroundBrush}"
                        BorderBrush="{ThemeResource SettingBoxBorderBrush}" BorderThickness="1"
                        CornerRadius="5" Margin="5" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock x:Uid="Debug_RuntimeDesc"
                                   Text="Always-on counters for connection, queues, send, receive and memory. No message text is recorded."
                                   Margin="12,12,12,0"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                                   Opacity="0.9"/>

                        <StackPanel Orientation="Horizontal" Margin="12,12,12,0">
                            <Button x:Uid="Debug_Refresh" Content="Refresh"
                                    Command="{Binding RefreshRuntimeCommand}" Margin="0,0,8,0"/>
                            <Button x:Uid="Debug_SaveReport" Content="Save Diagnostic Report"
                                    Command="{Binding SaveRuntimeReportCommand}" Margin="0,0,8,0"/>
                            <Button x:Uid="Debug_ClearRuntime" Content="Clear Runtime Log"
                                    Command="{Binding ClearRuntimeLogCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RuntimeExportStatusText}" FontSize="12" Opacity="0.7"
                                   Margin="12,8,12,0" TextWrapping="Wrap"
                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>

                        <Border Background="{ThemeResource SettingBoxInsetBackgroundBrush}"
                                BorderBrush="{ThemeResource SettingBoxInsetBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Margin="12,12,12,12" Padding="12">
                            <ScrollViewer Height="340">
                                <TextBlock Text="{Binding RuntimeHealthText}"
                                           FontSize="12" FontFamily="Consolas"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <controls:SettingsSectionHeader Glyph="&#xE8FD;"
                                                Title="Live Stream"
                                                LocalizationUid="Debug_LiveStream"/>

                <Border Background="{ThemeResource SettingBoxBackgroundBrush}"
                        BorderBrush="{ThemeResource SettingBoxBorderBrush}" BorderThickness="1"
                        CornerRadius="5" Margin="5" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,12,12,0">
                            <Button x:Name="SaveSessionLogButton" x:Uid="Debug_SaveLog" Content="Save Log"
                                    Command="{Binding SaveLogCommand}" Margin="0,0,8,0"/>
                            <Button x:Name="ClearSessionLogButton" x:Uid="Debug_ClearLog" Content="Clear"
                                    Command="{Binding ClearLogCommand}"/>
                        </StackPanel>

                        <Border Background="{ThemeResource SettingBoxInsetBackgroundBrush}"
                                BorderBrush="{ThemeResource SettingBoxInsetBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Margin="12,12,12,12" Padding="12">
                            <ScrollViewer x:Name="SessionLogScroller" Height="400">
                                <TextBlock Text="{Binding LogText}"
                                           FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <controls:SettingsSectionHeader Glyph="&#xE90F;"
                                                Title="Actions"
                                                LocalizationUid="Debug_Actions"/>

                <controls:SettingBox LocalizationUid="Debug_WipeBox"
                                     Margin="5"
                                     Header="Wipe Session"
                                     Text="Delete local auth and return to pairing.">
                    <controls:SettingBox.Control>
                        <Button x:Name="DeleteSessionButton" x:Uid="Debug_Wipe" Content="Wipe Session"
                                Background="#E74C3C" Foreground="White" Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding DeleteSessionCommand}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Debug_StatusBox"
                                     Margin="5"
                                     Header="Status"
                                     Text="Package build and architecture.">
                    <controls:SettingBox.Control>
                        <TextBlock Text="{Binding BuildInfoText}"
                                   Margin="10,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
