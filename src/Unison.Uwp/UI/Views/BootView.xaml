<Page
    x:Class="Unison.Uwp.UI.Views.BootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="#FF20C064">

    <!--
      Page + RootGrid start #20C064 (no theme flash under splash).
      When Unison wordmark begins (~1.20s), Page.Background → theme so exit wipe reveals it.
      Frame 0: icon alone, centered — size tracks window short-side (~splash).
      Intro: icon shrinks + slides left; "Unison" fades in.
      Exit: RootGrid floats up to reveal page theme background.
    -->
    <Grid x:Name="RootGrid" Background="#FF20C064">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootGridTranslate" Y="0"/>
        </Grid.RenderTransform>

        <Grid.Resources>
            <Storyboard x:Name="BootIntroStoryboard">
                <DoubleAnimation x:Name="BootIconTranslateXAnim"
                                 Storyboard.TargetName="BootIconTranslate"
                                 Storyboard.TargetProperty="X"
                                 From="0"
                                 BeginTime="0:0:0.40"
                                 Duration="0:0:0.80">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="BootIconScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1" To="0.48"
                                 BeginTime="0:0:0.40"
                                 Duration="0:0:0.80">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="BootIconScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1" To="0.48"
                                 BeginTime="0:0:0.40"
                                 Duration="0:0:0.80">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <!-- After icon settles: fade in wordmark (position set in code to center the pair). -->
                <DoubleAnimation Storyboard.TargetName="BootWordmark"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 BeginTime="0:0:1.20"
                                 Duration="0:0:0.55">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="BootExitStoryboard">
                <DoubleAnimation x:Name="BootExitYAnim"
                                 Storyboard.TargetName="RootGridTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="0"
                                 Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0"
                                 Duration="0:0:0.40">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!-- Icon: screen center; Width/Height set in code to match splash vs window. -->
        <Viewbox x:Name="BootIcon"
                 Width="96"
                 Height="96"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BootIconScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="BootIconTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Image Source="ms-appx:///Assets/Logo/BootLogo.png"
                   Width="200"
                   Height="200"
                   Stretch="Uniform"/>
        </Viewbox>

        <TextBlock x:Name="BootWordmark"
                   Text="Unison"
                   Foreground="White"
                   FontSize="32"
                   FontFamily="{StaticResource MainFontSemibold}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0"
                   CharacterSpacing="40"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="BootWordmarkTranslate" X="0"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <muxc:ProgressBar IsIndeterminate="True"
                          Height="4"
                          VerticalAlignment="Bottom"
                          Margin="0"
                          Foreground="White"
                          Background="#33FFFFFF"
                          BorderThickness="0"
                          ShowError="False"
                          ShowPaused="False"/>
    </Grid>
</Page>
