<UserControl
    x:Class="Unison.Uwp.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SettingsPageBackgroundBrush}">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource SettingsPageBackgroundBrush}"
          Padding="15">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageTriggers">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ExtendedFull">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftContent.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="LeftAbout.Visibility" Value="Visible"/>
                        <Setter Target="BottomAbout.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" MaxWidth="800" MinWidth="290"/>
            <ColumnDefinition Width="0.4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,5,0,0" Opacity="0.8">
            <Button Command="{Binding LeaveCommand}"
                    Style="{StaticResource WhatsAppIconButtonStyle}"
                    Width="34" Height="34" Margin="5,0,0,0"
                    Background="Transparent" Opacity="0.9">
                <FontIcon FontSize="16" FontFamily="{StaticResource IconFont}"
                          Foreground="{StaticResource WhatsAppTextHighBrush}" Glyph="&#xE72B;"/>
            </Button>
            <TextBlock x:Uid="Settings_Title" Text="Configurações"
                       FontWeight="SemiBold" Margin="5,0,0,0" FontSize="22"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"/>
        </StackPanel>

        <ScrollViewer x:Name="LeftContent" Grid.Row="1" Padding="5,0"
                      HorizontalAlignment="Stretch" Grid.ColumnSpan="2">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE713;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Settings_General" Text="Geral" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <controls:SettingBox LocalizationUid="Settings_Notifications"
                                     Margin="5"
                                     Header="Notificações"
                                     Text="Exibir toasts e badge ao receber mensagens.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_LiveTiles"
                                     Margin="5"
                                     Header="Live Tiles"
                                     Text="Atualizar o tile principal com a última mensagem.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      IsOn="{Binding LiveTilesEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_KeepAlive"
                                     Margin="5"
                                     Header="Modo em segundo plano"
                                     Text="Usa geolocalização só para o sistema não congelar o app (Unogram). A posição não é lida nem enviada. Consome mais bateria.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      IsOn="{Binding LocationKeepAliveEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Settings_AutoUnlink"
                                     Margin="5"
                                     Header="Desvincular automaticamente"
                                     Text="Se a sessão for invalidada no telemóvel, limpar dados locais e pedir QR. Desligue para manter o app como backup e só tentar reconectar.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      IsOn="{Binding AutoUnlinkOnLogoutEnabled, Mode=TwoWay}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <!-- Customization (Imgur Appearance) -->
                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE790;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Settings_Customization" Text="Personalização" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <controls:SettingBox LocalizationUid="Settings_Shell"
                                     Margin="5"
                                     Header="Shell"
                                     Text="Escolha o visual do aplicativo.">
                    <controls:SettingBox.Control>
                        <ComboBox x:Name="ShellComboBox"
                                  MinWidth="140"
                                  Margin="0,0,4,0"
                                  SelectionChanged="ShellComboBox_SelectionChanged">
                            <ComboBoxItem Content="Unison"/>
                            <ComboBoxItem Content="WhatsApp"/>
                        </ComboBox>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:AboutControl x:Name="BottomAbout"
                                       HorizontalAlignment="Left"
                                       Margin="5,0,10,20"/>
            </StackPanel>
        </ScrollViewer>

        <controls:AboutControl x:Name="LeftAbout"
                               HorizontalAlignment="Right"
                               Margin="10,39,20,0"
                               MaxWidth="350"
                               Grid.Column="1"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"/>
    </Grid>
</UserControl>
