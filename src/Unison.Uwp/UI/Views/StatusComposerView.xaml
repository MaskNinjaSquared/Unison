<Page
    x:Class="Unison.Uwp.UI.Views.StatusComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="400">

    <!-- Full-screen page (INavigator.NavigateFullScreen). DataContext: StatusComposerViewModel. Floating chrome (privacy pill + circular send). -->
    <Page.Resources>
        <!-- No chrome in any state: only the text and its placeholder. -->
        <Style x:Key="StatusComposerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsSpellCheckEnabled" Value="False"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ContentControl x:Name="PlaceholderTextContentPresenter"
                                            Content="{TemplateBinding PlaceholderText}"
                                            Foreground="White"
                                            Opacity="0.7"
                                            IsHitTestVisible="False"
                                            IsTabStop="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontFamily="{TemplateBinding FontFamily}"/>
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Hidden"
                                          ZoomMode="Disabled"
                                          IsTabStop="False"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPrivacyPillStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="2"
                                CornerRadius="18"
                                Height="36"
                                Padding="14,0"
                                Opacity="0.8">
                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Opacity" Value="0.6"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusSendFabStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{ThemeResource WhatsAppGreenFocusBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="FabRoot">
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="FabRoot.Opacity" Value="0.8"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="FabRoot.Opacity" Value="0.5"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{Binding BackgroundColor, Converter={StaticResource HexColorToBrushConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource ModernIconButtonStyle}"
                    Foreground="White"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource IconFont}"/>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding ToggleEmojiTrayCommand}"
                        AutomationProperties.Name="Emoji">
                    <FontIcon Glyph="{Binding EmojiToggleGlyph}" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleBackgroundCommand}"
                        AutomationProperties.Name="Background color">
                    <FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource ModernIconButtonStyle}"
                        Foreground="White"
                        Margin="4,0,0,0"
                        Command="{Binding CycleFontCommand}"
                        AutomationProperties.Name="Font">
                    <TextBlock Text="Aa"
                               FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}}"
                               FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBox x:Name="StatusTextInput"
                 x:Uid="StatusComposer_Input"
                 Grid.Row="1"
                 Margin="24,16,24,88"
                 VerticalAlignment="Center"
                 MaxLength="700"
                 PlaceholderText="Type a status"
                 Style="{StaticResource StatusComposerTextBoxStyle}"
                 FontFamily="{Binding FontFamilyName, Converter={StaticResource FontFamilyNameConverter}}"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="1"
              VerticalAlignment="Bottom"
              Margin="16,0,16,16">
            <Button HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource StatusPrivacyPillStyle}"
                    Command="{Binding PrivacyCommand}">
                <TextBlock Text="{Binding PrivacyLabel}"
                           FontSize="14"
                           FontFamily="{StaticResource MainFont}"/>
            </Button>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource StatusSendFabStyle}"
                    Command="{Binding SendCommand}"
                    AutomationProperties.Name="Send">
                <FontIcon Glyph="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="20"/>
            </Button>
        </Grid>

        <controls:ChatStickerBox Grid.Row="2"
                                 Visibility="{Binding IsEmojiTrayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</Page>
