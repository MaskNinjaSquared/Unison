<Page
    x:Class="Unison.Uwp.UI.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:Core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:Media="using:Microsoft.Xaml.Interactions.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LoginPageBackgroundBrush}">

    <!--
      Outer scroll = full login body.
      Inner QR scroll MinHeight ≈ QR card (264 + padding) so small screens can always
      bring the full QR into view instead of clipping it permanently.
    -->
    <Grid x:Name="LoginRoot" Background="{ThemeResource LoginPageBackgroundBrush}">
        <Grid.Resources>
            <Storyboard x:Key="LoginEntranceStoryboard">
                <!-- Header + wave: slide from above into place -->
                <DoubleAnimation Storyboard.TargetName="LoginHeaderTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="-190" To="0"
                                 Duration="0:0:0.55">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LoginHeader"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 Duration="0:0:0.35"/>

                <!-- Body: fade in sequence -->
                <DoubleAnimation Storyboard.TargetName="LoginInstructionsBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 BeginTime="0:0:0.28"
                                 Duration="0:0:0.32"/>
                <DoubleAnimation Storyboard.TargetName="LoginPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 BeginTime="0:0:0.42"
                                 Duration="0:0:0.32"/>
                <DoubleAnimation Storyboard.TargetName="LoginFooterBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 BeginTime="0:0:0.56"
                                 Duration="0:0:0.32"/>
                <DoubleAnimation Storyboard.TargetName="LoginVersionFooter"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="0.55"
                                 BeginTime="0:0:0.64"
                                 Duration="0:0:0.28"/>
            </Storyboard>

            <!-- Exit wipe: green #20C064 expands behind the wave as it slides to the bottom. -->
            <Storyboard x:Key="LoginExitStoryboard" x:Name="LoginExitStoryboard">
                <DoubleAnimation x:Name="LoginExitCoverHeightAnim"
                                 Storyboard.TargetName="LoginExitCover"
                                 Storyboard.TargetProperty="Height"
                                 EnableDependentAnimation="True"
                                 Duration="0:0:0.70">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation x:Name="LoginExitWaveYAnim"
                                 Storyboard.TargetName="LoginExitWaveTranslate"
                                 Storyboard.TargetProperty="Y"
                                 Duration="0:0:0.70">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LoginOuterScroll"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 Duration="0:0:0.28"/>
                <DoubleAnimation Storyboard.TargetName="LoginVersionFooter"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 Duration="0:0:0.28"/>
                <DoubleAnimation Storyboard.TargetName="LoginHeaderHost"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 BeginTime="0:0:0.05"
                                 Duration="0:0:0.15"/>
            </Storyboard>
        </Grid.Resources>

        <!-- Imgur-style: Loaded → play Storyboard via XAML behaviors (no code-behind Begin). -->
        <Interactivity:Interaction.Behaviors>
            <Core:EventTriggerBehavior EventName="Loaded">
                <Media:ControlStoryboardAction ControlStoryboardOption="Play"
                                               Storyboard="{StaticResource LoginEntranceStoryboard}"/>
            </Core:EventTriggerBehavior>
            <Core:EventTriggerBehavior EventName="Unloaded">
                <Media:ControlStoryboardAction ControlStoryboardOption="Stop"
                                               Storyboard="{StaticResource LoginEntranceStoryboard}"/>
            </Core:EventTriggerBehavior>
        </Interactivity:Interaction.Behaviors>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header slot: no Clip (W10M Creators clipped the wave under the green).
             Green is a sibling behind the wave (not Grid.Background) so transform
             compositing cannot paint the plate over the SVG. -->
        <Grid x:Name="LoginHeaderHost" Height="175">
            <Grid x:Name="LoginHeader"
                  Height="175"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LoginHeaderTranslate" Y="-190"/>
                </Grid.RenderTransform>

                <!-- Solid green plate (behind wave + logo). -->
                <Border x:Name="LoginHeaderGreen"
                        Background="{ThemeResource LoginHeaderBackgroundBrush}"
                        Height="175"
                        VerticalAlignment="Top"
                        Canvas.ZIndex="0"/>

                <!-- Branding Logo -->
                <StackPanel Canvas.ZIndex="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,40">
                    <Image Source="{ThemeResource LoginHeaderLogoImage}"
                           Width="50"
                           Height="50"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Unison"
                               Margin="10,8,0,0"
                               FontSize="35"
                               FontFamily="{StaticResource MainFontSemibold}"
                               Foreground="{ThemeResource LoginOnAccentForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Wave on top of green plate (page-colored fills carve the edge). -->
                <Viewbox x:Name="LoginHeaderWave"
                         Canvas.ZIndex="2"
                         Stretch="Fill"
                         VerticalAlignment="Bottom"
                         Height="65"
                         Margin="0,0,0,-1">
                    <Canvas Width="123.62135" Height="21.41757">
                        <Canvas.RenderTransform>
                            <TranslateTransform X="-177.99172" Y="-266.48336"/>
                        </Canvas.RenderTransform>
                        <Path Fill="{ThemeResource LoginPageBackgroundBrush}"
      Opacity="0.25098"
      Data="F1 M182.09992,286.57287
      C182.09992,286.57287 185.57603,276.38524 217.54633,276.62025
      241.13221,276.79363 248.31021,279.16699 258.81148,279.15308
      265.8841,279.14371 286.04927,270.99632 294.60232,267.20666
      298.10811,265.65334 301.22339,267.07563 301.56703,267.13872
      301.58596,267.14219 301.61307,267.14924 301.61307,267.14924
      L302.0,279.65169
      L302.0,286.57285
      Z"/>
                        <Path Fill="{ThemeResource LoginPageBackgroundBrush}"
      Data="F1 M177.99172,287.90093
            L177.99172,270.70502
            C177.99172,270.70502 187.46898,280.5197 216.60771,280.51054
            C231.72596,279.28679 242.87046,276.06722 250.67704,273.64616
            C253.44964,272.78629 258.381,270.50118 264.53351,270.48032
            C269.64538,270.48032 276.30807,272.63487 276.79035,272.74877
            C283.96299,274.44278 291.6432,276.70942 296.52108,278.04651
            C299.599,278.89021 301.60608,278.52922 302.0,278.53151
            L302.0,287.90094
            L302.0,287.90094z"/>
                        <Path Fill="{ThemeResource LoginPageBackgroundBrush}" Opacity="0.25098" Data="F1 M178.02356,279.85576C178.02356,279.85576 179.97345,271.98314 196.44966,271.59585 213.65597,271.82415 240.54375,284.84871 240.54375,284.84871 240.54375,284.84871 204.08059,283.72394 193.18189,282.15266 187.25036,281.2975 178.02356,279.85577 178.02356,279.85577z"/>

                    </Canvas>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- Parent scroll: instructions + QR (min-height) + phone footer -->
        <ScrollViewer x:Name="LoginOuterScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      HorizontalScrollMode="Disabled"
                      ZoomMode="Disabled">
            <StackPanel Padding="10,24,10,24" MaxWidth="800" HorizontalAlignment="Center">

                <!-- Phone instructions (sessão telefone / passos) -->
                <controls:LoginInstructionHeader x:Name="LoginInstructionsBlock"
                                                 MaxWidth="360"
                                                 HorizontalAlignment="Center"
                                                 Margin="30,0,30,24"
                                                 Opacity="0"
                                                 SessionResetRequested="LoginInstructionHeader_SessionResetRequested"/>

                <StackPanel x:Name="LoginPanel" HorizontalAlignment="Center" Opacity="0">
                    <controls:LoginQrCodeControl x:Name="QrCodePart"
                                                 Margin="0,0,0,24"
                                                 RefreshRequested="QrCodePart_RefreshRequested"/>
                </StackPanel>

                <!-- Phone / secondary actions (below QR, inside parent scroll) -->
                <StackPanel x:Name="LoginFooterBlock"
                            HorizontalAlignment="Center"
                            Margin="30,8,30,8"
                            Opacity="0">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button x:Name="ShowLogButton"
                                x:Uid="Login_ShowLog"
                                Content="Show diagnostic log"
                                HorizontalAlignment="Center"
                                Command="{Binding ToggleLogPanelCommand}"
                                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                        <Button x:Uid="Login_ShowLogHide"
                                Content="Hide log"
                                HorizontalAlignment="Center"
                                Command="{Binding ToggleLogPanelCommand}"
                                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <controls:LinkPhoneText x:Name="LinkWithPhoneBtn" MaxWidth="210" Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            Command="{Binding LinkWithPhoneCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed footer: version only (same placement as StartView). -->
        <TextBlock x:Name="LoginVersionFooter"
                   Grid.Row="2"
                   Text="{Binding VersionText}"
                   FontSize="12"
                   Opacity="0"
                   HorizontalAlignment="Center"
                   Margin="16,8,16,24"
                   Foreground="{ThemeResource LoginMutedTextBrush}"/>

        <!-- Exit wipe overlay: wave slides down; solid #20C064 fills behind. -->
        <Grid x:Name="LoginExitOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="100"
              IsHitTestVisible="True">
            <Border x:Name="LoginExitCover"
                    Background="#FF20C064"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Height="175"/>
            <Viewbox x:Name="LoginExitWave"
                     Stretch="Fill"
                     Height="65"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Margin="0,110,0,0">
                <Viewbox.RenderTransform>
                    <TranslateTransform x:Name="LoginExitWaveTranslate" Y="0"/>
                </Viewbox.RenderTransform>
                <Canvas Width="123.62135" Height="21.41757">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="-177.99172" Y="-266.48336"/>
                    </Canvas.RenderTransform>
                    <!-- Same wave as header: page color carves the green leading edge. -->
                    <Path Fill="{ThemeResource LoginPageBackgroundBrush}" Opacity="0.25098" Data="F1 M182.09992,286.57287C182.09992,286.57287 185.57603,276.38524 217.54633,276.62025 241.13221,276.79363 248.31021,279.16699 258.81148,279.15308 265.8841,279.14371 286.04927,270.99632 294.60232,267.20666 298.10811,265.65334 301.22339,267.07563 301.56703,267.13872 301.58596,267.14219 301.61307,267.14924 301.61307,267.14924L301.61269,279.65169 298.35932,286.57285z"/>
                    <Path Fill="{ThemeResource LoginPageBackgroundBrush}" Opacity="0.25098" Data="F1 M178.02356,279.85576C178.02356,279.85576 179.97345,271.98314 196.44966,271.59585 213.65597,271.82415 240.54375,284.84871 240.54375,284.84871 240.54375,284.84871 204.08059,283.72394 193.18189,282.15266 187.25036,281.2975 178.02356,279.85577 178.02356,279.85577z"/>
                    <Path Fill="{ThemeResource LoginPageBackgroundBrush}" Data="F1 M177.99172,287.90093L177.99172,270.70502C177.99172,270.70502 187.46898,280.5197 216.60771,280.51054 231.72596,279.28679 242.87046,276.06722 250.67704,273.64616 253.44964,272.78629 258.381,270.50118 264.53351,270.48032 269.64538,270.48032 276.30807,272.63487 276.79035,272.74877 283.96299,274.44278 291.6432,276.70942 296.52108,278.04651 299.599,278.89021 301.60608,278.52922 301.60608,278.53151 301.60594,280.96376 301.60557,287.90094 301.60557,287.90094z"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Overlay do log: cobre a tela inteira para caber texto no celular -->
        <Border x:Name="LogPanel" Grid.RowSpan="3"
                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{ThemeResource LoginLogPanelBackgroundBrush}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Uid="Login_LogTitle" Grid.Row="0" Text="Diagnostic log" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,8"
                           Foreground="{ThemeResource LoginInstructionTitleBrush}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox IsReadOnly="True" AcceptsReturn="True"
                             Text="{Binding DiagnosticLogText, Mode=OneWay}"
                             TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{ThemeResource LoginInstructionTextBrush}"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Uid="Login_ToggleLogOn"
                            Content="Enable log"
                            Margin="0,0,8,0"
                            Command="{Binding ToggleSessionLoggingCommand}"
                            Visibility="{Binding IsSessionLoggingEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                    <Button x:Uid="Login_ToggleLogOff"
                            Content="Disable log"
                            Margin="0,0,8,0"
                            Command="{Binding ToggleSessionLoggingCommand}"
                            Visibility="{Binding IsSessionLoggingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button x:Uid="Login_CloseLog" Content="Fechar"
                            Command="{Binding ToggleLogPanelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
