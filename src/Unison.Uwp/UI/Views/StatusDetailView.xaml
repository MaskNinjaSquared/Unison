<UserControl
    x:Class="Unison.Uwp.UI.Views.StatusDetailView"
    x:Name="StatusDetailRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Unison.Core.ViewModels"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    xmlns:selectors="using:Unison.Uwp.UI.TemplateSelectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="480">

    <UserControl.Resources>
        <DataTemplate x:Key="StatusMediaViewerTemplate">
            <Grid Background="Black">
                <Image x:Name="ViewerImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Visibility="{Binding ViewModel.IsImage, ElementName=StatusDetailRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <MediaElement x:Name="ViewerVideo"
                              Stretch="Uniform"
                              AutoPlay="True"
                              AreTransportControlsEnabled="False"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="{Binding ViewModel.IsVideo, ElementName=StatusDetailRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StatusTextViewerTemplate">
            <Grid Background="{Binding ViewModel.BackgroundColorHex, ElementName=StatusDetailRoot, Converter={StaticResource HexColorToBrushConverter}}">
                <TextBlock Text="{Binding ViewModel.TextBody, ElementName=StatusDetailRoot}"
                           Margin="24,88,24,88"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="32"
                           FontFamily="{Binding ViewModel.FontFamilyName, ElementName=StatusDetailRoot, Converter={StaticResource FontFamilyNameConverter}, ConverterParameter=Emoji}"
                           Foreground="{Binding ViewModel.TextColorHex, ElementName=StatusDetailRoot, Converter={StaticResource HexColorToBrushConverter}}"/>
            </Grid>
        </DataTemplate>

        <selectors:StatusKindTemplateSelector x:Key="StatusKindTemplateSelector"
                                              TextTemplate="{StaticResource StatusTextViewerTemplate}"
                                              MediaTemplate="{StaticResource StatusMediaViewerTemplate}"/>
    </UserControl.Resources>

    <Grid Background="{ThemeResource WhatsAppBackgroundBrush}">
        <Grid x:Name="EmptyState"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              MaxWidth="420"
              Padding="32,24"
              Visibility="{x:Bind ViewModel.HasOpenAuthor, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <StackPanel>
                <FontIcon Glyph="&#xE7C9;"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="100"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"
                          Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
                <TextBlock x:Uid="StatusDetail_EmptyTitle"
                           Text="Share status updates"
                           FontSize="28"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MainFontSemibold}"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Uid="StatusDetail_EmptySubtitle"
                           Text="Share photos, videos and text that disappear after 24 hours."
                           FontSize="14"
                           Margin="0,12,0,0"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ViewerRoot"
              Background="Black"
              Visibility="{x:Bind ViewModel.HasOpenAuthor, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

            <ContentControl x:Name="KindHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{x:Bind ViewModel.CurrentKind, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource StatusKindTemplateSelector}"/>

            <Grid x:Name="PlaceholderHost"
                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="36" Height="36"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>

            <!-- Leave the top chrome clear so Close / Download keep pointer priority over next/prev. -->
            <Grid Margin="0,72,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="Transparent" Tapped="LeftZone_Tapped"/>
                <Rectangle Grid.Column="1" Fill="Transparent" Tapped="RightZone_Tapped"/>
            </Grid>

            <!-- Bottom views chip (camera flash chrome). -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    CornerRadius="15"
                    MaxHeight="30"
                    Background="#99000000"
                    Padding="10,4"
                    Canvas.ZIndex="2">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE890;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="16"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="{x:Bind ViewModel.ViewCount, Mode=OneWay}"
                               FontSize="14"
                               FontFamily="{StaticResource MainFontSemibold}"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid VerticalAlignment="Top"
                  Padding="8,8,8,16"
                  Canvas.ZIndex="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl x:Name="SegmentsHost"
                              ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                              SizeChanged="SegmentsHost_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusProgressSegment">
                            <Grid Height="3" Margin="1.5,0" VerticalAlignment="Center">
                                <Border Width="{x:Bind TrackWidth, Mode=OneWay}"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="#4DFFFFFF"/>
                                <Border Width="{x:Bind FillWidth, Mode=OneWay}"
                                        Height="3"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Background="White"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                            Style="{StaticResource CircleIconButtonStyle}"
                            Width="34" Height="34"
                            Margin="4,0,8,0"
                            VerticalAlignment="Top"
                            Content="&#xE72B;"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock helpers:EmojiTextBlock.Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock Text="{x:Bind ViewModel.TimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="#B3FFFFFF"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Uid="StatusDetail_Download"
                            Command="{x:Bind ViewModel.DownloadCommand, Mode=OneWay}"
                            Style="{StaticResource CircleIconButtonStyle}"
                            Width="34" Height="34"
                            Margin="8,0,4,0"
                            VerticalAlignment="Top"
                            Content="&#xE896;"
                            Visibility="{x:Bind ViewModel.CanDownload, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="#CC111111"
                    Padding="16,12,16,16"
                    Visibility="{x:Bind ViewModel.HasCaption, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock helpers:EmojiTextBlock.Text="{x:Bind ViewModel.Caption, Mode=OneWay}"
                           FontSize="15"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="5"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
