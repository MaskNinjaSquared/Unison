<UserControl
    x:Class="Unison.Uwp.UI.Views.StatusDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Unison.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="480">

    <Grid Background="{ThemeResource WhatsAppBackgroundBrush}">
        <Grid x:Name="EmptyState"
              Visibility="{x:Bind ViewModel.HasOpenAuthor, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

        <Grid x:Name="ViewerRoot"
              Background="Black"
              Visibility="{x:Bind ViewModel.HasOpenAuthor, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Image x:Name="ViewerImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <MediaElement x:Name="ViewerVideo"
                          Stretch="Uniform"
                          AutoPlay="True"
                          AreTransportControlsEnabled="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MediaOpened="ViewerVideo_MediaOpened"
                          MediaEnded="ViewerVideo_MediaEnded"
                          Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Grid x:Name="PlaceholderHost"
                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="36" Height="36"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="Transparent" Tapped="LeftZone_Tapped"/>
                <Rectangle Grid.Column="1" Fill="Transparent" Tapped="RightZone_Tapped"/>
            </Grid>

            <Grid VerticalAlignment="Top" Padding="8,8,8,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl x:Name="SegmentsHost"
                              ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                              SizeChanged="SegmentsHost_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusProgressSegment">
                            <Grid Height="3" Margin="1.5,0" VerticalAlignment="Center">
                                <Border Width="{x:Bind TrackWidth, Mode=OneWay}"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="#4DFFFFFF"/>
                                <Border Width="{x:Bind FillWidth, Mode=OneWay}"
                                        Height="3"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Background="White"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                            Width="34" Height="34"
                            Margin="4,0,8,0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <Grid Width="34" Height="34">
                            <Ellipse Fill="#E6232424"/>
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="WhiteSmoke"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock Text="{x:Bind ViewModel.TimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   FontFamily="{StaticResource MainFont}"
                                   Foreground="#B3FFFFFF"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="#CC111111"
                    Padding="16,12,16,16"
                    Visibility="{x:Bind ViewModel.HasCaption, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.Caption, Mode=OneWay}"
                           FontSize="15"
                           FontFamily="{StaticResource MainFont}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="5"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
