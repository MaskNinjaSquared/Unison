<UserControl
    x:Class="Unison.Uwp.UI.Views.StatusListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Unison.Core.Models"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <Grid Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="StatusList_Header"
                       Text="Status"
                       FontSize="24"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="FilterButton"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Filter status">
                    <FontIcon Glyph="&#xEA01;"
                              FontFamily="{StaticResource UnisonIconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                            <MenuFlyoutItem x:Uid="StatusList_FilterHeader"
                                            Text="Filter status by"
                                            Style="{StaticResource ModernMenuFlyoutHeaderStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterAll"
                                            Text="All"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="0"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterRecent"
                                            Text="Recent"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="1"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterViewed"
                                            Text="Viewed"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="2"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="MenuButton"
                        Click="MenuButton_Click"
                        Style="{StaticResource ModernIconButtonStyle}">
                    <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="AuthorList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Authors, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                  SelectionMode="Single"
                  SelectionChanged="AuthorList_SelectionChanged">
            <ListView.Header>
                <StackPanel>
                    <Button Command="{x:Bind ViewModel.NewStatusCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            MinHeight="0"
                            MinWidth="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Height="72" Padding="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Same footprint as StatusListAvatarControl (56 outer / 48 photo). -->
                            <Grid Width="56" Height="56"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <controls:ChatAvatarControl Width="48" Height="48"
                                                            Size="48"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            AvatarUrl="{x:Bind ViewModel.SelfAvatarUrl, Mode=OneWay}"/>
                                <!-- Visual-only green plus badge (not interactive). -->
                                <Grid Width="22" Height="22"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,0"
                                      IsHitTestVisible="False">
                                    <Ellipse Fill="{ThemeResource WhatsAppGreenFocusBrush}"/>
                                    <FontIcon Glyph="&#xE710;"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="11"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                <TextBlock x:Uid="StatusList_MyStatus"
                                           Text="My status"
                                           FontSize="18"
                                           FontFamily="{StaticResource MainFontSemibold}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Uid="StatusList_MyStatusHint"
                                           Text="Tap to update your status…"
                                           FontSize="13"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource MainFont}"
                                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Uid="StatusList_RecentHeader"
                               Text="RECENT"
                               Margin="16,12,16,8"
                               FontSize="13"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                               CharacterSpacing="40"/>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StatusAuthorItem">
                    <Grid Height="72" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:StatusListAvatarControl Width="56" Height="56"
                                                          Size="56"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          AvatarUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                                                          ViewState="{x:Bind ViewState, Mode=OneWay}"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewStateCaption, Mode=OneWay}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       FontFamily="{StaticResource MainFont}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind LatestTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   x:Uid="StatusList_Empty"
                   Text="No recent status updates"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                   FontFamily="{StaticResource MainFont}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Grid.Row="1"
              Background="{ThemeResource ChatListBackgroundBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:ModernProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Uid="ChatList_Loading"
                           Text="Preparing conversations…"
                           FontSize="14"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           FontFamily="{StaticResource MainFont}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
