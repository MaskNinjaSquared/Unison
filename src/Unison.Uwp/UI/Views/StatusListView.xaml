<UserControl
    x:Class="Unison.Uwp.UI.Views.StatusListView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Unison.Core.Models"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="400">

    <Grid Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StatusSectionBackButton"
                        Click="StatusSectionBackButton_Click"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Width="40" Height="40"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Back">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="18"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </Button>
                <TextBlock x:Uid="StatusList_Header"
                           Text="Status"
                           FontSize="24"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Before filter: same Photo & video / Text flyout as the My status row "+". -->
                <Button x:Name="NewStatusHeaderButton"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Add status">
                    <FontIcon Glyph="&#xE710;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                            <MenuFlyoutItem x:Uid="StatusList_NewMediaStatus"
                                            Text="Photo &amp; video"
                                            Command="{x:Bind ViewModel.StartMediaStatusCommand}"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_NewTextStatus"
                                            Text="Text"
                                            Command="{x:Bind ViewModel.StartTextStatusCommand}"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="FilterButton"
                        Style="{StaticResource ModernIconButtonStyle}"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Filter status">
                    <FontIcon Glyph="&#xEA01;"
                              FontFamily="{StaticResource UnisonIconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                            <MenuFlyoutItem x:Uid="StatusList_FilterHeader"
                                            Text="Filter status by"
                                            Style="{StaticResource ModernMenuFlyoutHeaderStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterAll"
                                            Text="All"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="0"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterRecent"
                                            Text="Recent"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="1"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_FilterViewed"
                                            Text="Viewed"
                                            Command="{x:Bind ViewModel.FilterStatusCommand}"
                                            CommandParameter="2"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="MenuButton"
                        Click="MenuButton_Click"
                        Style="{StaticResource ModernIconButtonStyle}">
                    <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="AuthorList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Authors, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                  SelectionMode="Single"
                  SelectionChanged="AuthorList_SelectionChanged">
            <ListView.Header>
                <StackPanel>
                    <!-- My status row in the list item design (ring, title, caption, time) + "+". -->
                    <ListViewItem x:Name="MyStatusItem"
                                  Style="{StaticResource WhatsAppChatListItemStyle}">
                    <Grid Height="72"
                          Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                            <controls:StatusListAvatarControl x:Name="MyStatusRing"
                                                              Width="56" Height="56"
                                                              Size="56"/>
                            <Grid x:Name="MyStatusPlainAvatar">
                                <controls:ChatAvatarControl Width="48" Height="48"
                                                            Size="48"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            AvatarUrl="{x:Bind ViewModel.SelfAvatarUrl, Mode=OneWay}"/>
                            </Grid>

                            <!-- "+" badge over the photo; its own tap never opens the viewer. -->
                            <Button x:Name="AddStatusButton"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="0"
                                    MinHeight="0"
                                    MinWidth="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Tapped="AddStatusButton_Tapped"
                                    AutomationProperties.Name="Add status">
                                <Button.Flyout>
                                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                                        <MenuFlyoutItem x:Uid="StatusList_NewMediaStatus"
                                                        Text="Photo &amp; video"
                                                        Command="{x:Bind ViewModel.StartMediaStatusCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_NewTextStatus"
                                                        Text="Text"
                                                        Command="{x:Bind ViewModel.StartTextStatusCommand}"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Ellipse Fill="{StaticResource StatusRecentRingBrush}"
                                             Stroke="{ThemeResource ChatListBackgroundBrush}"
                                             StrokeThickness="2"/>
                                    <FontIcon Glyph="&#xE710;"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="11"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <TextBlock x:Uid="StatusList_MyStatus"
                                       Text="My status"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MyStatusCaption"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       FontFamily="{StaticResource MainFont}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock x:Name="MyStatusTime"
                                   Grid.Column="2"
                                   FontSize="12"
                                   Opacity="0.85"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>

                    </Grid>
                    </ListViewItem>

                    <TextBlock x:Uid="StatusList_RecentHeader"
                               Text="RECENT"
                               Margin="16,12,16,8"
                               FontSize="13"
                               FontFamily="{StaticResource MainFontSemibold}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                               CharacterSpacing="40"/>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StatusAuthorItem">
                    <Grid Height="72" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:StatusListAvatarControl Width="56" Height="56"
                                                          Size="56"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          AvatarUrl="{x:Bind AvatarUrl, Mode=OneWay}"
                                                          ViewState="{x:Bind ViewState, Mode=OneWay}"
                                                          Kind="{x:Bind LatestKind, Mode=OneWay}"
                                                          BackgroundArgb="{x:Bind BackgroundArgb, Mode=OneWay}"
                                                          TextArgb="{x:Bind TextArgb, Mode=OneWay}"
                                                          PreviewText="{x:Bind PreviewBody, Mode=OneWay}"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                            <TextBlock helpers:EmojiTextBlock.Text="{x:Bind DisplayName, Mode=OneWay}"
                                       FontSize="18"
                                       FontFamily="{StaticResource MainFontSemibold}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewStateCaption, Mode=OneWay}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,2,0,0"
                                       FontFamily="{StaticResource MainFont}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind LatestTimestampUtc, Mode=OneWay, Converter={StaticResource RelativeTimestampConverter}}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   x:Uid="StatusList_Empty"
                   Text="No recent status updates"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                   FontFamily="{StaticResource MainFont}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Grid.Row="1"
              Background="{ThemeResource ChatListBackgroundBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:ModernProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Uid="ChatList_Loading"
                           Text="Preparing conversations…"
                           FontSize="14"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           FontFamily="{StaticResource MainFont}"/>
            </StackPanel>
        </Grid>

        <!-- My status page: same chrome as the community hub; one row per own status with its views. -->
        <Grid x:Name="MyStatusPanel"
              Grid.RowSpan="2"
              Visibility="{x:Bind ViewModel.IsMyStatusOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{ThemeResource ChatListBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="{ThemeResource ChatListSearchBackgroundBrush}"
                  Padding="4,10,8,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Click="MyStatusBackButton_Click"
                        Style="{StaticResource ModernIconButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="4,0,4,0"
                        AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </Button>

                <TextBlock Grid.Column="1"
                           x:Uid="StatusList_MyStatusPageTitle"
                           Text="My status"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontFamily="{StaticResource MainFontSemibold}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                <Button x:Name="MyStatusNewStatusButton"
                        Grid.Column="2"
                        Style="{StaticResource ModernIconButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Add status">
                    <FontIcon Glyph="&#xE710;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}">
                            <MenuFlyoutItem x:Uid="StatusList_NewMediaStatus"
                                            Text="Photo &amp; video"
                                            Command="{x:Bind ViewModel.StartMediaStatusCommand}"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                            <MenuFlyoutItem x:Uid="StatusList_NewTextStatus"
                                            Text="Text"
                                            Command="{x:Bind ViewModel.StartTextStatusCommand}"
                                            Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="MyStatusMenuButton"
                        Grid.Column="3"
                        Click="MenuButton_Click"
                        Style="{StaticResource ModernIconButtonStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="More options">
                    <FontIcon Glyph="&#xE712;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="18"
                              Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </Button>
            </Grid>

            <ListView x:Name="OwnStatusList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.OwnStatuses, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource WhatsAppChatListItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OwnStatusList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:OwnStatusItem">
                        <Grid Height="72" Padding="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:StatusListAvatarControl Width="48" Height="48"
                                                              Size="48"
                                                              ShowRing="False"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              AvatarUrl="{x:Bind ThumbnailUri}"
                                                              Kind="{x:Bind Kind}"
                                                              BackgroundArgb="{x:Bind BackgroundArgb}"
                                                              TextArgb="{x:Bind TextArgb}"
                                                              PreviewText="{x:Bind Body}"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                <TextBlock Text="{x:Bind ViewCountText, Mode=OneWay}"
                                           FontSize="18"
                                           FontFamily="{StaticResource MainFontSemibold}"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind TimestampUtc, Converter={StaticResource ElapsedTimeConverter}}"
                                           FontSize="13"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource MainFont}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ModernIconButtonStyle}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="More options">
                                <FontIcon Glyph="&#xE712;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="18"
                                          Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource ModernMenuFlyoutStyle}"
                                                Opening="OwnStatusMoreFlyout_Opening">
                                        <MenuFlyoutItem x:Uid="StatusList_OwnForward"
                                                        Text="Forward"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnSave"
                                                        Text="Save"
                                                        Click="OwnStatusSave_Click"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnShare"
                                                        Text="Share"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                        <MenuFlyoutItem x:Uid="StatusList_OwnDelete"
                                                        Text="Delete"
                                                        Style="{StaticResource ModernMenuFlyoutItemStyle}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
