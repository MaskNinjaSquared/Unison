<UserControl
    x:Class="Unison.Uwp.UI.Views.DebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    Background="{ThemeResource DebugPageBackgroundBrush}">

    <!-- Same shell geometry as SettingsView: columns, header margins, scroll padding. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource DebugPageBackgroundBrush}"
          Padding="15">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageTriggers">
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Extended">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" MaxWidth="800" MinWidth="290"/>
            <ColumnDefinition Width="0.4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,5,0,0" Opacity="0.8">
            <Button x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource WhatsAppIconButtonStyle}"
                    Width="34" Height="34" Margin="5,0,0,0"
                    Background="Transparent" Opacity="0.9">
                <FontIcon FontSize="16" FontFamily="{StaticResource IconFont}"
                          Foreground="{StaticResource WhatsAppTextHighBrush}" Glyph="&#xE72B;"/>
            </Button>
            <TextBlock x:Uid="Debug_Title" Text="Debug &amp; Protocol Logs"
                       FontWeight="SemiBold" Margin="5,0,0,0" FontSize="22"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"/>
        </StackPanel>

        <ScrollViewer x:Name="LeftContent" Grid.Row="1" Padding="5,0"
                      HorizontalAlignment="Stretch" Grid.ColumnSpan="2">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE713;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Debug_Logging" Text="Logging" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <controls:SettingBox LocalizationUid="Debug_Verbose"
                                     Margin="5"
                                     Header="Verbose Debug Logging"
                                     Text="Enable detailed debug output. May slow down the app.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch x:Name="VerboseLoggingToggle"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      Toggled="VerboseLoggingToggle_Toggled"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Debug_Capture"
                                     Margin="5"
                                     Header="Capture Protocol Traffic"
                                     Text="Record all incoming and outgoing binary nodes.">
                    <controls:SettingBox.Control>
                        <ToggleSwitch x:Name="SessionLoggingToggle"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      Toggled="SessionLoggingToggle_Toggled"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE9D9;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Debug_RuntimeTitle" Text="Runtime Health" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <Border Background="#1E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1"
                        CornerRadius="5" Margin="5" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock x:Uid="Debug_RuntimeDesc"
                                   Text="Always-on counters for connection, queues, send, receive and memory. No message text is recorded."
                                   Margin="12,12,12,0"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource WhatsAppTextMediumBrush}"
                                   Opacity="0.9"/>

                        <StackPanel Orientation="Horizontal" Margin="12,12,12,0">
                            <Button x:Uid="Debug_Refresh" Content="Refresh" Click="RefreshRuntimeButton_Click" Margin="0,0,8,0"/>
                            <Button x:Uid="Debug_SaveReport" Content="Save Diagnostic Report" Click="SaveRuntimeReportButton_Click" Margin="0,0,8,0"/>
                            <Button x:Uid="Debug_ClearRuntime" Content="Clear Runtime Log" Click="ClearRuntimeLogButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RuntimeExportStatusText" Text="" FontSize="12" Opacity="0.7"
                                   Margin="12,8,12,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource WhatsAppTextMediumBrush}"/>

                        <Border Background="#161616" BorderBrush="#30FFFFFF" BorderThickness="1"
                                CornerRadius="4" Margin="12,12,12,12" Padding="12">
                            <ScrollViewer Height="340">
                                <TextBlock x:Name="RuntimeHealthText" x:Uid="Debug_Collecting"
                                           Text="Collecting runtime state..." FontSize="12" FontFamily="Consolas"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE8FD;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Debug_LiveStream" Text="Live Stream" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <Border Background="#1E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1"
                        CornerRadius="5" Margin="5" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,12,12,0">
                            <Button x:Name="SaveSessionLogButton" x:Uid="Debug_SaveLog" Content="Save Log"
                                    Click="SaveSessionLogButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="ClearSessionLogButton" x:Uid="Debug_ClearLog" Content="Clear"
                                    Click="ClearSessionLogButton_Click"/>
                        </StackPanel>

                        <Border Background="#161616" BorderBrush="#30FFFFFF" BorderThickness="1"
                                CornerRadius="4" Margin="12,12,12,12" Padding="12">
                            <ScrollViewer x:Name="SessionLogScroller" Height="400">
                                <TextBlock x:Name="SessionLogText" Text="Waiting for packets..."
                                           FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="5,20,0,5">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,8,0"
                              Glyph="&#xE90F;" Foreground="{StaticResource WhatsAppTextHighBrush}"/>
                    <TextBlock x:Uid="Debug_Actions" Text="Actions" FontWeight="SemiBold" FontSize="17"
                               Foreground="{StaticResource WhatsAppTextHighBrush}"
                               FontFamily="{StaticResource MainFontSemibold}"/>
                </StackPanel>

                <controls:SettingBox LocalizationUid="Debug_Crypto"
                                     Margin="5"
                                     Header="Commands"
                                     Text="Run a local crypto self-check.">
                    <controls:SettingBox.Control>
                        <Button x:Name="TestDHButton" Content="Test Crypto" Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Click="TestDHButton_Click"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Debug_WipeBox"
                                     Margin="5"
                                     Header="Wipe Session"
                                     Text="Delete local auth and return to pairing.">
                    <controls:SettingBox.Control>
                        <Button x:Name="DeleteSessionButton" x:Uid="Debug_Wipe" Content="Wipe Session"
                                Background="#E74C3C" Foreground="White" Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Click="DeleteSessionButton_Click"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>

                <controls:SettingBox LocalizationUid="Debug_StatusBox"
                                     Margin="5"
                                     Header="Status"
                                     Text="Package build and architecture.">
                    <controls:SettingBox.Control>
                        <TextBlock x:Name="BuildInfoText" Text="Build: v1.0.0 Debug"
                                   Margin="10,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource WhatsAppTextMediumBrush}"/>
                    </controls:SettingBox.Control>
                </controls:SettingBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
