<Page
    x:Class="Unison.Uwp.UI.Views.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Unison.Uwp.UI.Views"
    Background="{StaticResource WhatsAppBackgroundBrush}">

    <Grid x:Name="RootContentGrid" Background="{StaticResource WhatsAppBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChatPaneStates">
                <VisualState x:Name="WideBoth">
                    <VisualState.Setters>
                        <Setter Target="Column0.Width" Value="380"/>
                        <Setter Target="Column0.MaxWidth" Value="400"/>
                        <Setter Target="Column1.Width" Value="*"/>
                        <Setter Target="ChatListPart.Visibility" Value="Visible"/>
                        <Setter Target="ChatDetailPart.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="Column0.Width" Value="*"/>
                        <Setter Target="Column0.MaxWidth" Value="10000"/>
                        <Setter Target="Column1.Width" Value="0"/>
                        <Setter Target="ChatListPart.Visibility" Value="Visible"/>
                        <Setter Target="ChatDetailPart.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="Column0.Width" Value="0"/>
                        <Setter Target="Column0.MaxWidth" Value="10000"/>
                        <Setter Target="Column1.Width" Value="*"/>
                        <Setter Target="ChatListPart.Visibility" Value="Collapsed"/>
                        <Setter Target="ChatDetailPart.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Column0" Width="320" MaxWidth="400"/>
            <ColumnDefinition x:Name="Column1" Width="*"/>
        </Grid.ColumnDefinitions>

        <views:ChatListView x:Name="ChatListPart"
                            MenuClicked="ChatListPart_MenuClicked"
                            ChatSelected="ChatListPart_ChatSelected"/>
        <views:ChatDetailView x:Name="ChatDetailPart" Grid.Column="1"/>
    </Grid>
</Page>
