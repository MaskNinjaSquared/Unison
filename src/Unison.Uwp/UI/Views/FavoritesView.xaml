<Page
    x:Class="Unison.Uwp.UI.Views.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unison.Uwp.UI.Controls"
    xmlns:helpers="using:Unison.Core.Helpers"
    xmlns:models="using:Unison.Core.Models"
    xmlns:templates="using:Unison.Uwp.UI.Templates"
    xmlns:conv="using:Unison.Uwp.UI.Converters"
    Background="{ThemeResource WhatsAppBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:ChatItemTemplates/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="FavoriteGroupHeaderTemplate" x:DataType="helpers:AlphabetChatGroup">
                <TextBlock Text="{x:Bind Key}"
                           Margin="16,8,16,4"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"/>
            </DataTemplate>

            <DataTemplate x:Key="FavoriteZoomedOutTemplate" x:DataType="helpers:AlphabetChatGroup">
                <Border Width="48" Height="48" Margin="4">
                    <TextBlock Text="{x:Bind Key}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ChatListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="Favorites_Header"
                       Text="Favorites"
                       FontSize="24"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"
                       FontFamily="{StaticResource MainFontSemibold}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <Border Grid.Column="1"
                    x:Name="SortChip"
                    Padding="10,4"
                    Margin="0,0,4,0"
                    CornerRadius="12"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="SortLabelText"
                           Text="A-Z"
                           FontSize="13"
                           Foreground="{ThemeResource WhatsAppTextMediumBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <Button x:Name="AddFavoriteHeaderButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.OpenPickerCommand}"
                    Style="{StaticResource ModernIconButtonStyle}"
                    Visibility="Collapsed"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>

            <Button x:Name="MenuButton"
                    Grid.Column="3"
                    Click="MenuButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <controls:FavoritesEmptyControl
                x:Name="EmptyState"
                AddCommand="{x:Bind ViewModel.OpenPickerCommand}"/>

            <SemanticZoom x:Name="FavoritesZoom" Visibility="Collapsed">
                <SemanticZoom.ZoomedInView>
                    <ListView x:Name="FavoritesList"
                              IsItemClickEnabled="True"
                              ItemClick="FavoritesList_ItemClick"
                              SelectionMode="None"
                              Background="Transparent"
                              ItemTemplate="{StaticResource ChatItemTemplate}">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource FavoriteGroupHeaderTemplate}"/>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </SemanticZoom.ZoomedInView>
                <SemanticZoom.ZoomedOutView>
                    <GridView x:Name="FavoritesJumpList"
                              ItemTemplate="{StaticResource FavoriteZoomedOutTemplate}"
                              SelectionMode="None"/>
                </SemanticZoom.ZoomedOutView>
            </SemanticZoom>

            <controls:ContactsVisualizerControl
                x:Name="PickerOverlay"
                Canvas.ZIndex="10"
                IsOpen="{x:Bind ViewModel.IsPickerOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.PickerTitle, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.PickerCandidates, Mode=OneWay}"
                ItemClickCommand="{x:Bind ViewModel.AddFavoriteCommand}"
                BackCommand="{x:Bind ViewModel.ClosePickerCommand}"/>
        </Grid>
    </Grid>
</Page>
