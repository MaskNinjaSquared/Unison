<Page
    x:Class="Unison.Uwp.UI.Views.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Welcome screen (logged-out only). Get started → Login/QR. -->
    <Grid x:Name="WelcomeScreenContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable hero + CTA (survives landscape / short height). -->
        <ScrollViewer x:Name="WelcomeScroll"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled"
                      ZoomMode="Disabled">
            <!-- MinHeight = viewport so content stays centered when it fits; scrolls when it doesn't. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=WelcomeScroll}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Padding="32,28,32,20">
                    <Image Source="ms-appx:///Assets/Backgrounds/tos-update.png"
                           MaxWidth="327"
                           MaxHeight="335"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                    <TextBlock x:Name="Title"
                               x:Uid="Start_Title"
                               Text="Welcome to Unison"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock x:Name="Description"
                               x:Uid="Start_Description"
                               Text="A simple, reliable way to use WhatsApp on Windows."
                               FontSize="15"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource WhatsAppTextHighBrush}"
                               Margin="0,0,0,28"/>

                    <Button x:Name="BtnStart"
                            x:Uid="Start_GetStarted"
                            Content="Get started"
                            MinWidth="200"
                            HorizontalAlignment="Center"
                            Padding="28,12"
                            FontSize="15"
                            Margin="0,0,0,12"
                            Background="{ThemeResource WhatsAppGreenFocusBrush}"
                            Foreground="White"
                            Command="{Binding GetStartedCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Fixed footer: language + version (always visible). -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    Padding="16,8,16,24">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="25,0,0,10">
                <TextBlock x:Uid="Start_Language"
                           Text="Language:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource WhatsAppGreenFocusBrush}"
                           Margin="0,0,2,0"/>
                <ComboBox x:Name="LanguageComboBox"
                          Style="{StaticResource TransparentComboBoxStyle}"
                          Opacity="0.72"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <!-- Scoped lightweight styling (avoids page ThemeDictionaries). -->
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>
                        <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                    </ComboBox.Resources>
                </ComboBox>
            </StackPanel>

            <TextBlock x:Name="AppVersion"
                       Text="{Binding AppVersion}"
                       FontSize="12"
                       Opacity="0.55"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource WhatsAppTextHighBrush}"/>
        </StackPanel>
    </Grid>
</Page>
