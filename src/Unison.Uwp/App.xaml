<Application
    x:Class="Unison.Uwp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.Uwp"
    xmlns:converters="using:Unison.Uwp.UI.Converters"
    xmlns:helpers="using:Unison.Uwp.UI.Helpers">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 2 controls/styles (Imgur: XamlControlsResources).
                     ContentDialogMaxWidth must live inside XamlControlsResources or the
                     stock template keeps the ~548 default (SettingsDialog needs 600–960).
                     Use muxc: prefix — do not redefine default xmlns or ResourceDictionary breaks. -->
                <muxc:XamlControlsResources xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
                    <muxc:XamlControlsResources.MergedDictionaries>
                        <ResourceDictionary>
                            <!-- Raise width ceiling only — keep default-ish height so dialogs stay centered. -->
                            <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
                        </ResourceDictionary>
                    </muxc:XamlControlsResources.MergedDictionaries>
                </muxc:XamlControlsResources>
                <!-- Default shell theme; App.ApplySelectedShellTheme may swap Unison ↔ WhatsApp. -->
                <ResourceDictionary Source="Themes/Unison/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- AvatarFallback* / AvatarBorderBrush live in Themes/*/Styles.xaml ThemeDictionaries.
                 Do not redefine them here — Application ThemeDictionaries win over MergedDictionaries. -->

            <!-- Converters -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
            <converters:InvertedStringToVisibilityConverter x:Key="InvertedStringToVisibilityConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
            <converters:ChatPreviewKindToLabelConverter x:Key="ChatPreviewKindToLabelConverter"/>
            <converters:ChatPreviewKindToBrushConverter x:Key="ChatPreviewKindToBrushConverter"/>
            <converters:RelativeTimestampConverter x:Key="RelativeTimestampConverter"/>
            <converters:LocalTimeConverter x:Key="LocalTimeConverter"/>
            <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
            <converters:BoolToDesktopCursorKindConverter x:Key="BoolToDesktopCursorKindConverter"/>
            
            <!-- Custom Fonts -->
            <FontFamily x:Key="MainFont">ms-appx:///Assets/Fonts/SegUIVar-Regular.ttf#Segoe UI Variable</FontFamily>
            <FontFamily x:Key="MainFontRegularDisplay">ms-appx:///Assets/Fonts/SegUIVar-Regular.ttf#Segoe UI Variable</FontFamily>
            <FontFamily x:Key="MainFontBold">ms-appx:///Assets/Fonts/SegUIVar-Bold_Text.ttf#Segoe UI Variable Bold</FontFamily>
            <FontFamily x:Key="MainFontSemibold">ms-appx:///Assets/Fonts/SegUIVar-Semibold_Text.ttf#Segoe UI Variable Semibold</FontFamily>
            <FontFamily x:Key="IconFont">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
            <!-- Custom PathIcon geometries (filter EA01, new-chat EA02, check EA03, double-check EA04). Regen: scripts/icons/generate-unison-icons.ps1 -->
            <FontFamily x:Key="UnisonIconFont">ms-appx:///Assets/Fonts/UnisonIcons.ttf#UnisonIcons</FontFamily>

            <!-- Branding Colors -->
            <SolidColorBrush x:Key="UnisonGreenBrush" Color="#FF20C064"/>
            <SolidColorBrush x:Key="UnisonGreenBrightBrush" Color="#FF3DCA75"/>
            <SolidColorBrush x:Key="TextBoxBackgroundThemeBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TextBoxFocusedBackgroundThemeBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TextBoxButtonBackgroundThemeBrush" Color="Transparent"/>

            <!-- Global Styles -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
                <Setter Property="helpers:DesktopCursor.CursorKind" Value="Hand"/>
            </Style>
            <Style TargetType="HyperlinkButton">
                <Setter Property="helpers:DesktopCursor.CursorKind" Value="Hand"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
