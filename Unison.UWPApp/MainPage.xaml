<Page
    x:Class="Unison.UWPApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unison.UWPApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Unison.UWPApp.UI.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">
    
    <Page.Resources>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChatListPart.Visibility" Value="Visible"/>
                        <Setter Target="ChatDetailPart.Visibility" Value="Visible"/>
                        <Setter Target="RootSplitView.DisplayMode" Value="Inline"/>
                        <Setter Target="RootSplitView.IsPaneOpen" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChatDetailPart.Visibility" Value="Collapsed"/>
                        <Setter Target="RootSplitView.DisplayMode" Value="Overlay"/>
                        <Setter Target="RootSplitView.IsPaneOpen" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Overlay (Visible when not logged in or during pairing) - Hidden by default to prevent flash -->
        <Grid x:Name="MainOverlay" Visibility="Collapsed">
            <views:LoginView x:Name="LoginPart"/>
            
            <!-- Shims for legacy code references if any remain during transition -->
            <StackPanel Visibility="Collapsed">
                <Grid x:Name="LoginPanel"/><Grid x:Name="QRPairingPanel"/><Grid x:Name="ReconnectingPanel"/>
                <Grid x:Name="QRCodeBorder"/><Grid x:Name="QRPlaceholder"/><TextBlock x:Name="QRStatusText"/>
                <TextBlock x:Name="StatusDetail"/><TextBlock x:Name="StatusText"/>
                <Image x:Name="QRCodeImage"/><Grid x:Name="QRProgress"/>
                <Button x:Name="ReloadQRButton"/><Button x:Name="GenerateQRButton"/>
            </StackPanel>
        </Grid>

        <!-- Main Layout (Visible when logged in) -->
        <SplitView x:Name="RootSplitView" 
                   DisplayMode="Inline" 
                   IsPaneOpen="True" 
                   OpenPaneLength="260"
                   PaneBackground="{StaticResource WhatsAppSidebarBrush}"
                   Visibility="Collapsed">
            <SplitView.Pane>
                <Grid Background="{StaticResource WhatsAppSidebarBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top: WhatsApp Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Height="36" Margin="16,8,0,0">
                        <Image Source="ms-appx:///Assets/WhatsAppLogo.png" 
                               Width="24" Height="24" 
                               VerticalAlignment="Center"/>
                        <TextBlock Text="WhatsApp" 
                                   VerticalAlignment="Center" 
                                   Margin="12,0,0,0" 
                                   FontSize="13" 
                                   Foreground="{ThemeResource WhatsAppTextHighBrush}" 
                                   FontFamily="{StaticResource MainFontSemibold}"/>
                    </StackPanel>

                    <!-- Hamburger Menu -->
                    <Button x:Name="HamburgerButton"
                            Grid.Row="1" 
                            Style="{StaticResource WhatsAppIconButtonStyle}" 
                            HorizontalAlignment="Left" 
                            Margin="8,4"
                            Width="40" Height="40"
                            Click="HamburgerButton_Click">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                    </Button>
                    
                    <!-- Primary Navigation -->
                    <ListView x:Name="NavListView" 
                              Grid.Row="2" 
                              SelectionMode="Single" 
                              SelectionChanged="NavListView_SelectionChanged"
                              Margin="0,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource WhatsAppSidebarItemStyle}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        
                        <ListViewItem Tag="chats" IsSelected="True">
                            <Grid Padding="12,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Chats" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Badge -->
                                <Border Background="{StaticResource WhatsAppGreenFocusBrush}" 
                                        CornerRadius="9" MinWidth="18" Height="18" 
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="3" FontSize="11" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="Bold" Margin="4,0"/>
                                </Border>
                            </Grid>
                        </ListViewItem>

                        <ListViewItem Tag="calls">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Calls" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="status">
                            <Grid Padding="12,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Status" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Dot Notifier -->
                                <Ellipse Fill="{StaticResource WhatsAppGreenFocusBrush}" 
                                         Width="6" Height="6" 
                                         HorizontalAlignment="Right" 
                                         VerticalAlignment="Center" 
                                         Margin="0,0,12,0"/>
                            </Grid>
                        </ListViewItem>

                        <Rectangle Height="1" Fill="{StaticResource WhatsAppMenuOutlineBrush}" Margin="12,8"/>

                        <ListViewItem Tag="starred">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Starred messages" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="archived">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Archived chats" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>

                    <!-- Bottom Section -->
                    <ListView x:Name="BottomNavListView" 
                              Grid.Row="3" 
                              SelectionMode="Single"
                              SelectionChanged="NavListView_SelectionChanged"
                              Margin="0,0,0,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource WhatsAppSidebarItemStyle}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="settings">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Settings" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="debug">
                            <StackPanel Orientation="Horizontal" Padding="12,0">
                                <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Width="24" 
                                           Foreground="{StaticResource WhatsAppGreenFocusBrush}"/>
                                <TextBlock Text="Debugging" Margin="16,0,0,0" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{StaticResource WhatsAppGreenFocusBrush}"/>
                            </StackPanel>
                        </ListViewItem>

                        <ListViewItem Tag="profile">
                            <Grid Padding="12,0">
                                <Ellipse Width="24" Height="24" 
                                         HorizontalAlignment="Left" 
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind Service.CurrentUserAvatar, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue='ms-appx:///Assets/Square44x44Logo.scale-200.png'}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{x:Bind Service.CurrentUserName, Mode=OneWay, FallbackValue='Profile'}" 
                                           Foreground="{ThemeResource WhatsAppTextHighBrush}"
                                           Margin="40,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </SplitView.Pane>
            
            <SplitView.Content>
                <Grid x:Name="RootContentGrid" Background="{StaticResource WhatsAppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Column0" Width="320" MaxWidth="400"/>
                        <ColumnDefinition x:Name="Column1" Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Chat List -->
                    <views:ChatListView x:Name="ChatListPart" MenuClicked="ChatListPart_MenuClicked" ChatSelected="ChatListPart_ChatSelected"/>
                    
                    <!-- Right: Chat Detail -->
                    <views:ChatDetailView x:Name="ChatDetailPart" Grid.Column="1"/>

                    <!-- Full Screen Debug View -->
                    <views:DebugView x:Name="DebugPart" Grid.ColumnSpan="2" Visibility="Collapsed" BackRequested="DebugPart_BackRequested"/>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
